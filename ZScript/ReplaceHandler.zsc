class MariaReplacementHandler : EventHandler
{
	override void CheckReplacement(ReplaceEvent e)
	{
		switch(e.replacee.getclassname())
		{
		case 'WolfensteinSS':				e.replacement = MariaWolfensteinSSReplacement ? 'WolfensteinSS' : 'OkayaSWATSpawner'; break;		

		//Decorations.Oh boy,this gonna be a long fucking list. 
		//case 'DeadMarine':				e.replacement = MariaVanillaDecorationsReplacement ? 'DeadMarine' : 'VeryDeadMarine'; break;
		case 'TechLamp':				e.replacement = MariaVanillaDecorationsReplacement ? 'TechLamp' : 'MariaTechLamp1'; break;
		case 'TechLamp2':				e.replacement = MariaVanillaDecorationsReplacement ? 'TechLamp2' : 'MariaTechLamp2'; break;
		case 'Column':				e.replacement = MariaVanillaDecorationsReplacement ? 'Column' : 'MariaColumn'; break;
		case 'RedTorch':				e.replacement = MariaVanillaDecorationsReplacement ? 'RedTorch' : 'MariaTallTorchRed'; break;
		case 'BlueTorch':				e.replacement = MariaVanillaDecorationsReplacement ? 'BlueTorch' : 'MariaTallTorchBlue'; break;
		case 'GreenTorch':				e.replacement = MariaVanillaDecorationsReplacement ? 'GreenTorch' : 'MariaTallTorchGreen'; break;		
		case 'ShortBlueTorch':				e.replacement = MariaVanillaDecorationsReplacement ? 'ShortBlueTorch' : 'MariaShortTorchBlue'; break;
		case 'ShortRedTorch':				e.replacement = MariaVanillaDecorationsReplacement ? 'ShortRedTorch' : 'MariaShortTorchRed'; break;
		case 'ShortGreenTorch':				e.replacement = MariaVanillaDecorationsReplacement ? 'ShortGreenTorch' : 'MariaShortTorchGreen'; break;
		case 'Candelabra':				e.replacement = MariaVanillaDecorationsReplacement ? 'Candelabra' : 'MariaCandelabra'; break;
		case 'Candlestick':				e.replacement = MariaVanillaDecorationsReplacement ? 'Candlestick' : 'MariaCandlestick'; break;
		case 'BurningBarrel':				e.replacement = MariaVanillaDecorationsReplacement ? 'BurningBarrel' : 'MariaBurningBarrel'; break;
		
		} 
	}
}