//==============================================================================
// Fists
//==============================================================================
// Caliber: 404
//==============================================================================
// No weapons? No problem for me, I can punch them when I'm desperate.
// I'm not strong enough, but I do my best.
//==============================================================================
ACTOR MariaFist : MariaWeapon //replaces Fist
{
	Obituary "%o tasted %k's fist!"
	Tag "Fists"
	Inventory.Icon "CROPA0"
	+CHEATNOTWEAPON
	+INVENTORY.UNDROPPABLE
	+INVENTORY.UNTOSSABLE
	+WEAPON.WIMPY_WEAPON
	+WEAPON.MELEEWEAPON
	+NOAUTOFIRE
	States
	{
	Deselect:
		HAND AB 1
		TNT1 AA 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1
		Wait

	Select:
		TNT1 AA 0 A_Raise
		Loop

	Ready:
		TNT1 A 0 A_PlaySound("Foley/Sleeves/Movement", CHAN_AUTO)
		TNT1 AA 1
		HAND BA 1
		Goto ReadyLoop

	ReadyLoop:
		HAND A 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
		Loop

	Fire:
		HAND A 1
		HAND B 1
		TNT1 A 1
	Left:
		TNT1 A 0 { If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); } }
		HANL A 1 A_PlaySound("weapons/melee/fist/swing")
		HANL B 1
		HANL C 1 A_FireCustomMissile("MariaPunch1",0,0,0,6) //A_CustomPunch(random(4,8), 0, 0, "MariaFistPuff")
		HANL D 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		HANL EFG 1  
		HANL H 1
		TNT1 A 2
		TNT1 A 0 A_Refire("Right")
		Goto FireEnd

	Right:
		TNT1 A 0 { If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); } }
		HANR A 1 A_PlaySound("weapons/melee/fist/swing")
		HANR B 1
		HANR C 1 A_FireCustomMissile("MariaPunch1",0,0,0,6) //A_CustomPunch(random(4,8), 0, 0, "MariaFistPuff")
		HANR D 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		HANR EFG 1  
		HANR H 1
		TNT1 A 2
		TNT1 A 0 A_Refire("Left")
		Goto FireEnd

	AltFire:
		HAND A 1
		HAND B 1
		TNT1 A 1
	AltLeft:
		TNT1 A 0 
		{
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlaySound("weapons/melee/fist/uppercut");
		A_ChangeVelocitY(2.5,0,2,CVF_RELATIVE);
		A_gunflash("PunchFlash"); //PunchFlash
		}
		TNT1 A 2
		HANU AB 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		HANU C 0 A_FireCustomMissile("MariaPunch2",0,0)
		HANU CCDEFGHIJK 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 5 //19
		TNT1 A 0 A_Refire("AltRight")
		Goto FireEnd
	AltRight:
		TNT1 A 0 
		{
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlaySound("weapons/melee/fist/uppercut");
		A_ChangeVelocitY(2.5,0,2,CVF_RELATIVE);
		A_gunflash("PunchFlash"); //PunchFlash
		}
		TNT1 A 2
		RANU AB 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		RANU C 0 A_FireCustomMissile("MariaPunch2",0,0)
		RANU CCDEFGHIJK 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 5 //19
		TNT1 A 0 A_Refire("AltLeft")
		Goto FireEnd

	FireEnd:
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		HAND BA 1
		HAND A 0 //A_Refire
		Goto ReadyLoop


	ThrowPipebomb:
		HAND AB 1
		TASG AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TASG CDDE 1
		TNT1 A 0 A_PlayWeaponSound("Maria/Pipebomb/Activate",1)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Beep/Two", CHAN_AUTO)
		TASG F 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1,TIF_NOTAKEINFINITE)
		TASG GHIJKL 1
		TNT1 A 2 
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TAHA AB 1
		TNT1 A 0 
		{
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlayWeaponSound("Maria/Pipebomb/Yeet",1);
		A_FireCustomMissile("HolyPipebomb",0,0,-4,1,1,7.328125);
		}
		TAHA CDE 1
		TNT1 A 5
		HAND BA 1
		Goto ReadyLoop
  
	UseStimShot:
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealth
		HAND AB 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		HAND BA 1
		Goto ReadyLoop

	User3:
	EquipShield:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("MariaShield",1)
		TNT1 A 0 A_SelectWEapon("MariaShield")
		Goto Deselect

	Zoom:
        TNT1 A 0 A_gunflash("PunchFlash")
		TNT1 A 4
		TNT1 A 0 A_PlaySound("Weapon/Valmer/Quickmelee", CHAN_WEAPON)
		VALQ ABC 1
		VALQ D 1
		{
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
        A_FireCustomMissile("MariaKnifeHit1",0,0,0,6);
		A_ChangeVelocitY(2.5,0,2,CVF_RELATIVE);
		}
		VALQ EFG 1  
		TNT1 A 5 //19
		Goto PunchFinish

	PunchFlash:
		HAND AB 1
		TNT1 A 12
		HAND BA 1
		Goto LightDone
	}
}