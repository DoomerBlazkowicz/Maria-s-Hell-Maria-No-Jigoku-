//==============================================================================
// "Oscillator"
//==============================================================================
// Caliber: Arrows
//==============================================================================
// Like the double barreled shotgun, another non-Earth weapon that fires armour
// piercing Arrows like it's a machine gun. 
// 
// Nail 'em up!
//==============================================================================
Actor MariaOscillator : MariaWeapon
{
	Weapon.AmmoGive 20
	Weapon.AmmoType "MariaArrowAmmo"
	Inventory.PickupSound "Weapon/Nailgun/Pickup"
	Inventory.PickupMessage "Oscillator Obtained!"
	Tag "Oscillator"
	Obituary "%o was nailed by %k."
	+WEAPON.CHEATNOTWEAPON
	+WEAPON.NOAUTOFIRE
	States
	{
	Spawn:
		NLMP A -1
		Loop

	Select:
		TNT1 AA 0 A_Raise
		Loop

	Deselect:
		NLMD ABCDE 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1
		Wait

	Ready:
		TNT1 A 0 A_PlaySound("Maria/Draw/Primary")
		NLMS ABCDE 1
		Goto ReadyLoop

	ReadyLoop:
		NLMG A 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWUSER1|WRF_ALLOWUSER2)
		Loop

	Fire:
		"####" "#" 0 
		{
		If(CountInv("MariaArrowAmmo") < 1) { return state("DryFire"); }
		A_PlaySound("Weapon/Shinigami/Dry",0);
		return state("");
		}
		NLMG A 1 Offset(0,33)
		NLMG A 1 Offset(0,34)
		NLMG AA 1
	Left:
		"####" "#" 0 
		{
		If(CountInv("MariaArrowAmmo") < 1) { return state("DryFire"); }
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlayWeaponSound("Weapon/Nailgun/Fire");
		A_AlertMonsters;
		A_TakeInventory("MariaArrowAmmo", 1);
		return state("");
		}
		NLMF A 1 A_FireCustomMissile("MariaArrowMissile2",0,1,-3)
		NLMG B 0 Bright A_Light2
		NLMF B 1 A_SetPitch(pitch-1.0)
		NLMG DA 1
		NLMG A 1 A_Refire("Right")
		Goto ReadyLoop

	Right:
		"####" "#" 0 
		{
		If(CountInv("MariaArrowAmmo") < 1) { return state("DryFire"); }
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlayWeaponSound("Weapon/Nailgun/Fire");
		A_AlertMonsters;
		A_TakeInventory("MariaArrowAmmo", 1);
		return state("");
		}
		NLMF C 1 A_FireCustomMissile("MariaArrowMissile2",0,1,3)
		NLMG E 0 Bright A_Light2
		NLMF D 1 A_SetPitch(pitch-1.0)
		NLMG CA 1
		NLMG A 1 A_Refire("Left")
		Goto ReadyLoop

	AltFire:
		"####" "#" 0 
		{
		If(CountInv("MariaArrowAmmo") < 2) { return state("DryFire"); }
		A_PlaySound("Weapon/Shinigami/Dry",0);
		return state("");
		}
		NLMG A 1 Offset(0,33)
		NLMG A 1 Offset(0,34)
		NLMG AAA 1
	AltLeft:
		"####" "#" 0 
		{
		If(CountInv("MariaArrowAmmo") < 2) { return state("DryFire"); }
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlayWeaponSound("Weapon/Nailgun/Fire") ;
		A_AlertMonsters;
		A_TakeInventory("MariaArrowAmmo", 2);
		return state("");
		}
		NLMF A 1 A_FireCustomMissile("MariaFlameArrowMissile",0,1,-3)
		NLMG B 0 Bright A_Light2
		NLMF B 1 A_SetPitch(pitch-1.0)
		NLMG DA 1
		NLMG A 1 A_Refire("AltRight")
		Goto ReadyLoop

	AltRight:
		NULL A 0 
		{
		If(CountInv("MariaArrowAmmo") < 2) { return state("DryFire"); }
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlayWeaponSound("Weapon/Nailgun/Fire");
		A_AlertMonsters;
		A_TakeInventory("MariaArrowAmmo", 2);
		return state("");
		}
		NLMF C 1 A_FireCustomMissile("MariaFlameArrowMissile",0,1,3)
		NLMG E 0 Bright A_Light2
		NLMF D 1 A_SetPitch(pitch-1.0)
		NLMG CA 1
		NLMG A 1 A_Refire("AltLeft")
		Goto ReadyLoop

	DryFire:
		TNT1 A 0 A_PlaySound("WeaponDryfire",0)
		TNT1 A 0 offset(0,36)
		NLMG A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 0 offset(0,35)
		NLMG A 10 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		Goto ReadyLoop

	ThrowPipebomb:
		NLMD ABCDE 1
		TASG AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TASG CDDE 1
		TNT1 A 0 A_PlayWeaponSound("Maria/Pipebomb/Activate",1)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Beep/Two", CHAN_AUTO)
		TASG F 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1,TIF_NOTAKEINFINITE)
		TASG GHIJKL 1
		TNT1 A 2 
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TAHA AB 1
		TNT1 A 0 
		{
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlayWeaponSound("Maria/Pipebomb/Yeet",1);
		A_FireCustomMissile("HolyPipebomb",0,0,-4,1,1,7.328125);
		}
		TAHA CDE 1
		TNT1 A 5
		NLMS ABCDE 1
		Goto ReadyLoop

	UseStimShot:
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealth
		NLMD ABCDE 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		NLMS ABCDE 1
		Goto ReadyLoop

	User3:
	EquipShield:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("MariaShield",1)
		TNT1 A 0 A_SelectWEapon("MariaShield")
		Goto Deselect

	PunchFlash:
		NLMK ABC 1
		NLMK D 12
		NLMK CBA 1
		NLMG A 1
		Goto LightDone
	}
}