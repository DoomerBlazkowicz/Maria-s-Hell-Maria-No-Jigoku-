#library "GameplayTips"
#include "zcommon.acs"

Script "GameplayTips" OPEN
{
    Delay(5);
	AmbientSound("Maria/Intro/GameTip",2.0);
	SetFont("DBIGFONT");
	switch(random(1,30))
	
	{
	Case 1:
	Hudmessage(s:"TIP: 100% Kills certain times rewards you with secret weapons."; HUDMSG_Typeon,1,Cr_White,0.5,0.55,2.0,0.05);
	Break;
	
	Case 2:
	Hudmessage(s:"TIP: Kill everyone and earn your rewards."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 3:
	Hudmessage(s:"TIP: Room dark? No problem, activate your flaslight."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 4:
	Hudmessage(s:"TIP: Shizuka Okaya sent her men to exterminate you."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 5:
	Hudmessage(s:"TIP: Some heavy weapons reduces your movement speed."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 6:
	Hudmessage(s:"TIP: Pipebombs are pretty strong, watch your foot and don't blow yourself up."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 7:
	Hudmessage(s:"TIP: Mind the loaded ammo in your weapons, you don't wanna get jumped with a empty gun, don't you?"; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 8:
	Hudmessage(s:"TIP: Crossbow is sniper type weapon, it's weak but silent and causes bleeding to enemies."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 9:
	Hudmessage(s:"TIP: Play Bunny Maze by Malintala Studios."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 10:
	Hudmessage(s:"TIP: NOB can gib enemies."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;

	Case 11:
	Hudmessage(s:"TIP: Rocket Launcher(s) comes with a night vision scope."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 12:
	Hudmessage(s:"TIP: Aerosol Can is good for conserving Fuel while Flamethrover is good for damage."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 13:
	Hudmessage(s:"TIP: Igniting and throwing Aerosol Can causes to lose your weapon unless you pick another one."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 14:
	Hudmessage(s:"TIP: Plasma Rifle can heat it's projectiles for more damage, hold longer to overheat it. But at cost of cooldown."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 15:
	Hudmessage(s:"TIP: Unmakyr's Arbalest attack can pierce through enemies and causes explosion once impacts to a surface."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 16:
	Hudmessage(s:"TIP: BFG is EXTREMELY powerful, either direct hit them of leave the tendrils to do it's job."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 17:
	Hudmessage(s:"TIP: Backpack's are rarer now."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 18:
	Hudmessage(s:"TIP: Sometimes Stimpacks and Medkits are replaced with Stim Shots, for emergency cases."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 19:
	Hudmessage(s:"TIP: Shoot them until they die."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 20:
	Hudmessage(s:"TIP: Silencer's aren't good enough to make gunshots silent."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 21:
	Hudmessage(s:"TIP: The Katana replaces Crowbar/Knife/Fists."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 22:
	Hudmessage(s:"TIP: Rune of Onslaught (Quad Damage) is like a double edged sword, mind the splash damage."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 23:
	Hudmessage(s:"TIP: Rune of Berserk grants ultimate power."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;
	
	Case 24:
	Hudmessage(s:"TIP: Rune of Overkill temporarily gives you the Death Machine."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;

	Case 25:
	Hudmessage(s:"TIP: You can change your outfit and kicks at Maria's Infirmary."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;

	Case 26:
	Hudmessage(s:"TIP: You can disable some sounds at Maria's Infirmary."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;

	Case 27:
	Hudmessage(s:"TIP: Learn to control you recoil."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;

	Case 28:
	Hudmessage(s:"TIP: Fetch their souls!"; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;

	Case 29:
	Hudmessage(s:"TIP: Be careful with explosive weapons if you don't wanna unintended suicide."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;

	Case 30:
	Hudmessage(s:"TIP: Maria has big boobs."; HUDMSG_Typeon,1,Cr_white,0.5,0.55,2.0,0.05);
	Break;

	}
}