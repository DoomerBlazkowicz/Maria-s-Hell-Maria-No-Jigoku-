#library "REWARDMESSAGES"
#include "zcommon.acs"

//Messages for rewarded weapons.

Script 700 (void) //Usas 12
{	
    {
		SetFont("DBIGFONT");
		HudMessage(s:"Secret weapon obtained: Usas 12!"; HUDMSG_TYPEON, 0, CR_Yellow, 0.5, 0.8, 1.0, 0.02);
		delay(20);
		terminate;
    }
}

