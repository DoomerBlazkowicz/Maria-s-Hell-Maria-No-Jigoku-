ACTOR MariaOverkill : CustomInventory //replaces Berserk
{
  +COUNTITEM
  +FLOATBOB
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.FANCYPICKUPSOUND
  FloatBobPhase 1
  FloatBobStrength 0.5
  Scale 0.7
  Inventory.PickupSound "Maria/Powerup/Minigun"
  Inventory.PickupMessage "$GOTOVERKILL"
  States
  {
  Spawn:
    OVKI ABCDCB 5 Bright
    Loop
  Pickup:
    TNT1 A 0 A_PrintBold ("\c[White]Mother. Unleash the Fist of Iron.")
    TNT1 A 0 A_GiveInventory("OverkillDuration")
	TNT1 A 0 A_GiveInventory("MariaDeathMachine")
	TNT1 A 0 A_SelectWeapon("MariaDeathMachine")
    Stop
  }
}

ACTOR OverkillDuration : PowerProtection
{
	Powerup.Color "Blue", 0.1
	Powerup.Duration -20
	+INVENTORY.ADDITIVETIME
}

ACTOR MariaCatPlushie : Megasphere //MariaMegaStone
{
	+COUNTITEM
    //+FLOATBOB
	+INVENTORY.ALWAYSPICKUP
	Inventory.PickupMessage "$GOTCATPLUSH"
	Inventory.PickupSound "Maria/Powerup/Mega"
	//Inventory.PickupAnnouncerEntry "megasphere"
	States
	{
	Spawn:
		PL11 A 3
		Loop
	Pickup:
        TNT1 A 0 A_PrintBold ("\c[Purple]Praise me!")
		TNT1 A 0 A_GiveInventory("ChibiLife", 1)
		TNT1 A 0 A_GiveInventory("ChibiArmor", 1)
		Stop
	}
}	

Actor ChibiArmor : BasicArmorPickup
{
  +Inventory.AutoActivate
  +Inventory.AlwaysPickup
  Inventory.Icon "MA_ARM4"
  Armor.Savepercent 100.0
  Armor.Saveamount 300
  States
  {
  Spawn:
    TNT1 A 0 Bright
    Loop
  }
}

