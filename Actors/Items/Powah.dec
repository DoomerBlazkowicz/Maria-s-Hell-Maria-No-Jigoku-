ACTOR MariaBerserk : CustomInventory //replaces Berserk
{
  +COUNTITEM
  +FLOATBOB
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.FANCYPICKUPSOUND
  FloatBobPhase 1
  FloatBobStrength 0.5
  Scale 0.7
  Inventory.PickupSound "Maria/Powerup/Berserk"
  Inventory.PickupMessage "$GOTBERSERK"
  States
  {
  Spawn:
    BERS ABCDCB 5
    Loop
  Pickup:
	TNT1 A 0 A_SetBlend("FF0000",0.95,60)
	TNT1 A 0 radius_quake(4, 5, 0, 1, 0)
    TNT1 A 0 A_GiveInventory("BerserkStrength")
    TNT1 A 0 A_PrintBold ("\c[White]Mother. Rip and Tear, until it is done.")
	TNT1 A 0 A_GiveInventory("BerserkSpeed")
	TNT1 A 0 HealThing(100, 0) 
	TNT1 A 0 A_GiveInventory("MariaBerserkerFists")
	TNT1 A 0 A_SelectWeapon("MariaBerserkerFists")
    Stop
  }
}

ACTOR BerserkStrength : PowerProtection
{
	Powerup.Colormap 1.25, 0.0, 0.0
	Powerup.Duration -30
	Damagefactor "normal", 0.1
	+INVENTORY.ADDITIVETIME
}

ACTOR BerserkSpeed : PowerSpeed
{
	Powerup.Duration -30
}

ACTOR PowerQuadDamage : PowerDamage
{
	Damagefactor "normal", 4
	//ActiveSound "Maria/Powerup/Quad/Shoot"	//This gets way too loud when you frag multiple enemies with the rocket launcher. Trust me.
	//DeathSound "Maria/Powerup/Quad/Shoot"
}

ACTOR MariaOnslaught : PowerupGiver 12370
{
	+COUNTITEM
    +FLOATBOB
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	Inventory.MaxAmount 0
	Inventory.PickupMessage "$GOTQUAD"
	Inventory.PickupSound "Maria/Powerup/Quad"
	Powerup.Type QuadDamage
	Powerup.Color 255, 0, 255, 0.1
	Powerup.Duration -30
	Alpha 0.8
    FloatBobPhase 1
    FloatBobStrength 0.5
    Scale 0.7	
  States
  {
  Spawn:	
    QDMG ABCDCB 5 
    Loop
  Pickup:
    TNT1 A 0 A_PrintBold ("Mother. Multiply the damage, until it ends.")
    Stop
		}
}

Actor MariaInvisibilityCloak : PowerupGiver replaces BlurSphere
{
  +CountItem
  +FLOATBOB
  +VisibilityPulse
  +Inventory.AutoActivate
  +Inventory.AlwaysPickup
  Inventory.MaxAmount 0
  Powerup.Type Invisibility
  Powerup.Mode Translucent
  Powerup.Strength 80
  RenderStyle Translucent
  Inventory.PickupSound "Maria/Powerup/Cape"
  Inventory.PickupMessage "$GOTINVIS"
  States
  {
  Spawn:
    CAPE ABCD 6 Bright
    Loop
  }
}

