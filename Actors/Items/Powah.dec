ACTOR MariaAntiHazmat : RadSuit Replaces RadSuit
{
	Inventory.PickupMessage "$GOTSUIT"
	Inventory.PickupSound "Maria/Powerup/Hazmat"
    Scale 0.7
    +FLOATBOB
	States
	{
	Spawn:
		SUIT ABCDCB 5
		Loop
    Pickup:
        TNT1 A 0 A_GiveInventory("AntiHazmatFeet", 1)
        TNT1 A 0 A_GiveInventory("AntiHazmatProtector", 1)
        Stop
	}
}

Actor AntiHazmatFeet : PowerupGiver
{
  +Inventory.AutoActivate
  +Inventory.AlwaysPickup
  Inventory.MaxAmount 0
  Inventory.PickupMessage ""
  Powerup.Type "IronFeet"
  Powerup.Duration -120
  Powerup.Color "Green", 0.1
  States
  {
  Spawn:
    TNT1 A 1
    Fail
  }
}

