
ACTOR MariaMegaHealth : Health replaces Soulsphere
{
  Scale 0.9
  +COUNTITEM
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
  +INVENTORY.FANCYPICKUPSOUND
  Inventory.Amount 100
  Inventory.MaxAmount 200
  Inventory.PickupMessage "$GOTSUPER"
  Inventory.PickupSound "misc/p_pkup"
  States
  {
  Spawn:
    QMEG A -1
    Stop
  }
}

ACTOR MariaMegaStone : Megasphere replaces Megasphere
{
	+COUNTITEM
    +FLOATBOB
	+INVENTORY.ALWAYSPICKUP
	Inventory.PickupMessage "$GOTMSPHERE"
	Inventory.PickupSound "Maria/Powerup/Mega"
	//Inventory.PickupAnnouncerEntry "megasphere"
	States
	{
	Spawn:
		MGST ABCDEF 3
		Loop
	Pickup:
		TNT1 A 0 A_GiveInventory("BlueArmorForMegasphere", 1)
		TNT1 A 0 A_GiveInventory("MegasphereHealth", 1)
		Stop
	}
}	

ACTOR MariaRosary : InvulnerabilitySphere replaces InvulnerabilitySphere
{
	+COUNTITEM
    +FLOATBOB
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	+INVENTORY.BIGPOWERUP
	Inventory.MaxAmount 0
	Powerup.Type Invulnerable
	Powerup.Color Yellow, 0.125
	Inventory.PickupSound "Maria/Powerup/Invul"
	Inventory.PickupMessage "$GOTROSARIA"
	States
	{
	Spawn:
		ROSA ABCDCB 5 //Bright
		Loop
	}
}

ACTOR MariaDiary : MapRevealer replaces Allmap
{
	+COUNTITEM
	+INVENTORY.FANCYPICKUPSOUND
	+INVENTORY.ALWAYSPICKUP
	Inventory.MaxAmount 0
	Inventory.PickupSound "Maria/Powerup/Diary"
	Inventory.PickupMessage "$GOTMAP"
