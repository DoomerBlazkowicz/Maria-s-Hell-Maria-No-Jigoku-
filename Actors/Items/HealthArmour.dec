
ACTOR MariaStimpack : Health //Replaces Stimpack
{
	Tag "Bandage"
	Inventory.Amount 10
    Inventory.PickupSound "Maria/Health/Stimpack"
    Inventory.PickupMessage "$GOTSTIM"
	Health.LowMessage 25, "$GOTSTIMNEED"
	States
	{
	Spawn:
		STIM A -1
		Stop
	}
}

ACTOR MariaMedikit : Health //Replaces Medikit
{
	Tag "First Aid Kit"
    Inventory.PickupSound "Maria/Health/Medkit"
	Inventory.Amount 25
	Inventory.PickupMessage "$GOTMEDIKIT"
	Health.LowMessage 25, "$GOTMEDINEED"	
    Scale 0.60
  	States
	{
	Spawn:
		MEDI A -1
		Stop
	}
}

ACTOR MariaSyringeAmmo : Ammo
{
   Inventory.Amount 1
   Inventory.MaxAmount 10
   Ammo.BackpackAmount 1
   Ammo.BackpackMaxAmount 20
   Inventory.Icon "SRIPB0"
   Inventory.PickupMessage "Picked up a Stim Shot."
   Inventory.PickupSound "Maria/Health/Syringe"
	States
	{
	Spawn:
		SRIP A -1
		Stop
	}
}

ACTOR MariaSyringeCase : MariaSyringeAmmo
{
   Inventory.Amount 3
   Inventory.PickupMessage "Picked up a case of Stim Shots."
   Inventory.PickupSound "Maria/Health/Case"
   Scale 1.00
   States
   {
   Spawn:
      SRBP A -1
      Stop
   }
}

ACTOR SyringeProtection : PowerProtection
{
	Powerup.Duration -5
    Damagefactor "Normal", 0.50
    +INVENTORY.NOSCREENBLINK
	+INVENTORY.ADDITIVETIME
}

ACTOR SyringeRegeneration : PowerRegeneration
{
	Powerup.Color 0, 0, 255, 0.3
	Powerup.Duration -30
    Powerup.Strength 1
    +INVENTORY.NOSCREENBLINK
	+INVENTORY.ADDITIVETIME
}

Actor MariaBallisticArmor : BasicArmorPickup Replaces GreenArmor
{
	Tag "Ballistic Vest"
	Radius 20
	Height 16
    Inventory.PickupSound "Maria/Armour/Vest"
	Inventory.Pickupmessage "$GOTARMOR"
	Inventory.Icon "MA_ARM1"
	Armor.SavePercent 30
	Armor.SaveAmount 100
	States
	{
	Spawn:
		SHL1 A 6 //bright
		SHL1 B 6 //bright
		loop
	}
}

Actor MariaHeavyArmor : BasicArmorPickup //Replaces BlueArmor
{
	Tag "Security Armor"
	Radius 20
	Height 16
    Inventory.PickupSound "Maria/Armour/Heavy"
	Inventory.Pickupmessage "$GOTMEGA"
	Inventory.Icon "MA_ARM2"
	Armor.Savepercent 60
	Armor.Saveamount 150
	States
	{
	Spawn:
		SHL2 A 6 //bright
		SHL2 B 6 //bright
		loop
	}
}

Actor MariaSuperShield : BasicArmorPickup
{
  Tag "Combat Armor"
  Radius 20
  Height 16
  Armor.SavePercent 80
  Armor.SaveAmount 200
  Inventory.PickupSound "Maria/Armour/Holy"
  Inventory.Icon "MA_ARM3"
  Inventory.PickupMessage "$GOTSUPERAR"
  states
  {
  Spawn:
    SHLX A 6 Bright
    SHLX B 6 Bright
    Loop
  }
}