
actor MariaHealthBonus : HealthBonus //replaces HealthBonus
{
	+COUNTITEM
	+INVENTORY.ALWAYSPICKUP
	Inventory.Pickupmessage "$GOTHTHBONUS"
    Inventory.PickupSound "Maria/Bonus/Health"
	Inventory.Amount 2
	Inventory.MaxAmount 200
	//Scale 0.75
	States
	{
    Spawn:
        TNT1 A 0
        TNT1 A 0 A_JumpIf(CallACS("BonusItemSkinToggler")==2, "SpawnClassic")
        TNT1 A 0 A_JumpIf(CallACS("BonusItemSkinToggler")==1, "SpawnAlternative")
        TNT1 A 0 A_JumpIf(CallACS("BonusItemSkinToggler")==0, "SpawnDefault")
    SpawnDefault:
        BON1 ABCDCB 6
        goto spawn
    SpawnAlternative:
        AON1 ABCDCB 6
        goto spawn
    SpawnClassic:
        CON1 ABCDCB 6
        goto spawn
	}
}

actor MariaArmorShard : ArmorBonus //replaces ArmorBonus
{
	+COUNTITEM
	+INVENTORY.ALWAYSPICKUP
	Inventory.Pickupmessage "$GOTARMBONUS"
	Inventory.Icon "TNT1A0"
    Inventory.PickupSound "Maria/Bonus/Armour"
	Armor.Savepercent 33.335
	Armor.Saveamount 2
	Armor.Maxsaveamount 200
	States
	{
    Spawn:
        TNT1 A 0
        TNT1 A 0 A_JumpIf(CallACS("BonusItemSkinToggler")==2, "SpawnClassic")
        TNT1 A 0 A_JumpIf(CallACS("BonusItemSkinToggler")==1, "SpawnAlternative")
        TNT1 A 0 A_JumpIf(CallACS("BonusItemSkinToggler")==0, "SpawnDefault")
    SpawnDefault:
        BON2 ABCDCB 6
        goto spawn
    SpawnAlternative:
        AON2 ABCDCB 6
        goto spawn
    SpawnClassic:
        CON2 ABCDCB 6
        goto spawn
	}
}

actor MariaHealthBonusHarder : MariaHealthBonus
{
	Inventory.Pickupmessage "$GOTHTHBONUSSURVIVAL"
	Inventory.Amount 1
}

actor MariaArmorShardHarder : MariaArmorShard
{
	Inventory.Pickupmessage "$GOTARMBONUSSURVIVAL"
	Armor.Saveamount 1
}