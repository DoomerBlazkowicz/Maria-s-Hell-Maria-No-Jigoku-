ACTOR PipebombAmmo : Ammo //Use it for Hexen
{
	Inventory.Amount 1
	Inventory.MaxAmount 5
	Ammo.BackpackAmount 1
	Ammo.BackpackMaxAmount 10
	Tag "Pipebomb"
	Inventory.Icon "PIPPA0"
	Inventory.PickupMessage "Picked up a Pipebomb."
	Inventory.PickupSound "Pipebomb/Up"
	Scale 0.75
	States
	{
	Spawn:
		PIPP A -1
		Stop
	}
}

Actor MariaAmmoBox : CustomInventory
{
  +CountItem
  +Inventory.AlwaysPickup
  Tag "Ammopack"
  //Scale .75
  Inventory.PickupMessage "$GOTAMMOPACK"
  Inventory.PickupSound "MACRATUP"
  States
  {
  Spawn:
    ABOX A -1
    Loop
  Pickup:
    TNT1 A 0 A_GiveInventory("MariaLightClip", 60)
    TNT1 A 0 A_GiveInventory("MariaHeavyClip", 30)
    TNT1 A 0 A_GiveInventory("Shell", 8)
    TNT1 A 0 A_GiveInventory("MariaGrenadeAmmo", 3)
    TNT1 A 0 A_GiveInventory("Cell", 50)
    TNT1 A 0 A_GiveInventory("MariaArrowAmmo", 10)
    TNT1 A 0 A_GiveInventory("MariaGasoline", 25)
    TNT1 A 0 A_GiveInventory("PipebombAmmo", 1)
    Stop
  }
}

ACTOR MariaBackpack : BackpackItem //Replaces Backpack
{
   	Tag "Backpack"
	Height 26
    Inventory.PickupSound "MABPAKUP"
	Inventory.PickupMessage "$GOTBACKPACK"
	States
	{
	Spawn:
		BPAK A -1
		Stop
	}
}
