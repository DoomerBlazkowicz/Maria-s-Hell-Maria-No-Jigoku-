ACTOR MariaHeavyClip : Ammo //replaces Clip
{
	Inventory.PickupMessage "$GOTCLIP2"
	Inventory.Amount 30
	Inventory.MaxAmount 200
	Ammo.BackpackAmount 60
	Ammo.BackpackMaxAmount 400
	Inventory.Icon "CLIPA0"
	Tag "Heavy Bullet Mag"
    Inventory.PickupSound "Maria/Ammo/HeavyBullets/Single"
	States
	{
	Spawn:
		CLIP A -1
		Stop
	}
}

ACTOR MariaHeavyClipBox : MariaHeavyClip //replaces ClipBox
