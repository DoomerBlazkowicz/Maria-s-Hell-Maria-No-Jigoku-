
//===========================================================================
//
// Pyromaniac
//
//===========================================================================
ACTOR MariaPyro
{
    Health 150
    Radius 20
    Height 56
    Speed 10
    Fastspeed 15
    PainChance 100
    MONSTER 
    +FLOORCLIP
	+NOINFIGHTING
    +DONTHARMCLASS
    +Notarget
    +DONTHURTSPECIES
	+CANUSEWALLS
	+JUMPDOWN
    SeeSound "Shizuka/SWATElite/Sight"
    ActiveSound "shocktrooper/active"
    PainSound "Shizuka/SWATElite/Pain"
    DeathSound "Shizuka/SWAT/Death"
    Obituary "You got burned to death by a Pyro with a Flamethrower."
    //MeleeRange 384
	DropItem  "MariaIncinerator"
    States
    {
    Spawn:
        CDX0 A 10 A_Look
        Loop
    See:
        TNT1 A 0 A_StopSound(3)
        TNT1 A 0 A_PlaySound("Shizuka/SWAT/Footsteps")
        CDX0 ABCD 3 Fast A_Chase
        TNT1 A 0 A_PlaySound("Shizuka/SWAT/Footsteps")
		CDX0 ABCD 3 Fast A_Chase
        TNT1 A 0 A_PlaySound("Shizuka/SWAT/Footsteps")
		CDX0 ABCD 3 Fast A_Chase
        Loop
	Missile:
      	CDX0 E 1
        TNT1 A 0 A_Playsound("Weapon/Incinerator/Fire/Loop",3,0.5,TRUE)
        TNT1 A 0 A_FaceTarget
      	CDX0 F 1 A_CustomMissile("MariaKitsuneFlame",32,0,random(-4,4),0)
        TNT1 A 0 A_FaceTarget
      	CDX0 F 1 A_CustomMissile("MariaKitsuneFlame",32,0,random(-4,4),0)
        TNT1 A 0 A_FaceTarget
      	CDX0 F 1 A_CustomMissile("MariaKitsuneFlame",32,0,random(-4,4),0)
        TNT1 A 0 A_FaceTarget
      	CDX0 F 1 A_CustomMissile("MariaKitsuneFlame",32,0,random(-4,4),0) 
        TNT1 A 0 A_CPosRefire
        Goto Missile+1
    Pain:
        TNT1 A 0 A_StopSound(3)
        TNT1 A 0 A_Playsound("Shizuka/SWATElite/Pain", 2)
        CDX0 G 3
        CDX0 G 3 A_Pain
        Goto See
    Death:
        TNT1 A 0 A_StopSound(3)
        TNT1 A 0 A_Playsound("Shizuka/SWATElite/Death", 2)
		CDX0 H 5
		CDX0 I 5 A_Scream
		CDX0 J 5 A_NoBlocking
		CDX0 K 5 A_Fall
		CDX0 L -1
        Stop
    XDeath:
        TNT1 A 0 A_StopSound(3)
        TNT1 A 0 A_Explode
        TNT1 A 0 A_Quake(4, 24, 0, 960)
		TNT1 A 0 A_PlaySound("Maria/Barrel/Explosion",CHAN_AUTO)
        TNT1 A 0 A_PlaySound("Maria/Explosion/Far", CHAN_AUTO)
		TNT1 A 0 bright A_Explode(150,200,1,1)
        TNT1 A 0 A_PlaySound("Maria/Explosion/Far", CHAN_ITEM)
		TNT1 A 0 A_SpawnItemEx("MariaShockWave")
		TNT1 AAAAAAAA 0 A_CustomMissile("MariaHeavyExplosionSmoke",0,0,random(0,360),2,random(0,360))
        TNT1 AAAAA 0 A_SpawnProjectile("MariaExplosionFlames", 0, 0, random(0, 360), CMF_AIMDIRECTION, random(0, 360))
        TNT1 AAAA 0 A_SpawnItemEx ("MariaBarrelShrapnel", 0, 0, random(0,42), random(2,6), random(2,6), 0, random(0,360), 160)
        TNT1 A 0 A_SpawnProjectile("MariaBarrelExplosionFlame")
		TNT1 AAAAAAAA 0 A_CustomMissile("MariaHeavyExplosionSmoke",0,0,random(0,360),2,random(0,360))
        TNT1 AAAAAAAAA 0 A_CustomMissile ("MariaSmallExplosionFlames", 20, 0, random (0, 360), 2, random (0, 180))
        TNT1 A 0 A_Playsound("Shizuka/SWATElite/Death", 2)
		CDX0 M 5
		CDX0 N 5 A_XScream
		CDX0 O 5 A_NoBlocking
		CDX0 PQRST 5
		CDX0 U -1
        Stop
  Death.Fire:
        TNT1 A 0 A_StopSound(3)
    	BURN A 3 Bright 
	BURN B 3 Bright A_Playsound("Shizuka/SWATElite/Death")	
	BURN C 3 Bright A_NoBlocking
	BURN D 3 Bright
	BURN E 5 Bright 
	BURN FGH 5 Bright
	BURN I 5 Bright
	BURN JKL 5 Bright 
	BURN M 5 Bright
	BURN N 5 Bright 
	BURN OPQPQ 5 Bright
	BURN RSTU 7 Bright
	BURN V -1
	Stop
  Death.Plasma:
    TNT1 A 0 A_StopSound(3)
    PBR1 A 2 A_NoBlocking
    TNT1 A 0 
    PBR1 BBBBBB 2
    PBR1 CDEFGH 6 
    PBR1 HHHHHHHHHHHHHHHHHHHHHH 8 
    TNT1 A -1
    Stop
  Death.BFG:
    TNT1 A 0 A_StopSound(3)
	DISR A 5
	DISR BC 5
	DISR D 5 A_NoBlocking
	DISR EF 5
	DISR GHIJ 4
	TNT1 A -1
	Stop
    Raise:
        CDX0 KJIH 5
        Goto See
    }
}

Actor MariaKitsuneFlame : MariaIncineratorFlame
{
    //Speed 20
	Damage 1
    Scale 0.3
	States
	{
	Spawn:
     HONO A 2 Bright
     TNT1 A 0 A_Explode(1, 50, 0)
     HONO B 2 Bright
     TNT1 A 0 A_Explode(1, 50, 0)
     HONO C 2 Bright
     TNT1 A 0 A_Explode(1, 50, 0)
     HONO D 2 Bright
     TNT1 A 0 A_Explode(1, 50, 0)
     HONO E 2 Bright
     TNT1 A 0 A_Explode(1, 50, 0)
     HONO F 2 Bright
     TNT1 A 0 A_Explode(1, 50, 0)
     HONO G 2 Bright 
     TNT1 A 0 A_Explode(1, 50, 0)
     HONO H 2 Bright 
     TNT1 A 0 A_Explode(1, 50, 0)
     HONO I 2 Bright 
     TNT1 A 0 A_Explode(1, 50, 0)
     HONO J 2 Bright 
     TNT1 A 0 A_Explode(1, 50, 0)
     HONO K 2 Bright 
     TNT1 A 0 A_Explode(1, 50, 0)
     HONO L 2 Bright 
     TNT1 A 0 A_Explode(1, 50, 0)
     HONO M 2 Bright 
     TNT1 A 0 A_Explode(1, 50, 0)
     HONO N 2 Bright 
     TNT1 A 0 A_Explode(1, 50, 0)
     HONO O 2 Bright 
     TNT1 A 0 A_Explode(1, 50, 0)
     HONO P 2 Bright 
     TNT1 A 0 A_Explode(1, 50, 0)
	stop
   Death:
 	 TNT1 A 0 //A_Explode(35, 150, 0)
     TNT1 A 0 A_Explode(1, 25)
      stop
	}
}