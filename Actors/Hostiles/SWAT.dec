
//===========================================================================
//
// Okaya Police (Revolver)
//
//===========================================================================
ACTOR MariaSWATRevolver //Replaces WolfensteinSS
{
  Game Doom
  //$Category Monsters
  //$Title "SWAT (Revolver)"
  obituary "Shizuka Okaya succeeded."
  health 60
  radius 20
  height 56
  mass 100
  speed 15
  painchance 170
  Decal "BulletChip"
  seesound "Shizuka/SWAT/Sight"
  //activesound ""
  //attacksound ""
  painsound "Shizuka/SWAT/Pain"
  deathsound "Shizuka/SWAT/Death"
  dropitem "MariaRevolver"
  dropitem "MariaLightClipSpeedloader"
  MONSTER
  +NOINFIGHTING
  +NOTARGET
  +FLOORCLIP
  states
  {
  Spawn:
    CDL9 Z 10 A_Look
    loop
  See:
    TNT1 A 0 A_PlaySound("Shizuka/SWAT/Footsteps")
    CDL9 AABB 3 A_Chase
    TNT1 A 0 A_PlaySound("Shizuka/SWAT/Footsteps")
    CDL9 CCDD 3 A_Chase
    loop
  Missile:
    CDL9 E 10 A_FaceTarget
	goto WhichMissileType
  WhichMissileType:
	CDL9 E 0 A_Jump(150, "BurstFire")
	goto SemiFire
  SemiFire:
	TNT1 A 0 A_Playsound("Weapon/Revolver/Fire")	
    CDL9 F 2 bright A_custommissile("MariaHostileRevolverTracer",43,5,frandom(-4, 4),CMF_AIMDIRECTION,pitch+frandom(-3, 3))
	CDL9 E 15 //A_CPosRefire
	goto See
  Pain:
    CDL9 G 3
    CDL9 G 3 A_Pain
    goto See
  Death:
    CDL9 H 5
    CDL9 I 5 A_Scream
    CDL9 J 5 A_NoBlocking
    CDL9 K 5
    CDL9 L 5
    CDL9 L -1
    stop
  Death.Fire:
	BURN A 3 Bright 
	BURN B 3 Bright A_Playsound("Shizuka/SWAT/Burn")	
	BURN C 3 Bright A_NoBlocking
	BURN D 3 Bright
	BURN E 5 Bright 
	BURN FGH 5 Bright
	BURN I 5 Bright
	BURN JKL 5 Bright 
	BURN M 5 Bright
	BURN N 5 Bright 
	BURN OPQPQ 5 Bright
	BURN RSTU 7 Bright
	BURN V -1
	Stop
  Death.Plasma:
    PBR1 A 2 A_NoBlocking
    TNT1 A 0 
    PBR1 BBBBBB 2
    PBR1 CDEFGH 6 
    PBR1 HHHHHHHHHHHHHHHHHHHHHH 8 
    TNT1 A -1
    Stop
  Death.BFG:
	DISR A 5
	DISR BC 5
	DISR D 5 A_NoBlocking
	DISR EF 5
	DISR GHIJ 4
	TNT1 A -1
	Stop
  XDeath:
    CDL9 M 5
    CDL9 N 5 A_XScream
    CDL9 O 5 A_NoBlocking
    CDL9 PQRS 5
    CDL9 S -1
    stop
  Raise:
    CDL9 MLKJIH 5
    goto See
  }
}

//===========================================================================
//
// Okaya Police (Shotgun)
//
//===========================================================================

ACTOR MariaSWATShotgun //Replaces WolfensteinSS
{
  Game Doom
  //$Category Monsters
  //$Title "SWAT (Shotgun)"
  obituary "Shizuka Okaya succeeded."
  health 60
  radius 20
  height 56
  mass 100
  speed 10
  painchance 170
  Decal "BulletChip"
  seesound "Shizuka/SWAT/Sight"
  //activesound ""
  //attacksound ""
  painsound "Shizuka/SWAT/Pain"
  deathsound "Shizuka/SWAT/Death"
  dropitem "MariaShotgun"
  dropitem "MariaShell"
  MONSTER
  +NOINFIGHTING
  +NOTARGET
  +FLOORCLIP
  states
  {
  Spawn:
    CDL8 Z 10 A_Look
    loop
  See:
    TNT1 A 0 A_PlaySound("Shizuka/SWAT/Footsteps")
    CDL8 AABB 3 A_Chase
    TNT1 A 0 A_PlaySound("Shizuka/SWAT/Footsteps")
    CDL8 CCDD 3 A_Chase
    loop
  Missile:
    CDL8 E 10 A_FaceTarget
	goto WhichMissileType
  WhichMissileType:
    CDL8 E 0 A_JumpIfCloser(768, "SemiFire")
	goto SemiFire
  SemiFire:
	TNT1 A 0 A_Playsound("Weapon/Shotgun/Fire", 1)	
    CDL8 FFFFFF 0 A_custommissile("MariaHostileShotgunTracer",35,7,frandom(-2, 2),CMF_AIMDIRECTION,pitch+frandom(-3,3))
    CDL8 F 2 bright
	CDL8 E 5
	TNT1 A 0 A_Playsound("Weapon/Shotgun/Rack/Back", 2)	
	CDL8 E 5
	TNT1 A 0 A_Playsound("Weapon/Shotgun/Rack/Foward", 3)	
	CDL8 E 5
	CDL8 E 10
	goto See
  Pain:
    CDL8 G 3
    CDL8 G 3 A_Pain
    goto See
  Death:
    CDL8 H 5
    CDL8 I 5 A_Scream
    CDL8 J 5 A_NoBlocking
    CDL8 K 5
    CDL8 L -1
    stop
  Death.Fire:
	BURN A 3 Bright 
	BURN B 3 Bright A_Playsound("Shizuka/SWAT/Burn")	
	BURN C 3 Bright A_NoBlocking
	BURN D 3 Bright
	BURN E 5 Bright 
	BURN FGH 5 Bright
	BURN I 5 Bright
	BURN JKL 5 Bright 
	BURN M 5 Bright
	BURN N 5 Bright 
	BURN OPQPQ 5 Bright
	BURN RSTU 7 Bright
	BURN V -1
	Stop
  Death.Plasma:
    PBR1 A 2 A_NoBlocking
    TNT1 A 0 
    PBR1 BBBBBB 2
    PBR1 CDEFGH 6 
    PBR1 HHHHHHHHHHHHHHHHHHHHHH 8 
    TNT1 A -1
    Stop
  Death.BFG:
	DISR A 5
	DISR BC 5
	DISR D 5 A_NoBlocking
	DISR EF 5
	DISR GHIJ 4
	TNT1 A -1
	Stop
  XDeath:
    CDL8 M 5
    CDL8 N 5 A_XScream
    CDL8 O 5 A_NoBlocking
    CDL8 PQRST 5
    CDL8 U -1
    stop
  Raise:
    CDL8 LKJIH 5
    goto See
  }
}

//===========================================================================
//
// Okaya Police (SMG)
//
//===========================================================================

actor MariaSWATSMG //Replaces WolfensteinSS
{
  Game Doom
  //$Category Monsters
  //$Title "SWAT (SMG)"
  obituary "Shizuka Okaya succeeded."
  health 70
  radius 20
  height 56
  mass 100
  speed 10
  painchance 170
  Decal "BulletChip"
  seesound "Shizuka/SWAT/Sight"
  //activesound ""
  //attacksound ""
  painsound "Shizuka/SWAT/Pain"
  deathsound "Shizuka/SWAT/Death"
  dropitem "MariaMP5"
  dropitem "MariaLightClip"
  MONSTER
  +NOINFIGHTING
  +NOTARGET
  +FLOORCLIP
  states
  {
  Spawn:
    CDL0 Z 10 A_Look
    loop
  See:
    TNT1 A 0 A_PlaySound("Shizuka/SWAT/Footsteps")
    CDL0 AABB 3 A_Chase
    TNT1 A 0 A_PlaySound("Shizuka/SWAT/Footsteps")
    CDL0 CCDD 3 A_Chase
    loop
  Missile:
    CDL0 E 10 A_FaceTarget
	goto WhichMissileType
  WhichMissileType:
    CDL0 E 0 A_JumpIfCloser(768, "BurstFire2")
	CDL0 E 0 A_Jump(64, "BurstFire")
	goto BurstFire
  BurstFire:
	TNT1 A 0 A_Playsound("Weapon/MP5/Fire")	
	CDL0 F 2 bright A_custommissile("MariaHostileSMGTracer",32,0,random(-3,3))
	CDL0 E 1 A_FaceTarget
	TNT1 A 0 A_Playsound("Weapon/MP5/Fire")	
	CDL0 F 2 bright A_custommissile("MariaHostileSMGTracer",32,0,random(-6,6))
	CDL0 E 1 A_FaceTarget
	TNT1 A 0 A_Playsound("Weapon/MP5/Fire")	
	CDL0 F 2 bright A_custommissile("MariaHostileSMGTracer",32,0,random(-9,9))
	CDL0 E 10 A_CPosRefire
	goto WhichMissileType
  BurstFire2:
	TNT1 A 0 A_Playsound("Weapon/MP5/Fire")	
	CDL0 F 2 bright A_custommissile("MariaHostileSMGTracer",32,0,random(-3,3))
	CDL0 E 1 A_FaceTarget
	TNT1 A 0 A_Playsound("Weapon/MP5/Fire")	
	CDL0 F 2 bright A_custommissile("MariaHostileSMGTracer",32,0,random(-6,6))
	CDL0 E 1 A_FaceTarget
	TNT1 A 0 A_Playsound("Weapon/MP5/Fire")	
	CDL0 F 2 bright A_custommissile("MariaHostileSMGTracer",32,0,random(-9,9))
	CDL0 E 1 A_FaceTarget
	TNT1 A 0 A_Playsound("Weapon/MP5/Fire")	
	CDL0 F 2 bright A_custommissile("MariaHostileSMGTracer",32,0,random(-3,3))
	CDL0 E 1 A_FaceTarget
	TNT1 A 0 A_Playsound("Weapon/MP5/Fire")	
	CDL0 F 2 bright A_custommissile("MariaHostileSMGTracer",32,0,random(-6,6))
	CDL0 E 1 A_FaceTarget
	TNT1 A 0 A_Playsound("Weapon/MP5/Fire")	
	CDL0 F 2 bright A_custommissile("MariaHostileSMGTracer",32,0,random(-9,9))
	CDL0 E 1 A_FaceTarget
	TNT1 A 0 A_Playsound("Weapon/MP5/Fire")	
	CDL0 F 2 bright A_custommissile("MariaHostileSMGTracer",32,0,random(-3,3))
	CDL0 E 1 A_FaceTarget
	TNT1 A 0 A_Playsound("Weapon/MP5/Fire")	
	CDL0 F 2 bright A_custommissile("MariaHostileSMGTracer",32,0,random(-6,6))
	CDL0 E 1 A_FaceTarget
	TNT1 A 0 A_Playsound("Weapon/MP5/Fire")	
	CDL0 F 2 bright A_custommissile("MariaHostileSMGTracer",32,0,random(-9,9))
	CDL0 E 10 A_CPosRefire
	goto WhichMissileType
  Pain:
    CDL0 G 3
    CDL0 G 3 A_Pain
    goto See
  Death:
    CDL0 H 5
    CDL0 I 5 A_Scream
    CDL0 J 5 A_NoBlocking
    CDL0 K 5
    CDL0 L -1
    stop
  Death.Fire:
	BURN A 3 Bright 
	BURN B 3 Bright A_Playsound("Shizuka/SWAT/Burn")	
	BURN C 3 Bright A_NoBlocking
	BURN D 3 Bright
	BURN E 5 Bright 
	BURN FGH 5 Bright
	BURN I 5 Bright
	BURN JKL 5 Bright 
	BURN M 5 Bright
	BURN N 5 Bright 
	BURN OPQPQ 5 Bright
	BURN RSTU 7 Bright
	BURN V -1
	Stop
  Death.Plasma:
    PBR1 A 2 A_NoBlocking
    TNT1 A 0 
    PBR1 BBBBBB 2
    PBR1 CDEFGH 6 
    PBR1 HHHHHHHHHHHHHHHHHHHHHH 8 
    TNT1 A -1
    Stop
  Death.BFG:
	DISR A 5
	DISR BC 5
	DISR D 5 A_NoBlocking
	DISR EF 5
	DISR GHIJ 4
	TNT1 A -1
	Stop
  XDeath:
    CDL0 M 5
    CDL0 N 5 A_XScream
    CDL0 O 5 A_NoBlocking
    CDL0 PQRS 5
    CDL0 S -1
    stop
  Raise:
    CDL0 LKJIH 5
    goto See
  }
}

//===========================================================================
//
// Okaya Police (Elite)
//
//===========================================================================

actor MariaSWATElite //Replaces WolfensteinSS
{
  Game Doom
  //$Category Monsters
  //$Title "SWAT"
  obituary "Shizuka Okaya succeeded."
  health 85
  radius 20
  height 56
  mass 100
  speed 12
  painchance 170
  Decal "BulletChip"
  seesound "Shizuka/SWATElite/Sight"
  //activesound ""
  //attacksound ""
  painsound "Shizuka/SWATElite/Pain"
  deathsound "Shizuka/SWATElite/Death"
  dropitem "MariaAbakan"
  dropitem "MariaHeavyClip"
  MONSTER
  +NOINFIGHTING
  +NOTARGET
  +FLOORCLIP
  states
  {
  Spawn:
    2DB8 Z 10 A_Look
    loop
  See:
    TNT1 A 0 A_PlaySound("Shizuka/SWAT/Footsteps")
    2DB8 AABB 3 A_Chase
    TNT1 A 0 A_PlaySound("Shizuka/SWAT/Footsteps")
    2DB8 CCDD 3 A_Chase
    loop
  Missile:
    2DB8 E 10 A_FaceTarget
	goto WhichMissileType
  WhichMissileType:
    2DB8 E 0 A_JumpIfCloser(768, "FullAuto")
    2DB8 E 0 A_Jump(64, "SemiFire")
	goto SemiFire
  SemiFire:
	TNT1 A 0 A_Playsound("Weapon/Shinigami/Fire")	
    2DB8 F 2 bright A_custommissile("MariaHostileARTracer",32,0,random(-1,1))
	2DB8 E 10 A_CPosRefire
	goto See
  FullAuto:
	TNT1 A 0 A_Playsound("Weapon/Shinigami/Fire", CHAN_AUTO)	
	2DB8 F 2 bright A_custommissile("MariaHostileARTracer",32,0,random(-3,3))
	2DB8 E 2 A_FaceTarget
	TNT1 A 0 A_Playsound("Weapon/Shinigami/Fire", CHAN_AUTO)	
	2DB8 F 2 bright A_custommissile("MariaHostileARTracer",32,0,random(-6,6))
	2DB8 E 2 A_FaceTarget
	TNT1 A 0 A_Playsound("Weapon/Shinigami/Fire", CHAN_AUTO)	
	2DB8 F 2 bright A_custommissile("MariaHostileARTracer",32,0,random(-9,9))
	2DB8 E 2 A_CPosRefire
	goto FullAuto+1
  Pain:
    2DB8 G 3
    2DB8 G 3 A_Pain
    goto See
  Death:
    2DB8 H 5
    2DB8 I 5 A_Scream
    2DB8 J 5 A_NoBlocking
    2DB8 K 5
    2DB8 L -1
    stop
  Death.Fire:
	BURN A 3 Bright 
	BURN B 3 Bright A_Playsound("Shizuka/SWAT/Burn")	
	BURN C 3 Bright A_NoBlocking
	BURN D 3 Bright
	BURN E 5 Bright 
	BURN FGH 5 Bright
	BURN I 5 Bright
	BURN JKL 5 Bright 
	BURN M 5 Bright
	BURN N 5 Bright 
	BURN OPQPQ 5 Bright
	BURN RSTU 7 Bright
	BURN V -1
	Stop
  Death.Plasma:
    PBR1 A 2 A_NoBlocking
    TNT1 A 0 
    PBR1 BBBBBB 2
    PBR1 CDEFGH 6 
    PBR1 HHHHHHHHHHHHHHHHHHHHHH 8 
    TNT1 A -1
    Stop
  Death.BFG:
	DISR A 5
	DISR BC 5
	DISR D 5 A_NoBlocking
	DISR EF 5
	DISR GHIJ 4
	TNT1 A -1
	Stop
  XDeath:
    2DB8 M 5
    2DB8 N 5 A_XScream
    2DB8 O 5 A_NoBlocking
    2DB8 PQRST 5
    2DB8 T -1
    stop
  Raise:
    2DB8 LKJIH 5
    goto See
  }
}