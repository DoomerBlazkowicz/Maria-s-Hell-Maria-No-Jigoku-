//==============================================================================
// Panzerfaust 3 Rocket Launcher
//==============================================================================
// Caliber: 60mm Rocket
//==============================================================================
//
// 
// 
//
// 
//==============================================================================
Actor MariaRocketLauncher : MariaWeapon //Replaces Rocketlauncher
{
	Weapon.AmmoType1 "MariaRocketLauncherLoaded"
	Weapon.AmmoGive2 1
	Weapon.AmmoType2 "MariaRocketAmmo" 
	+WEAPON.NOAUTOFIRE
	+WEAPON.AMMO_CHECKBOTH
	Inventory.PickupSound "Weapon/RocketLauncher/Pickup"
	Inventory.PickupMessage "Panzerfaust-3 Obtained!"
	Tag "Bazooka"
	States
	{
	Ready:
		MIES A 0 
		{
		A_SetSpeed(0.70);
		A_PlaySound("Maria/Draw/Heavy");
		If(CountInv("MariaRocketLauncherLoaded") < 1) { return state(2); }
		return state("");
		}
		MISS A 0
		"####" ABCDE 1
		Goto ReadyLoop

	ReadyLoop:
		MIS2 A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		MISG B 0 A_JumpIf(CountInv("MariaRocketLauncherLoaded") < 1, 2)
		MISG A 0
		MISG "#" 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
		Loop

	Ready2:
		MIS2 A 2 BRIGHT A_WeaponReady (WRF_NOBOB)
		MIS2 A 0 A_SetPitch(pitch-frandom(-0.18,0.18))
		MIS2 A 2 BRIGHT A_WeaponReady (WRF_NOBOB)
		MIS2 A 0 A_SetPitch(pitch-frandom(-0.18,0.18))
		Loop

	Deselect:
		MIED A 0 
		{
		A_SetSpeed(1.0);
		A_ZoomFactor(1.0);
		A_Takeinventory("Zoomed",0);
		If(CountInv("MariaRocketLauncherLoaded") < 1) { return state(2); }
		return state("");
		}
		MISD A 0
		"####" ABCDE 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1
		Wait

	Select:
		TNT1 AA 0 A_Raise
		Loop

	Fire:
		"####" "#" 0 A_JumpIf(CountInv("MariaRocketLauncherLoaded") < 1, "DryFire")
		"####" "#" 1 Offset(0,33)
		"####" "#" 1 Offset(0,34)
		"####" "#" 0 A_PlaySound("Weapon/Shinigami/Dry",0)
		"####" "####" 1
	FireCounted:
		MISG A 0 
		{
		A_GunFlash;
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlaySound("Weapon/RocketLauncher/Fire", CHAN_WEAPON);
		A_PlaySound("Weapon/RocketLauncher/Distant", 6);
		A_AlertMonsters;
		A_TakeInventory("MariaRocketLauncherLoaded", 1);
		A_Recoil(2);
		A_FireCustomMissile("MariaRocketPlayer");
		If(CountInv("Zoomed") == 1) { return state("FireCountedZoomed"); }
		return state("");
		}
		MISF A 1 A_SetPitch(pitch-2.0)
		MISF B 1 A_SetPitch(pitch+0.4)
		MISF C 1 A_SetPitch(pitch+0.4)
		MISF D 2 A_SetPitch(pitch+0.4)
		MISF E 2 A_SetPitch(pitch+0.4)
		MISF F 2 A_SetPitch(pitch+0.4)
		MISF GHIJ 2
		MISG B 8
		TNT1 A 0 A_CheckReload
		MISG A 0 //A_ReFire
		Goto ReadyLoop

	FireCountedZoomed:
		MIS2 A 1 BRIGHT A_SetPitch(pitch-2.0)
		MIS2 A 1 BRIGHT A_SetPitch(pitch+0.4)
		MIS2 A 1 BRIGHT A_SetPitch(pitch+0.4)
		MIS2 A 2 BRIGHT A_SetPitch(pitch+0.4)
		MIS2 A 2 BRIGHT A_SetPitch(pitch+0.4)
		MIS2 A 2 BRIGHT A_SetPitch(pitch+0.4)
		MIS2 A 12 BRIGHT
		TNT1 A 0 A_CheckReload
		MISG A 0 //A_ReFire
		Goto Ready2

	DryFire:
		"####" "#" 0 A_PlaySound("Weapon/RocketLauncher/Dry",0)
		"####" "#" 1 { A_WeaponOffset(0,36); A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH); }
		"####" "#" 10 { A_WeaponOffset(0,35); A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH); }
		Goto ReadyLoop

	AltFire:
		TNT1 A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		TNT1 A 0 A_Giveinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(2.0)
		MBOZ A 0 A_SetBlend("Black",0.1,3)
		MBOZ C 0 A_PlaySound("Weapon/RocketLauncher/Zoom/In",CHAN_BODY)
		MISG B 0 
		MISG A 0
		MISG "#" 1 
		{
		A_PlaySound("Foley/Sleeves/Movement", CHAN_AUTO);
		If(CountInv("MariaRocketLauncherLoaded") < 1) { return state("EmptyAltFire"); }
		return state("");
		}
		MISZ ABC 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		MIS2 A 1 /*Bright*/ A_SetBlend("Black",0.4,3)
		TNT1 A 0 A_Giveinventory("RocketlauncherInfrared",1)
		MIS2 A 1 /*Bright*/ A_SetBlend("Black",0.6,3)
		MIS2 A 1 /*Bright*/ A_SetBlend("Black",0.8,3)
		MIS2 A 1 /*Bright*/ A_SetBlend("Black",1.0,6)
		MIS2 A 3
		Goto Ready2

	EmptyAltFire:
		MISZ DEF 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		MIS2 A 1 /*Bright*/ A_SetBlend("Black",0.4,3)
		TNT1 A 0 A_Giveinventory("RocketlauncherInfrared",1)
		MIS2 A 1 /*Bright*/ A_SetBlend("Black",0.6,3)
		MIS2 A 1 /*Bright*/ A_SetBlend("Black",0.8,3)
		MIS2 A 1 /*Bright*/ A_SetBlend("Black",1.0,6)
		MIS2 A 3
		Goto Ready2

	NoAim:
		MIS2 A 3 A_PlaySound("Weapon/RocketLauncher/Zoom/Out",CHAN_BODY)
		TNT1 A 0 A_Takeinventory("Zoomed",0)
		MIS2 A 1 A_SetBlend("Black",0.2,3)
		MIS2 A 1 A_SetBlend("Black",0.4,3)
		MIS2 A 1 A_SetBlend("Black",0.6,3)
		MIS2 A 1 A_SetBlend("Black",0.8,3)
		MIS2 A 1 A_SetBlend("Black",1.0,6) 
		MISZ A 0 
		{
		A_Takeinventory("PowerInfiniteAmmo",1);
		A_ZoomFactor(1.0);
		A_PlaySound("Foley/Sleeves/Movement", CHAN_AUTO);
		If(CountInv("MariaRocketLauncherLoaded") < 1)
			{
				return state("EmptyNoAim");
			}
			return state("");
		}
		MISZ CBA 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		MISG A 3 
		Goto ReadyLoop

	EmptyNoAim:
		MISZ FED 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		MISG B 3 
		Goto ReadyLoop

	Reload:
		TNT1 A 0 A_JumpIfInventory("MariaRocketLauncherLoaded", 0, 2)
		TNT1 A 0 A_JumpIfInventory("MariaRocketAmmo", 1, "ReloadWork")
		MISG A 0 A_WeaponReady(WRF_NOFIRE)
		Goto ReadyLoop

	ReloadWork:
		MISR A 2
		TNT1 A 0 A_StartSound("Foley/RocketLauncher/Movement", CHAN_AUTO)
		MISR A 1 Offset(-1,33)
		MISR A 1 Offset(-2,33)
		MISR A 1 Offset(-3,39)
		MISR A 1 Offset(-4,41)
		MISR A 1 Offset(-5,43)
		MISR B 1 Offset(-6,46)
		TNT1 A 0 A_StartSound("Foley/RocketLauncher/Movement", CHAN_AUTO)
		MISR B 2 Offset(-7,55)
		MISR B 2 Offset(-8,58) 
		MISR B 2 Offset(-8,61)
		MISR B 2 Offset(-9,62)
		MISR B 2 Offset(-9,65)
		MISR B 3 Offset(-9,70)
		MISR B 3 Offset(-10,70)
		TNT1 A 0 A_PlaySound("Weapon/RocketLauncher/Reload/Insert", 2)
		MISR C 4 Offset(-9,66)
		MISR C 4 Offset(-9,64)
		MISR C 4 Offset(-9,62)
		MISR C 3 Offset(-8,61) 
		MISR C 3 Offset(-8,60)
		Goto ReloadingLoop

	ReloadingLoop:
		TNT1 A 0 A_TakeInventory("MariaRocketAmmo", 1,TIF_NOTAKEINFINITE)
		TNT1 A 0 A_GiveInventory("MariaRocketLauncherLoaded", 1)
		TNT1 A 0 A_JumpIfInventory("MariaRocketLauncherLoaded", 0, "FinishReload")
		TNT1 A 0 A_JumpIfInventory("MariaRocketAmmo", 1, "ReloadingLoop")
		Goto FinishReload

	FinishReload:
		MISR C 3 Offset(-8,59)
		TNT1 A 0 A_StartSound("Maria/Draw/Heavy", CHAN_AUTO)
		MISR C 3 Offset(-8,58)
		MISR C 2 Offset(-7,55)
		MISR D 2 Offset(-6,46)
		MISR D 2 Offset(-4,41)
		MISR D 2 Offset(-3,39)
		MISR D 1 Offset(-2,33)
		MISR D 1 Offset(-1,33)
		MISG A 1
		Goto ReadyLoop

	ThrowPipebomb:
		MIED A 0 A_JumpIf(CountInv("MariaRocketLauncherLoaded") < 1, 2)
		MISD A 0
		"####" ABCDE 1
		TASQ ABC 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TASG DEH 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1,TIF_NOTAKEINFINITE)
		TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
		TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
		TASG KLM 1
		TASG OPQR 1 
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TAHA AB 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
		TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
		TAHA CDE 1
		TNT1 A 5
		MIES A 0 A_JumpIf(CountInv("MariaRocketLauncherLoaded") < 1, 2)
		MISS A 0
		"####" ABCDE 1
		Goto ReadyLoop

	UseStimShot:
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealth
		MIED A 0 A_JumpIf(CountInv("MariaRocketLauncherLoaded") < 1, 2)
		MISD A 0
		"####" ABCDE 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		MIES A 0 A_JumpIf(CountInv("MariaRocketLauncherLoaded") < 1, 2)
		MISS A 0
		"####" ABCDE 1
		Goto ReadyLoop

	User3:
	EquipShield:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("MariaShield",1)
		TNT1 A 0 A_SelectWEapon("MariaShield")
		Goto Deselect

	Flash:
		TNT1 A 2 Bright A_Light1
		TNT1 A 2 Bright A_Light2
		TNT1 A 1 Bright A_Light1
		Goto LightDone

	Zoom:
        TNT1 A 0 
		{
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
        A_PlaySound("weapons/melee/fist/uppercut");
		A_ChangeVelocitY(2.5,0,2,CVF_RELATIVE);
        A_gunflash("PunchFlash"); //PunchFlash
		}
		TNT1 A 2
		HANU AB 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		HANU C 0 A_FireCustomMissile("MariaPunch2",0,0)
		HANU CCDEFGHIJK 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 5 //19
		Goto PunchFinish

	PunchFlash:
		MIEK A 0 A_JumpIf(CountInv("MariaRocketLauncherLoaded") < 1, 2)
		MISK A 0
		"####" ABC 1
		"####" D 12
		"####" CBA 1
		MISG B 0 A_JumpIf(CountInv("MariaRocketLauncherLoaded") < 1, 2)
		MISG A 0
		MISG "#" 1
		Goto LightDone

	Spawn:
		RKTL A -1
		Stop
	}
}

ACTOR MariaRocketLauncherLoaded : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 1
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 1
	Inventory.Icon ""
}

ACTOR RocketlauncherInfrared : PowerupGiver
{
	-COUNTITEM
	+INVENTORY.AUTOACTIVATE
	+INVENTORY.ALWAYSPICKUP
	Inventory.MaxAmount 0
	Powerup.Type PowerInfiniteAmmo
	Powerup.Duration -999
	Powerup.Colormap 0.05, 0.0, 0.0, 0.1, 1.0, 0.1
	States
	{
	Spawn:
		TNT1 A -1
		Loop
	}
}

Actor MariaRocketBackblast: FastProjectile
{
	speed 80
	damage (random(12,12))
	Decal "Scorch"
	Radius 22
	Height 12
	Alpha 0.9
	Scale 1.0
	RenderStyle "Add"
	+RIPPER
	+GHOST
	+THRUGHOST
	Species "Marines"
	+THRUSPECIES
	DamageType Shotgun
	Obituary "$OBBD_ROCKETBACKBLAST"
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 2
		//TNT1 A 0 A_CustomMissile("ExplosionSmokeHD", 2, 0, random(0, 360), 2, random(0, 90))
		EXPL GHI 1 //A_CustomMissile ("BackblastFlames", 0, 0, random (0, 360), 2, random (0, 360))
		Stop

	Death:
		TNT1 A 0
		TNT1 A 0 ACS_NamedExecuteAlways("CheckRocketBackblast")
		TNT1 A 3
		TNT1 A 0 A_Explode(4, 1, 0)
		TNT1 A 0 A_SpawnItemEx ("LiquidExplosionEffectSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 A 0 A_CustomMissile("ExplosionSmokeHD", 2, 0, random(0, 360), 2, random(0, 90))
		Stop

	Disappear:
		TNT1 A 0
		Stop
	}
}

Actor MariaRocketBackblast2: MariaRocketBackblast
{
	Decal "None"
	Radius 4
	Height 4
	//DamageType "Shrapnel"
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 2
		TNT1 A 0 A_CustomMissile("ExplosionSmokeHD", 2, 0, random(0, 360), 2, random(0, 90))
		TNT1 GHI 1 //A_CustomMissile ("BackblastFlames", 0, 0, random (0, 360), 2, random (0, 360))
		Stop

	Death:
		TNT1 A 0
		TNT1 A 3
		//TNT1 A 0 A_Explode(22, 2)
		TNT1 A 0 A_SpawnItemEx ("LiquidExplosionEffectSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 A 0 A_CustomMissile("ExplosionSmokeHD", 2, 0, random(0, 360), 2, random(0, 90))
		Stop
	}
}

Actor MariaRocketBackblast3: MariaRocketBackblast2
{
	Radius 32
	Height 12
	//Damagetype "Shrapnel"
	States
	{
	Death:
		TNT1 A 3
		TNT1 A 0 A_Explode(32, 64, 0, 0, 64)
		TNT1 A 0 A_SpawnItemEx ("LiquidExplosionEffectSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		//TNT1 A 0 A_CustomMissile("ExplosionSmokeHD", 2, 0, random(0, 360), 2, random(0, 90))
		Stop
	}
}


ACTOR MariaRocketLauncherPiece : WeaponPiece
{
	//Inventory.PickupSound "misc/w_pkup"
	WeaponPiece.Weapon MariaRocketLauncherHexen
	+FLOATBOB
	+NOGRAVITY
}

ACTOR MariaRocketLauncherPiece1 : MariaRocketLauncherPiece
{
	WeaponPiece.Number 1
	Inventory.PickupMessage "You got a Rocket Launcher Scope!"
	States
	{
	Spawn:
		RKT1 A -1 Bright
		Stop
	}
}

ACTOR MariaRocketLauncherPiece2 : MariaRocketLauncherPiece
{
	WeaponPiece.Number 2
	Inventory.PickupMessage "You got a Rocket Launcher Base!"
	States
	{
	Spawn:
		RKT2 A -1 Bright
		Stop
	}
}

ACTOR MariaRocketLauncherPiece3 : MariaRocketLauncherPiece
{
	WeaponPiece.Number 3
	Inventory.PickupMessage "You got a Rocket Launcher Parts!"
	States
	{
	Spawn:
		RKT3 A -1 Bright
		Stop
	}
}

ACTOR MariaRocketLauncherDrop
{
	States
	{
	Spawn:
		TNT1 A 1
		TNT1 A 1 A_DropWeaponPieces("MariaRocketLauncherPiece1", "MariaRocketLauncherPiece2", "MariaRocketLauncherPiece3")
		Stop
	}
}

ACTOR MariaRocketLauncherHexen : MariaRocketLauncher
{
	Health 3
	Weapon.slotnumber 7
	+Weapon.cheatnotweapon
	Inventory.PickupMessage "The BFG 10k assembled!"
}
