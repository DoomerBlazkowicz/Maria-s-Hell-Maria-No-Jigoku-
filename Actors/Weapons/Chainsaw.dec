//==============================================================================
// Mixom Beavertooth Painsaw
//==============================================================================
// Caliber: Fuel (Gasoline/Aerosol)
//==============================================================================
// I remember how I killed Kinugawa with a Chainsaw a long ago, now it's here
// once again. 
// 
// Now I need to mind the fuel in this beast whenever I use it.
//==============================================================================
ACTOR MariaChainsaw : MariaWeapon 
{
	Weapon.AmmoGive 25
	Weapon.AmmoType "MariaGasoline"
	//Weapon.UpSound "Weapon/Chainsaw/Select" 
	Inventory.PickupSound "Weapon/Chainsaw/Pickup"
	//Weapon.ReadySound "Weapon/Chainsaw/Idle"
	Inventory.PickupMessage "Chainsaw obtained! Time to Kick Back!"
	Obituary "$OB_MPCHAINSAW"
	Tag "Chainsaw"
	+WEAPON.AXEBLOOD
	+WEAPON.MELEEWEAPON
	+WEAPON.AMMO_CHECKBOTH
	States
	{
	Ready:
		TNT1 A 0 A_PlaySound("Maria/Draw/Equipment", 1)
		SAWS ABCDE 1
		TNT1 A 0 A_PlaySound("Weapon/Chainsaw/Pull", 2) 
		SAWS FGH 1
		TNT1 A 0 
		{
		If(CountInv("MariaGasoline") > 1) { A_PlaySound("Weapon/Chainsaw/Select", 3); }			
		return state("");
		}
		SAWS IJKL 1
		SAWS MNOP 1
		Goto ReadyLoop

	ReadyLoop:
		SAWG A 0 
		{
		If(CountInv("MariaGasoline") < 1) {return state("EmptyLoop"); }
		A_PlaySound("Weapon/Chainsaw/Idle");
		return state("");
		}
		SAWG ABCD 2 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
		Loop

	EmptyLoop:
		SAWG A 2 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
		Loop

	Deselect:
		SAWD A 0 
		{
		A_StopSound(2);
		If(CountInv("MariaGasoline") > 1)
			{
				A_PlaySound("Weapon/Chainsaw/Dequip", 1);
			}
			return state("");
		}
		SAWD ABCD 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1
		Wait

	Select:
		TNT1 AA 0 A_Raise
		Loop

	Fire:
		NULL A 0 A_JumpIf(CountInv("MariaGasoline") < 1, "DryFire")
		SAWD A 0 A_StopSound(2)
		SAWG A 1
		SAWF AB 1
	Hold:
		NULL A 0 
		{
		If(CountInv("MariaGasoline") < 1) { return state("DryFire"); }
		A_AlertMonsters;
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlaySound("Weapon/Chainsaw/Attack", CHAN_WEAPON);
		A_TakeInventory("MariaGasoline", 1, TIF_NOTAKEINFINITE);
		A_PlaySound("Weapon/Chainsaw/Attack");
		return state("");
		}
		SAWF C 1 A_FireCustomMissile("MariaChainsawHit",0,0,0,6)
		SAWF D 1
		{
		radius_quake (1, 2, 0, 1, 0);
		A_AlertMonsters;
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlaySound("Weapon/Chainsaw/Attack");
		}
		SAWF E 1 A_FireCustomMissile("MariaChainsawHit",0,0,0,6)
		SAWF F 1 
		{
		radius_quake (1, 2, 0, 1, 0);
		A_CheckReload;
		A_AlertMonsters;
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlaySound("Weapon/Chainsaw/Attack", CHAN_WEAPON);
		A_TakeInventory("MariaGasoline", 1, TIF_NOTAKEINFINITE);
		A_PlaySound("Weapon/Chainsaw/Attack");
		}
		SAWF C 1 A_FireCustomMissile("MariaChainsawHit",0,0,0,6)
		SAWF D 1
		{
		radius_quake (1, 2, 0, 1, 0);
		A_AlertMonsters;
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlaySound("Weapon/Chainsaw/Attack");
		}
		SAWF E 1 A_FireCustomMissile("MariaChainsawHit",0,0,0,6)
		SAWF F 1 
		{
		radius_quake (1, 2, 0, 1, 0);
		A_CheckReload;
		}
		TNT1 A 0 A_JumpIfInventory("MariaGasoline", 1, 1)
		SAWF A 0 A_ReFire
		Goto FireDone

	FireDone:
		TNT1 A 0 A_StopSound(CHAN_WEAPON)
		TNT1 A 0 A_PlaySound("Weapon/Chainsaw/Stop", 3)
		SAWF BAA 1
		Goto ReadyLoop

	AltFire:
		NULL A 0 A_JumpIf(CountInv("MariaGasoline") < 4, "DryFire")
		SAWA ABCD 1
		TNT1 A 2
	Right:
		NULL A 0 A_JumpIf(CountInv("MariaGasoline") < 4, "DryFire")
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Weapon/Chainsaw/Attack", CHAN_WEAPON)
		SAWA EF 1
		TNT1 A 0 A_ChangeVelocitY(2.5,0,2,CVF_RELATIVE ) 
		TNT1 A 0 A_TakeInventory("MariaGasoline", 1)
		SAWA G 1 A_FireCustomMissile("MariaChainsawHit",0,0,0,6)
		TNT1 B 0 radius_quake (1, 2, 0, 1, 0)
		TNT1 A 0 A_TakeInventory("MariaGasoline", 1)
		SAWA H 1 A_FireCustomMissile("MariaChainsawHit",0,0,0,6)
		TNT1 B 0 radius_quake (1, 2, 0, 1, 0)
		TNT1 A 0 A_TakeInventory("MariaGasoline", 1)
		SAWA I 1 A_FireCustomMissile("MariaChainsawHit",0,0,0,6)
		TNT1 B 0 radius_quake (1, 2, 0, 1, 0)
		TNT1 A 0 A_TakeInventory("MariaGasoline", 1)
		SAWA J 1 A_FireCustomMissile("MariaChainsawHit",0,0,0,6)
		TNT1 B 0 radius_quake (1, 2, 0, 1, 0)
		SAWA KL 1
		TNT1 A 4
		TNT1 A 1 A_Refire("Left")
		Goto Returning

	Left:
		NULL A 0 A_JumpIf(CountInv("MariaGasoline") < 4, "DryFire")
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Weapon/Chainsaw/Attack", CHAN_WEAPON)
		SAWA MNO 1
		TNT1 A 0 A_ChangeVelocitY(2.5,0,2,CVF_RELATIVE ) 
		TNT1 A 0 A_TakeInventory("MariaGasoline", 1)
		SAWA P 1 A_FireCustomMissile("MariaChainsawHit",0,0,0,6)
		TNT1 B 0 radius_quake (1, 2, 0, 1, 0)
		TNT1 A 0 A_TakeInventory("MariaGasoline", 1)
		SAWA Q 1 A_FireCustomMissile("MariaChainsawHit",0,0,0,6)
		TNT1 B 0 radius_quake (1, 2, 0, 1, 0)
		TNT1 A 0 A_TakeInventory("MariaGasoline", 1)
		SAWA R 1 A_FireCustomMissile("MariaChainsawHit",0,0,0,6)
		TNT1 B 0 radius_quake (1, 2, 0, 1, 0)
		TNT1 A 0 A_TakeInventory("MariaGasoline", 1)
		SAWA S 1 A_FireCustomMissile("MariaChainsawHit",0,0,0,6)
		TNT1 B 0 radius_quake (1, 2, 0, 1, 0)
		SAWA T 1
		TNT1 A 4
		TNT1 A 1 A_Refire("Right")
		Goto Returning

	Returning:
		TNT1 A 0 A_StopSound(CHAN_WEAPON)
		TNT1 A 0 A_PlaySound("Weapon/Chainsaw/Stop", 3)
		SAWA DDD 1
		SAWA CC 1
		SAWA BA 1
		Goto ReadyLoop

	DryFire:
		SAWG A 2 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		Goto ReadyLoop

	ThrowPipebomb:
		SAWD ABCD 1
		TASQ ABC 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TASG DEH 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
		TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
		TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
		TASG KLM 1
		TASG OPQR 1 
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TAHA AB 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
		TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
		TAHA CDE 1
		TNT1 A 5
		SAWS ABCD 1
		Goto ReadyLoop

	UseStimShot:
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealth
		SAWD ABCD 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		SAWS ABCD 1
		Goto ReadyLoop

	KickFinish: //Added for empty state
		TNT1 A 0 A_JumpIfInventory("MariaGasoline", 1, 1)
		TNT1 A 0 A_Jump(256,"EmptyReadyLoop")
		TNT1 A 0 A_Jump(256,"ReadyLoop")

	Zoom:
        TNT1 A 0 
		{
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
        A_PlaySound("weapons/melee/fist/uppercut");
		A_ChangeVelocitY(2.5,0,2,CVF_RELATIVE);
        A_gunflash("PunchFlash"); //PunchFlash
		}
		TNT1 A 2
		HANU AB 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		HANU C 0 A_FireCustomMissile("MariaPunch2",0,0)
		HANU CCDEFGHIJK 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 5 //19
		Goto PunchFinish

	User3:
	EquipShield:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("MariaShield",1)
		TNT1 A 0 A_SelectWEapon("MariaShield")
		Goto Deselect

	PunchFlash:
		TNT1 A 0 A_JumpIfInventory("MariaGasoline", 1, 1)
		Goto PunchFlashEmpty
		SAWK AB 1
		SAWK CDCDCDCDCD 1
		SAWK BA 1
		SAWK A 1
		Goto LightDone

	PunchFlashEmpty:
		SAWK AB 1
		SAWK C 14
		SAWK BA 1
		SAWK A 1
		Goto LightDone

	Spawn:
		//SLYR A 0 A_spawnitemex("DeadKinugawa")
		CSAW A -1
		Stop
	}
}