//==============================================================================
// Remington 870
//==============================================================================
// Caliber: 12 Gauge
//==============================================================================
// Japan LACKED shotgun's, thankfully UAC send shotgun's for Police, JSDF or
// UAC's Japanese Branch. Good for eliminating anyone when they show up,  
// and yes it's a workhorse of killing demons.
//==============================================================================
ACTOR MariaShotgun : MariaWeapon //replaces Shotgun
{
	Weapon.AmmoType1 "MariaShotgunLoaded"
	Weapon.AmmoType2 "Shell"
	Weapon.AmmoGive2 4
	Inventory.PickupMessage "Shotgun Obtained!"
    Inventory.PickupSound "Weapon/Shotgun/Pickup"
	+WEAPON.NOAUTOFIRE
	+WEAPON.NOALERT
    +WEAPON.AMMO_CHECKBOTH
	Tag "Combat Shotgun"
	States
	{
	Spawn:
        TNT1 A 0 nodelay A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacySpawn")
		REMT A -1
		Stop
	Select:
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacySelect")
		TNT1 AA 0 A_Raise
		Loop
	Deselect:
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyDeselect")
        REMD ABCDE 1
        TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
        TNT1 A 1
        Wait
	Ready:
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyReady")
        TNT1 A 0 A_PlaySound("Maria/Draw/Primary")
        REMS ABCDE 1
        Goto ReadyLoop
	ReadyLoop:
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyReadyLoop")
		REMG A 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
		Loop
    Fire:
        NULL A 0 A_JumpIfInventory("MariaShotgunLoaded", 1, 1)
        Goto DryFire
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyFire")
        TNT1 A 0 A_PlaySound("Weapon/Shinigami/Dry",0)
	    REMG A 1 Offset(0,33)
	    REMG A 1 Offset(0,34)
	    REMG A 1
	FireCounted:
        NULL A 0 A_JumpIfInventory("MariaShotgunLoaded", 1, 1)
        Goto DryFire
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyFireCounted")
        REMG A 0 A_AlertMonsters
        REMG A 0 A_GunFlash
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
        TNT1 A 0 A_TakeInventory("MariaShotgunLoaded", 1)
        REMF A 0 BRIGHT A_PlayWeaponSound("Weapon/Shotgun/Fire")
		TNT1 A 0 A_PlaySound("Weapon/Shotgun/Distant", 6)
        TNT1 B 0 radius_quake (6, 3, 0, 1, 0)
        TNT1 A 0 A_FireCustomMissile("MariaFlareOrange",0,0,0,8)
        TNT1 AAA 0 A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8)
        TNT1 A 0 A_FireBullets(3.6, 3.6, 9, 5, "MariaShotgunPuff")
        REMF A 1 BRIGHT A_SetPitch(pitch-0.5)
        REMF B 1 A_SetPitch(pitch-2.5)
        REMF C 1 A_SetPitch(pitch-1.5)
        REMF D 1 A_SetPitch(pitch-0.5)
        REMF DEEF 1
        REMF GHI 1
        REMG B 0 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        REMG A 1
		TNT1 A 0 A_StartSound("Foley/Shotgun/Movement", CHAN_AUTO)
        REMG BCDEFG 1
        TNT1 A 0 A_PlaySound("Weapon/Shotgun/Rack/Back",2)
        REMG GHIJ 1      		
        TNT1 A 0 A_SpawnItemEx("ShotgunCasingBuckshot", 14, -2, 35, 0, random(2,4), random(2,4))
        REMG KLMN 1
        TNT1 A 0 A_PlaySound("Weapon/Shotgun/Rack/Foward",3)
        REMG OPQR 1
        REMG E 1
		TNT1 A 0 A_StartSound("Foley/Shotgun/Movement", CHAN_AUTO)
        REMG D 1
        REMG CBA 1
        REMG A 1
        REMG A 0 A_Refire
        Goto ReadyLoop
	AltFire:
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyAltFire")
        //SSGG A 0 A_JumpIfInventory("PowerStrength",1,"BerserkedAlt")
	    REMG A 1
	    REMM A 1
        TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
	    REMM B 1
	    REMM C 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
	    REMM D 1 A_PlaySound ("Weapon/NOB/Melee", CHAN_WEAPON, 7, 0, 0, 0.20)
	    REMM EF 1
	    REMM G 1 A_FireCustomMissile("MariaShotgunStockPuff",0,0,0,6)
	    REMM GGHHI 2
	    REMM JKLM 1
	    REMM CBA 1
	    REMG A 1
	    REMG A 0 A_ReFire		
        Goto ReadyLoop
    DryFire:
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyDryFire")
        TNT1 A 0 A_PlaySound("Weapon/Shotgun/Dry",0)
        TNT1 A 0 offset(0,36)
        REMG A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
        TNT1 A 0 offset(0,35)
        REMG A 10 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
        Goto ReadyLoop
    Reload:
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyReload")
        REMG A 1
        TNT1 A 0 A_JumpIfInventory("MariaShotgunLoaded", 0, "ReadyLoop")
        TNT1 A 0 A_JumpIfInventory("MariaShotgunLoaded", 1, "ReloadNormally")
    ReloadNormally:
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyReloadNormally")
        TNT1 A 0 A_JumpIfInventory("Shell", 1, 1)
        Goto ReadyLoop //Abandon reload and return to ready
        REMG B 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_StartSound("Weapon/LegacyShotgun/Flip", CHAN_AUTO)
        REMG CD 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_StartSound("Foley/Shotgun/Reload/Raise", CHAN_AUTO)
        REMG EF 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        REMR ABC 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
    ReloadLoop:
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        Goto ReloadAfter
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyReloadLoop")
        TNT1 A 0 A_JumpIfInventory("MariaShotgunLoaded", 0, "ReloadAfter")
        TNT1 A 0 A_Giveinventory("MariaShotgunLoaded",1)
        TNT1 A 0 A_Takeinventory("Shell",1)
		REMR DE 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        TNT1 A 0 A_StartSound("Foley/Shotgun/Reload/Load", CHAN_AUTO)
        REMR F 0 A_PlaySound("Weapon/Shotgun/Insert")
		REMR FGHIJ 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		REMR CC 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		REMR CCC 3 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        Goto ReloadLoop
    ReloadAfter:
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyReloadAfter")
        REMR CBA 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        REMG FG 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        REMG H 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        TNT1 A 0 A_PlaySound("Weapon/Shotgun/Rack/Back",2)
        REMG IJKLMN 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        REMG OPQR 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        TNT1 A 0 A_PlaySound("Weapon/Shotgun/Rack/Foward",3)
        REMG E 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_StartSound("Foley/Shotgun/Reload/Lower", CHAN_AUTO)
        REMG D 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        REMG CBA 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        REMG A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        Goto ReadyLoop  

/*    ReloadNormally2:
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyReloadNormally2")
        TNT1 A 0 A_JumpIfInventory("Shell", 1, 1)
        Goto ReadyLoop //Abandon reload and return to ready
        REMG B 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_StartSound("Weapon/LegacyShotgun/Flip", CHAN_AUTO)
        REMG CD 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_StartSound("Foley/Shotgun/Reload/Raise", CHAN_AUTO)
        REMG EF 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        REMR ABC 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
    ReloadLoop2:
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        Goto ReloadAfter2
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyReloadLoop2")
        TNT1 A 0 A_JumpIfInventory("MariaShotgunLoaded", 0, "ReloadAfter2")
        TNT1 A 0 A_Giveinventory("MariaShotgunLoaded",1)
        TNT1 A 0 A_Takeinventory("Shell",1)
		REMR DE 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        TNT1 A 0 A_StartSound("Foley/Shotgun/Reload/Load", CHAN_AUTO)
        REMR F 0 A_PlaySound("Weapon/Shotgun/Insert")
		REMR FGHIJ 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		REMR C 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		REMR C 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		REMR CC 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		REMR CCC 3 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        Goto ReloadLoop2
    ReloadAfter2:
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyReloadAfter2")
        REMR CBA 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        REMG FG 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        REMG H 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        TNT1 A 0 A_PlaySound("Weapon/Shotgun/Rack/Back",2)
        REMG IJKLMN 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        REMG OPQR 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        TNT1 A 0 A_PlaySound("Weapon/Shotgun/Rack/Foward",3)
        REMG E 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_StartSound("Foley/Shotgun/Reload/Lower", CHAN_AUTO)
        REMG D 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        REMG CBA 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        REMG A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        Goto ReadyLoop  */

	Flash:
		TNT1 A 2 BRIGHT A_Light2
		TNT1 A 2 BRIGHT A_Light1
		TNT1 A 0 A_Light0
		Stop

    ThrowPipebomb:
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyThrowPipebomb")
        REMD ABCD 1
        TASQ ABC 1
        TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
        TASG DEH 1
        TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
        TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
        TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
        TASG KLM 1
        TASG OPQR 1 
        TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
        TAHA AB 1
        TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
        TNT1 A 0 A_Jump(256,2)
        TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
        TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
        TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
        TAHA CDE 1
        TNT1 A 5
        REMS ABCDE 1
        Goto ReadyLoop

	UseStimShot:
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyUseStimShot")
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealth
        REMD ABCDE 1
        SYRI AB 1
        TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
        SYRI CD 1
        SYRI EEFFGGG 1
        SYRI HIJKKLLL 1
        TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
        SYRI MNOPQQQRR 1
        TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
        SYRI STUUUVV 1
        TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
        SYRI WXYZ 1
        SYR2 AB 1
        TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
        TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
        SYR2 CD 1
        TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
        TNT1 A 0 A_SetBlend("BLUE",.5,25)
        TNT1 A 0 HealThing(10, 100)
        TNT1 A 0 A_GiveInventory("SyringeProtection")
        TNT1 A 0 A_GiveInventory("SyringeRegeneration")
        SYR2 EFGHIJ 2
        SYR2 KLLMMN 1
        TNT1 A 5
        REMS ABCDE 1
	    Goto ReadyLoop
	FullHealth:
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyFullHealth")
		TNT1 A 0 A_Print("You are healthy.")
		Goto ReadyLoop

	User3:
	EquipShield:
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyEquipShield")
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("MariaShield",1)
		TNT1 A 0 A_SelectWEapon("MariaShield")
		Goto Deselect
			
	PunchFlash:
        TNT1 A 0 A_JumpIf(CallACS("ShotgunSkinToggler")==1, "LegacyPunchFlash")
		REMK ABC 1
		REMK D 12
		REMK CBA 1
		REMG A 1
		Goto LightDone

////////////////////////////////
//Legacy Pump Action (Spas 12)//
////////////////////////////////
//==============================================================================
// Spas 12
//==============================================================================
// Caliber: 12 Gauge
//==============================================================================
// Japan LACKED shotgun's, thankfully UAC send shotgun's for Police, JSDF or
// UAC's Japanese Branch. Good for eliminating anyone when they show up,  
// and yes it's a workhorse of killing demons.
//==============================================================================

	LegacySpawn:
		SPAP A -1
		Stop
	LegacySelect:
        TNT1 AA 0 A_Raise
		Loop
	LegacyDeselect:
     	SPAD ABCDE 1
        TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
        TNT1 A 1
		Loop
	LegacyReady:
        TNT1 A 0 A_PlaySound("Maria/Draw/Primary")
        SPAS ABCDE 1
        Goto LegacyReadyLoop
	LegacyReadyLoop:
		SPAG A 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
		Loop
    LegacyFire:
        NULL A 0 A_JumpIfInventory("MariaShotgunLoaded", 1, 1)
        Goto LegacyDryFire
        TNT1 A 0 A_PlaySound("Weapon/Shinigami/Dry",0)
	    SPAG A 1 Offset(0,33)
	    SPAG A 1 Offset(0,34)
	    SPAG A 1
	LegacyFireCounted:
        NULL A 0 A_JumpIfInventory("MariaShotgunLoaded", 1, 1)
        Goto LegacyDryFire
        SPAG A 0 A_AlertMonsters
        SPAG A 0 A_GunFlash
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
        SPAF A 0 BRIGHT A_PlayWeaponSound("Weapon/LegacyShotgun/Fire")
		TNT1 A 0 A_PlaySound("Weapon/Shotgun/Distant", 6)
        TNT1 A 0 A_TakeInventory("MariaShotgunLoaded", 1)
        TNT1 B 0 radius_quake (5, 2, 0, 1, 0)
        TNT1 A 0 A_FireCustomMissile("MariaFlareOrange",0,0,0,8)
        TNT1 AAA 0 A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8)
        TNT1 A 0 A_FireBullets(3.6, 3.6, 9, 5, "MariaShotgunPuff")
        SPAF A 1 BRIGHT A_SetPitch(pitch-0.5)
        SPAF B 1 A_SetPitch(pitch-2.5)
        SPAF C 1 A_SetPitch(pitch-1.5)
        SPAF D 1 A_SetPitch(pitch-0.5)
        SPAF EEEF 1
        SPAF GHI 1
        SPAG A 0 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        SPAG A 1 
		TNT1 A 0 A_StartSound("Foley/Shotgun/Movement", CHAN_AUTO)
        SPAG BCDEFGH 1 
        SPAG HI 1
        TNT1 A 0 A_PlaySound("Weapon/LegacyShotgun/Rack/Back", 2)
        SPAG JKLMN 1
        SPAG OPQR 1
        TNT1 A 0 A_PlaySound("Weapon/LegacyShotgun/Rack/Foward",3)
        SPAG IHGF 1
        SPAG E 1
		TNT1 A 0 A_StartSound("Foley/Shotgun/Movement", CHAN_AUTO)
        SPAG D 1
        SPAG CBA 1
        SPAG A 1
        SPAG A 0 A_Refire
        Goto LegacyReadyLoop
	LegacyAltFire:
        //SSGG A 0 A_JumpIfInventory("PowerStrength",1,"BerserkedAlt")
	    SPAG A 1
	    SPAM A 1
        TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
	    SPAM B 1
	    SPAM C 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
	    SPAM D 1 A_PlaySound ("Weapon/NOB/Melee", CHAN_WEAPON, 7, 0, 0, 0.20)
	    SPAM EF 1
	    SPAM G 1 A_FireCustomMissile("MariaShotgunStockPuff",0,0,0,6)
	    SPAM GGHHI 2
	    SPAM JKLM 1
	    SPAM CBA 1
	    SPAG A 1
	    SPAG A 0 A_ReFire	
		Goto LegacyReadyLoop
    LegacyDryFire:
        TNT1 A 0 A_PlaySound("Weapon/Shotgun/Dry",0)
        TNT1 A 0 offset(0,36)
        SPAG A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
        TNT1 A 0 offset(0,35)
        SPAG A 10 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
        Goto LegacyReadyLoop		
    LegacyReload:
        SPAG A 1
        TNT1 A 0 A_JumpIfInventory("MariaShotgunLoaded", 0, "LegacyReadyLoop")
        TNT1 A 0 A_JumpIfInventory("MariaShotgunLoaded", 1, "LegacyReloadNormally")
    LegacyReloadNormally:
        TNT1 A 0 A_JumpIfInventory("Shell", 1, 1)
        Goto LegacyReadyLoop //Abandon reload and return to ready
		TNT1 A 0 A_StartSound("Foley/Shotgun/Reload/Raise", CHAN_AUTO)
        SPAG BCD 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_StartSound("Weapon/LegacyShotgun/Flip", CHAN_AUTO)
        SPAG EF 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        SPAR ABC 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
    LegacyReloadLoop:
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        Goto LegacyReloadAfter
        TNT1 A 0 A_JumpIfInventory("MariaShotgunLoaded", 0, "LegacyReloadAfter")
        TNT1 A 0 A_Giveinventory("MariaShotgunLoaded",1)
        TNT1 A 0 A_Takeinventory("Shell",1)
		SPAR CDEF 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        TNT1 A 0 A_StartSound("Foley/Shotgun/Reload/Load", CHAN_AUTO)
        SPAR F 0 A_PlaySound("Weapon/LegacyShotgun/Insert")
		SPAR GHIJ 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		SPAR CC 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		SPAR CCC 3 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        Goto LegacyReloadLoop
    LegacyReloadAfter:
		TNT1 A 0 A_StartSound("Weapon/LegacyShotgun/Flip", CHAN_AUTO)
        SPAR DCBA 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        SPAG GHI 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        TNT1 A 0 A_PlaySound("Weapon/LegacyShotgun/Rack/Back", 2)
        SPAG JKLMN 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        SPAG OPQR 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        TNT1 A 0 A_PlaySound("Weapon/LegacyShotgun/Rack/Foward",3)
        SPAG IHGF 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        SPAG E 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_StartSound("Foley/Shotgun/Reload/Lower", CHAN_AUTO)
        SPAG DCB 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        SPAG A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        SPAG A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
        Goto LegacyReadyLoop  
    LegacyThrowPipebomb:
        SPAD ABCD 1
        TASQ ABC 1
        TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
        TASG DEH 1
        TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
        TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
        TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
        TASG KLM 1
        TASG OPQR 1 
        TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
        TAHA AB 1
        TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
        TNT1 A 0 A_Jump(256,2)
        TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
        TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
        TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
        TAHA CDE 1
        TNT1 A 5
        SPAS ABCDE 1
        Goto LegacyReadyLoop

	LegacyUseStimShot:
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto LegacyFullHealth
        SPAD ABCDE 1
        SYRI AB 1
        TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
        SYRI CD 1
        SYRI EEFFGGG 1
        SYRI HIJKKLLL 1
        TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
        SYRI MNOPQQQRR 1
        TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
        SYRI STUUUVV 1
        TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
        SYRI WXYZ 1
        SYR2 AB 1
        TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
        TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
        SYR2 CD 1
        TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
        TNT1 A 0 A_SetBlend("BLUE",.5,25)
        TNT1 A 0 HealThing(10, 100)
        TNT1 A 0 A_GiveInventory("SyringeProtection")
        TNT1 A 0 A_GiveInventory("SyringeRegeneration")
        SYR2 EFGHIJ 2
        SYR2 KLLMMN 1
        TNT1 A 5
        SPAS ABCDE 1
	    Goto LegacyReadyLoop
	LegacyFullHealth:
		TNT1 A 0 A_Print("You are healthy.")
		Goto LegacyReadyLoop

	LegacyEquipShield:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("MariaShield",1)
		TNT1 A 0 A_SelectWEapon("MariaShield")
		Goto LegacyDeselect
		
	LegacyPunchFlash:
		SPAK ABC 1
		SPAK D 12
		SPAK CBA 1
		SPAG A 1
		Goto LightDone		
	}
}

ACTOR MariaShotgunLoaded : Ammo
{
    Inventory.Amount 0
    Inventory.MaxAmount 8
    Ammo.BackpackAmount 0
    Ammo.BackpackMaxAmount 8
    Inventory.Icon ""
}