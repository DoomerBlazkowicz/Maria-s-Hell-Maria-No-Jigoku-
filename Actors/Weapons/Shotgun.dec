//==============================================================================
// Big Game 112/Spas 12 (Legacy)
//==============================================================================
// Caliber: 12 Gauge/4 Gauge
//==============================================================================
// Japan LACKED shotgun's, thankfully UAC send shotgun's for Police, JSDF or
// UAC's Japanese Branch. Good for eliminating anyone when they show up,  
// and yes it's a workhorse of killing demons.
//==============================================================================
ACTOR MariaShotgun : MariaWeapon //replaces Shotgun
{
	Weapon.AmmoType1 "MariaShotgunLoaded"
	Weapon.AmmoType2 "Shell"
	Weapon.AmmoGive2 4
	Inventory.PickupMessage "Shotgun Obtained!"
	Inventory.PickupSound "Weapon/Shotgun/Pickup"
	+WEAPON.NOAUTOFIRE
	+WEAPON.NOALERT
	+WEAPON.AMMO_CHECKBOTH
	Tag "Combat Shotgun"
	States
	{
	Spawn:
		SPAP A 0 nodelay A_JumpIf(GetCvar("shotguntoggle")==1, "LegacySpawn")
		REMT A -1
		Stop

	Select:
		TNT1 AA 0 A_Raise
		Loop

	Deselect:
		SPAD A 0 A_JumpIf(GetCvar("shotguntoggle")==1,2)	//(CallACS("ShotgunSkinToggler")==1, "LegacyDeselect")
		REMD A 0
		"####" ABCDE 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1
		Wait

	Ready:
		SPAS A 0 A_JumpIf(GetCvar("shotguntoggle")==1,2)	//(CallACS("ShotgunSkinToggler")==1, "LegacyReady")
		REMS A 0
		"####" A 0 A_PlaySound("Maria/Draw/Primary")
		"####" ABCDE 1
		Goto ReadyLoop

	ReadyLoop:
		SPAG A 0 A_JumpIf(GetCvar("shotguntoggle")==1,2)	//(CallACS("ShotgunSkinToggler")==1, 2)
		REMG A 0
		"####" A 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
		Loop

	Fire:
		NULL A 0 A_JumpIfInventory("MariaShotgunLoaded", 1, 1)
		Goto DryFire
		SPAG A 0 A_JumpIf(GetCvar("shotguntoggle")==1,2)	//(CallACS("ShotgunSkinToggler")==1, 2)
		REMG A 0
		"####" A 0 A_PlaySound("Weapon/Shinigami/Dry",0)
		"####" A 1 Offset(0,33)
		"####" A 1 Offset(0,34)
		"####" A 1
	FireCounted:
		"####" A 0 A_JumpIfInventory("MariaShotgunLoaded", 1, 1)
		Goto DryFire
		"####" A 0 A_AlertMonsters
		"####" A 0 A_GunFlash
		"####" A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		"####" A 0 A_Jump(256,2)
		"####" A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		"####" A 0 A_TakeInventory("MariaShotgunLoaded", 1)
		SPAF A 0 A_JumpIf(GetCvar("shotguntoggle")==1,2)
		REMF A 0
		"####" A 0 BRIGHT 
		{
			if(GetCvar("shotguntoggle")==1)
			{
			A_PlayWeaponSound("Weapon/LegacyShotgun/Fire");
			}
			else 
			{
			A_PlayWeaponSound("Weapon/Shotgun/Fire");
			}
		}
		"####" A 0 A_PlaySound("Weapon/Shotgun/Distant", 6)
		"####" B 0 radius_quake (6, 3, 0, 1, 0)
		"####" A 0 A_FireCustomMissile("MariaFlareOrange",0,0,0,8)
		"####" AAA 0 A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8)
		"####" A 0 A_FireBullets(3.6, 3.6, 9, 5, "MariaShotgunPuff")
		"####" A 1 BRIGHT A_SetPitch(pitch-0.5)
		"####" B 1 A_SetPitch(pitch-2.5)
		"####" C 1 A_SetPitch(pitch-1.5)
		"####" D 1 A_SetPitch(pitch-0.5)
		"####" DEEF 1
		"####" GHI 1
		SPAG A 0 A_JumpIf(GetCvar("shotguntoggle")==1,2)	//(CallACS("ShotgunSkinToggler")==1, 2)
		REMG A 0
		"####" B 0 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 1
		"####" B 1 { A_StartSound("Foley/Shotgun/Movement", CHAN_AUTO); }
		"####" CDEFG 1
		"####" A 0 
		"####" G 1
		{
		if(GetCvar("shotguntoggle")==1)
			{
			A_PlaySound("Weapon/LegacyShotgun/Rack/Back", 2);
			}
			else 
			{
			A_PlaySound("Weapon/Shotgun/Rack/Back",2);
			}
		}
		"####" HIJ 1
		"####" A 0 A_SpawnItemEx("ShotgunCasingBuckshot", 14, -2, 35, 0, random(2,4), random(2,4))
		"####" KLMN 1
		"####" O 1 
		{
		if(GetCvar("shotguntoggle")==1)
			{
			A_PlaySound("Weapon/LegacyShotgun/Rack/Foward",3);
			}
			else 
			{
			A_PlaySound("Weapon/Shotgun/Rack/Foward",3);
			}
		}
		"####" PQR 1
		"####" E 1
		"####" A 0 A_StartSound("Foley/Shotgun/Movement", CHAN_AUTO)
		"####" D 1
		"####" CBA 1
		"####" A 1
		"####" A 0 A_Refire
		Goto ReadyLoop

	AltFire:
		SPAM A 0 A_JumpIf(GetCvar("shotguntoggle")==1,2)	//(CallACS("ShotgunSkinToggler")==1, "LegacyAltFire")
		REMM A 0
		"####" A 1
		"####" A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		"####" B 1
		"####" C 1
		"####" A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		"####" A 0 A_Jump(256,2)
		"####" A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		"####" D 1 A_PlaySound ("Weapon/NOB/Melee", CHAN_WEAPON, 7, 0, 0, 0.20)
		"####" EF 1
		"####" G 1 A_FireCustomMissile("MariaShotgunStockPuff",0,0,0,6)
		"####" GGHHI 2
		"####" JKLM 1
		"####" CBA 1
		REMG A 0 A_ReFire
		Goto ReadyLoop

	DryFire:
		"####" A 0 A_PlaySound("Weapon/Shotgun/Dry",0)
		"####" A 0 offset(0,36)
		"####" A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		"####" A 0 offset(0,35)
		"####" A 10 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		Goto ReadyLoop

	Reload:
		"####" A 1
		"####" A 0 A_JumpIfInventory("MariaShotgunLoaded", 0, "ReadyLoop")
		"####" A 0 A_JumpIfInventory("MariaShotgunLoaded", 1, "ReloadNormally")
	ReloadNormally:
		"####" A 0 A_JumpIfInventory("Shell", 1, 1)
		Goto ReadyLoop //Abandon reload and return to ready
		"####" B 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_StartSound("Weapon/LegacyShotgun/Flip", CHAN_AUTO)
		"####" CD 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_StartSound("Foley/Shotgun/Reload/Raise", CHAN_AUTO)
		"####" EF 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		SPAR A 0 A_JumpIf(GetCvar("shotguntoggle")==1,2)
		REMR A 0
		"####" ABC 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	ReloadLoop:
		"####" A 0 A_JumpIfInventory("Shell",1,1)
		Goto ReloadAfter
		"####" A 0 A_JumpIfInventory("MariaShotgunLoaded", 0, "ReloadAfter")
		"####" A 0 A_Giveinventory("MariaShotgunLoaded",1)
		"####" A 0 A_Takeinventory("Shell",1,TIF_NOTAKEINFINITE)
		"####" DE 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" F 0 
		"####" F 1
		{
		A_WeaponReady(WRF_NOFIRE|WRF_NOBOB);
		A_StartSound("Foley/Shotgun/Reload/Load", CHAN_AUTO);
		if(getcvar("shotguntoggle")==1)
			{
				A_PlaySound("Weapon/LegacyShotgun/Insert");
			}
			else 
			{
			A_PlaySound("Weapon/Shotgun/Insert");
			}
		}
		"####" GHIJ 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" CC 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" CCC 3 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		Goto ReloadLoop

	ReloadAfter:
		"####" CBA 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		SPAG A 0 A_JumpIf(GetCvar("shotguntoggle")==1,2)
		REMG A 0
		"####" FG 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" H 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 
		"####" I 1
		{
		A_WeaponReady(WRF_NOFIRE|WRF_NOBOB);
		if(GetCvar("shotguntoggle")==1)
		{
			A_PlaySound("Weapon/LegacyShotgun/Rack/Back", 2);
			}
			else 
			{
			A_PlaySound("Weapon/Shotgun/Rack/Back",2);
			}
		}
		"####" JKLMN 1 
		"####" OPQR 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" E 1 
		{
		A_WeaponReady(WRF_NOFIRE|WRF_NOBOB);
		if(GetCvar("shotguntoggle")==1)
		{
			A_PlaySound("Weapon/LegacyShotgun/Rack/Foward",3);
			}
			else 
			{
			A_PlaySound("Weapon/Shotgun/Rack/Foward",3);
			}
		}
		"####" A 0 A_StartSound("Foley/Shotgun/Reload/Lower", CHAN_AUTO)
		"####" D 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" CBA 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		Goto ReadyLoop

	Flash:
		TNT1 A 2 BRIGHT A_Light2
		TNT1 A 2 BRIGHT A_Light1
		TNT1 A 0 A_Light0
		Stop

	ThrowPipebomb:
		SPAD A 0 A_JumpIf(GetCvar("shotguntoggle")==1,2)
		REMD A 0
		"####" ABCDE 1
		TASQ ABC 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TASG DEH 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
		TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
		TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
		TASG KLM 1
		TASG OPQR 1 
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TAHA AB 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
		TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
		TAHA CDE 1
		TNT1 A 5
		SPAS A 0 A_JumpIf(GetCvar("shotguntoggle")==1,2)	//(CallACS("ShotgunSkinToggler")==1, "LegacyDeselect")
		REMS A 0
		"####" ABCDE 1
		Goto ReadyLoop

	UseStimShot:
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealth
		SPAD A 0 A_JumpIf(GetCvar("shotguntoggle")==1,2)
		REMD A 0
		"####" ABCDE 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		SPAS A 0 A_JumpIf(GetCvar("shotguntoggle")==1,2)	//(CallACS("ShotgunSkinToggler")==1, "LegacyDeselect")
		REMS A 0
		"####" ABCDE 1
		Goto ReadyLoop

	User3:
	EquipShield:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("MariaShield",1)
		TNT1 A 0 A_SelectWEapon("MariaShield")
		Goto Deselect

	PunchFlash:
		SPAK A 0 A_JumpIf(GetCvar("shotguntoggle")==1,2)	//(CallACS("ShotgunSkinToggler")==1, "LegacyPunchFlash")
		REMK A 0
		"####" ABC 1
		"####" D 12
		"####" CBA 1
		Stop

////////////////////////////////
//Legacy Pump Action (Spas 12)//
////////////////////////////////
//==============================================================================
// Spas 12
//==============================================================================
// Caliber: 12 Gauge
//==============================================================================
// Japan LACKED shotgun's, thankfully UAC send shotgun's for Police, JSDF or
// UAC's Japanese Branch. Good for eliminating anyone when they show up,  
// and yes it's a workhorse of killing demons.
//==============================================================================

	LegacySpawn:
		SPAP A -1
		Stop
	/*LegacyDeselect:
	 	SPAD ABCDE 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1
		Loop
	LegacyReady:
		TNT1 A 0 A_PlaySound("Maria/Draw/Primary")
		SPAS ABCDE 1
		Goto LegacyReadyLoop
	LegacyReadyLoop:
		SPAG A 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
		Loop
	LegacyFire:
		NULL A 0 A_JumpIfInventory("MariaShotgunLoaded", 1, 1)
		Goto LegacyDryFire
		TNT1 A 0 A_PlaySound("Weapon/Shinigami/Dry",0)
		SPAG A 1 Offset(0,33)
		SPAG A 1 Offset(0,34)
		SPAG A 1
	LegacyFireCounted:
		NULL A 0 A_JumpIfInventory("MariaShotgunLoaded", 1, 1)
		Goto LegacyDryFire
		SPAG A 0 A_AlertMonsters
		SPAG A 0 A_GunFlash
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		SPAF A 0 BRIGHT A_PlayWeaponSound("Weapon/LegacyShotgun/Fire")
		TNT1 A 0 A_PlaySound("Weapon/Shotgun/Distant", 6)
		TNT1 A 0 A_TakeInventory("MariaShotgunLoaded", 1)
		TNT1 B 0 radius_quake (5, 2, 0, 1, 0)
		TNT1 A 0 A_FireCustomMissile("MariaFlareOrange",0,0,0,8)
		TNT1 AAA 0 A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8)
		TNT1 A 0 A_FireBullets(3.6, 3.6, 9, 5, "MariaShotgunPuff")
		SPAF A 1 BRIGHT A_SetPitch(pitch-0.5)
		SPAF B 1 A_SetPitch(pitch-2.5)
		SPAF C 1 A_SetPitch(pitch-1.5)
		SPAF D 1 A_SetPitch(pitch-0.5)
		SPAF EEEF 1
		SPAF GHI 1
		SPAG A 0 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		SPAG A 1 
		TNT1 A 0 A_StartSound("Foley/Shotgun/Movement", CHAN_AUTO)
		SPAG BCDEFGH 1 
		SPAG HI 1
		TNT1 A 
		SPAG JKLMN 1
		SPAG OPQR 1
		TNT1 A 0 A_PlaySound("Weapon/LegacyShotgun/Rack/Foward",3)
		SPAG IHGF 1
		SPAG E 1
		TNT1 A 0 A_StartSound("Foley/Shotgun/Movement", CHAN_AUTO)
		SPAG D 1
		SPAG CBA 1
		SPAG A 1
		SPAG A 0 A_Refire
		Goto LegacyReadyLoop
	LegacyAltFire:
		//SSGG A 0 A_JumpIfInventory("PowerStrength",1,"BerserkedAlt")
		SPAG A 1
		SPAM A 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SPAM B 1
		SPAM C 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		SPAM D 1 A_PlaySound ("Weapon/NOB/Melee", CHAN_WEAPON, 7, 0, 0, 0.20)
		SPAM EF 1
		SPAM G 1 A_FireCustomMissile("MariaShotgunStockPuff",0,0,0,6)
		SPAM GGHHI 2
		SPAM JKLM 1
		SPAM CBA 1
		SPAG A 1
		SPAG A 0 A_ReFire	
		Goto LegacyReadyLoop
	LegacyDryFire:
		TNT1 A 0 A_PlaySound("Weapon/Shotgun/Dry",0)
		TNT1 A 0 offset(0,36)
		SPAG A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 0 offset(0,35)
		SPAG A 10 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		Goto LegacyReadyLoop		
	LegacyReload:
		SPAG A 1
		TNT1 A 0 A_JumpIfInventory("MariaShotgunLoaded", 0, "LegacyReadyLoop")
		TNT1 A 0 A_JumpIfInventory("MariaShotgunLoaded", 1, "LegacyReloadNormally")
	LegacyReloadNormally:
		TNT1 A 0 A_JumpIfInventory("Shell", 1, 1)
		Goto LegacyReadyLoop //Abandon reload and return to ready
		TNT1 A 0 A_StartSound("Foley/Shotgun/Reload/Raise", CHAN_AUTO)
		SPAG BCD 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_StartSound("Weapon/LegacyShotgun/Flip", CHAN_AUTO)
		SPAG EF 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		SPAR ABC 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LegacyReloadLoop:
		TNT1 A 0 A_JumpIfInventory("Shell",1,1)
		Goto LegacyReloadAfter
		TNT1 A 0 A_JumpIfInventory("MariaShotgunLoaded", 0, "LegacyReloadAfter")
		TNT1 A 0 A_Giveinventory("MariaShotgunLoaded",1)
		TNT1 A 0 A_Takeinventory("Shell",1)
		SPAR CDEF 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_StartSound("Foley/Shotgun/Reload/Load", CHAN_AUTO)
		SPAR F 0 A_PlaySound("Weapon/LegacyShotgun/Insert")
		SPAR GHIJ 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		SPAR CC 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		SPAR CCC 3 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		Goto LegacyReloadLoop
	LegacyReloadAfter:
		TNT1 A 0 A_StartSound("Weapon/LegacyShotgun/Flip", CHAN_AUTO)
		SPAR DCBA 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		SPAG GHI 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_PlaySound("Weapon/LegacyShotgun/Rack/Back", 2)
		SPAG JKLMN 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		SPAG OPQR 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_PlaySound("Weapon/LegacyShotgun/Rack/Foward",3)
		SPAG IHGF 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		SPAG E 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_StartSound("Foley/Shotgun/Reload/Lower", CHAN_AUTO)
		SPAG DCB 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		SPAG A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		SPAG A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		Goto LegacyReadyLoop  
	LegacyThrowPipebomb:
		SPAD ABCD 1
		TASQ ABC 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TASG DEH 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
		TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
		TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
		TASG KLM 1
		TASG OPQR 1 
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TAHA AB 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
		TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
		TAHA CDE 1
		TNT1 A 5
		SPAS ABCDE 1
		Goto LegacyReadyLoop

	LegacyUseStimShot:
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto LegacyFullHealth
		SPAD ABCDE 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
