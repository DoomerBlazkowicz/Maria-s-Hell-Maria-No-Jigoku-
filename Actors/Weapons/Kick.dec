Actor MariaKickItem : CustomInventory
{
	+UNDROPPABLE
	+UNTOSSABLE
	States
	{
	Use:
		TNT1 A 0 A_Overlay(-999, "Kick", true) //GZDoom only, I wish Zandronum added support for A_Overlay
		TNT1 A 0 A_OverlayOffset(-999, 0, 32) //So the offsets won't be messed up
		Fail //So you can use this item multiple times!
	Kick:
        TNT1 A 0 A_JumpIf(CallACS("KickSkinToggler")==1, "BootKick")
		TNT1 A 0 A_GiveInventory("CantSlide",1)
		TNT1 A 0 A_OverlayFlags(-999,PSPF_PLAYERTRANSLATED,true)
		TNT1 A 0 A_PlaySoundEx("Kick/Miss",CHAN_7)
		TNT1 A 0 A_JumpIfInventory("PowerStrength",1,"KickBerserk")
		TNT1 A 0 A_JumpIf(momZ > 0, "AirKick")
		TNT1 A 0 A_JumpIf(momZ < 0, "AirKick")
		TNT1 A 0 A_SetSpeed(0.25)
		HEEK ABC 1
		HEEK D 3 A_FireCustomMissile("MariaKick1",0,0) //[bool useammo] has to be 0 to prevent this item from chewing ammo of the gun you're holding
		HEEK ECBA 2
		TNT1 A 0 A_TakeInventory("CantSlide",1)
		TNT1 A 0 A_SetSpeed(1.0)
		TNT1 A 1
		Stop

	GoToFail:
		TNT1 A 0
		Fail

	KickBerserk:
        TNT1 A 0 A_JumpIf(CallACS("KickSkinToggler")==1, "BootKickBerserk")
		TNT1 A 0 A_JumpIf(momZ > 0, "AirKickBerserk")
		TNT1 A 0 A_JumpIf(momZ < 0, "AirKickBerserk")
		TNT1 A 0 A_SetSpeed(0.25)
		HEEK ABC 1
		HEEK D 3 A_FireCustomMissile("MariaKick2",0,0)
		HEEK ECBA 2
		TNT1 A 0 A_TakeInventory("CantSlide",1)
		TNT1 A 0 A_SetSpeed(1.0)
		TNT1 A 1
		Stop

	AirKick:
        TNT1 A 0 A_JumpIf(CallACS("KickSkinToggler")==1, "BootAirKick")
		TNT1 A 0 A_Recoil(-5)
		JEEK ABC 1
		JEEK D 3 A_FireCustomMissile("MariaKick1",0,0)
		JEEK ECBA 2
		TNT1 A 0 A_TakeInventory("CantSlide",1)
		TNT1 A 1
		Stop

	AirKickBerserk:
        TNT1 A 0 A_JumpIf(CallACS("KickSkinToggler")==1, "BootAirKickBerserk")
		TNT1 A 0 A_Recoil(-5)
		JEEK ABC 1
		JEEK D 3 A_FireCustomMissile("MariaKick2",0,0)
		JEEK ECBA 2
		TNT1 A 0 A_TakeInventory("CantSlide",1)
		TNT1 A 1
		Stop

// Huntress/Boots

	BootKick:
		TNT1 A 0 A_GiveInventory("CantSlide",1)
		TNT1 A 0 A_OverlayFlags(-999,PSPF_PLAYERTRANSLATED,true)
		TNT1 A 0 A_PlaySoundEx("Kick/Miss",CHAN_7)
		TNT1 A 0 A_JumpIfInventory("PowerStrength",1,"BootKickBerserk")
		TNT1 A 0 A_JumpIf(momZ > 0, "AirKick")
		TNT1 A 0 A_JumpIf(momZ < 0, "AirKick")
		TNT1 A 0 A_SetSpeed(0.25)
		BOOT ABC 1
		BOOT D 3 A_FireCustomMissile("MariaKick1",0,0) //[bool useammo] has to be 0 to prevent this item from chewing ammo of the gun you're holding
		BOOT ECBA 2
		TNT1 A 0 A_TakeInventory("CantSlide",1)
		TNT1 A 0 A_SetSpeed(1.0)
		TNT1 A 1
		Stop

	BootKickBerserk:
		TNT1 A 0 A_JumpIf(momZ > 0, "BootAirKickBerserk")
		TNT1 A 0 A_JumpIf(momZ < 0, "BootAirKickBerserk")
		TNT1 A 0 A_SetSpeed(0.25)
		BOOT ABC 1
		BOOT D 3 A_FireCustomMissile("MariaKick2",0,0)
		BOOT ECBA 2
		TNT1 A 0 A_TakeInventory("CantSlide",1)
		TNT1 A 0 A_SetSpeed(1.0)
		TNT1 A 1
		Stop

	BootAirKick:
		TNT1 A 0 A_Recoil(-5)
		JOOT ABC 1
		JOOT D 3 A_FireCustomMissile("MariaKick1",0,0)
		JOOT ECBA 2
		TNT1 A 0 A_TakeInventory("CantSlide",1)
		TNT1 A 1
		Stop

	BootAirKickBerserk:
		TNT1 A 0 A_Recoil(-5)
		JOOT ABC 1
		JOOT D 3 A_FireCustomMissile("MariaKick2",0,0)
		JOOT ECBA 2
		TNT1 A 0 A_TakeInventory("CantSlide",1)
		TNT1 A 1
		Stop
	}
}

Actor MariaSlideItem : CustomInventory
{
	+UNDROPPABLE
	+UNTOSSABLE
	States
	{
	Use:
		TNT1 A 0 A_JumpIfInventory("NoSliding",1,"UseFail2")
		TNT1 A 0 A_JumpIfInventory("CantSlide",1,"UseFail2")
		TNT1 A 0 A_JumpIf (z-floorz > 1 , "UseFail")
		TNT1 A 0 A_Overlay(-2, "Slide", true)
		TNT1 A 0 A_OverlayOffset(-2, 0, 32)
		Fail //So you can use this item multiple times!
	Slide:
	ContinueSliding:
        TNT1 A 0 
		TNT1 A 0 A_GiveInventory("CantKick",1)
		Tnt1 a 0 ACS_NamedExecute("CameraDown")
        TNT1 A 0 A_SetSize(-1,28,FALSE)
        TNT1 A 0 A_Recoil (-6)
        TNT1 A 0 A_PlaySound("SlideKickStart", 0)
		TNT1 A 0 A_SetSpeed(0.1)
        TNT1 A 0
        SEEK ABC 1 
        TNT1 A 0 A_SetPItch(10)
        //TNT1 A 0 A_JumpIfInventory("PowerStrength",1,"BrutalSlide")
        TNT1 A 0 A_FireCustomMissile("MariaKick1", 0, 0, 0, 10)
        SEEK D 1
        TNT1 A 0 A_Recoil (-2)
        TNT1 A 0 A_SetPItch(10)
        SEEK D 1 A_FireCustomMissile("MariaKick1", 0, 0, 0, 10)
        TNT1 A 0 A_Recoil (-2)
        TNT1 A 0 A_SetPItch(10)
        SEEK D 1 A_FireCustomMissile("MariaKick1", 0, 0, 0, 10)
        TNT1 A 0 A_Recoil (-2)
        TNT1 A 0 A_SetPItch(10)
        SEEK D 1 A_FireCustomMissile("MariaKick1", 0, 0, 0, 10)
        TNT1 A 0 A_Recoil (-2)
        TNT1 A 0 A_SetPItch(10)
        SEEK D 1 A_FireCustomMissile("MariaKick1", 0, 0, 0, 10)
        TNT1 A 0 A_Recoil (-2)
        TNT1 A 0 A_SetPItch(10)
        SEEK D 1 A_FireCustomMissile("MariaKick1", 0, 0, 0, 10)
        TNT1 A 0 A_Recoil (-2)
        TNT1 A 0 A_SetPItch(10)
        SEEK D 1 A_FireCustomMissile("MariaKick1", 0, 0, 0, 10)
        TNT1 A 0 A_Recoil (-2)
        TNT1 A 0 A_SetPItch(10)
        SEEK D 1 A_FireCustomMissile("MariaKick1", 0, 0, 0, 10)
        TNT1 A 0 A_Recoil (-2)
        TNT1 A 0 A_SetPItch(10)
        SEEK D 1 A_FireCustomMissile("MariaKick1", 0, 0, 0, 10)
        TNT1 A 0 A_Recoil (-2)
        TNT1 A 0 A_SetPItch(10)
        SEEK D 1 A_FireCustomMissile("MariaKick1", 0, 0, 0, 10)
        TNT1 A 0 A_Recoil (-2)
        TNT1 A 0 A_SetPItch(10)
        SEEK D 1 A_FireCustomMissile("MariaKick1", 0, 0, 0, 10)
        TNT1 A 0 A_Recoil (-2)
        TNT1 A 0 A_SetPItch(10)
        SEEK D 1 A_FireCustomMissile("MariaKick1", 0, 0, 0, 10)
        TNT1 A 0 A_Recoil (-2)
        TNT1 A 0 A_SetPItch(10)
        SEEK D 1 A_FireCustomMissile("MariaKick1", 0, 0, 0, 10)
        TNT1 A 0 A_Recoil (-2)
        TNT1 A 0 A_SetPItch(10)
        TNT1 A 0 A_PlaySound("SlideKickStop", 0)
		TNT1 A 0 A_SetSpeed(1.0)
        SEEK CBA 1
        Tnt1 a 0 ACS_NamedExecute("CameraUp")
        TNT1 A 0 A_JumpIf (z-ceilingz < -55 , "Finish")
        TNT1 A 0 A_TakeInventory("CantKick",1)
		Stop

	Finish:
		TNT1 A 0 
		TNT1 A 0 A_SetPItch(0)
		TNT1 A 0 A_SetSize(-1,56,False) 
		TNT1 A 0 A_Takeinventory("CantKick",1)
		Stop
		
	UseFail:
		TNT1 A 0 
		STOP

	UseFail2:
		TNT1 A 0
		Fail
	}
}