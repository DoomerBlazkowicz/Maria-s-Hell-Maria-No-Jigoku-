//==============================================================================
// Daewoo Usas-12
//==============================================================================
// Caliber: 12 Gauge
//==============================================================================
//
// 
// 
//
// 
//==============================================================================
ACTOR MariaUsas : MariaWeapon
{
	Weapon.AmmoType1 "MariaUsasLoaded"
	Weapon.AmmoGive2 10
	Weapon.AmmoType2 "Shell"
	Inventory.PickupSound "misc/w_pkup"
	Inventory.PickupMessage "Usas-12 Automatic Shotgun Obtained!!"
	Obituary "%o was blown away by %k's Usas12 shotgun."
	Tag "Automatic Shotgun"
	+CHEATNOTWEAPON 
	+WEAPON.AMMO_CHECKBOTH
	+WEAPON.NOAUTOFIRE
	States
	{
	Deselect:
		TNT1 A 0 A_SetSpeed(1.0)
		USAD ABCDE 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1
		Wait

	Select:
		TNT1 AA 0 A_Raise
		Loop

	Ready:
		TNT1 A 0 A_PlaySound("Maria/Draw/Primary")
		USAS ABC 1
		TNT1 A 0 A_SetSpeed(0.75)
		USAS DE 1
		Goto ReadyLoop

	ReadyLoop:
		USAG A 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD|WRF_ALLOWUSER1|WRF_ALLOWUSER2)
		Loop

	Fire:
		"####" "#" 0 A_JumpIf(CountInv("MariaUsasLoaded") < 1, "DryFire")
		USAG A 1 Offset(0,33)
		TNT1 A 0 A_PlaySound("Weapon/Shinigami/Dry",0)
		USAG A 1 Offset(0,34)
		USAG AAAA 1
	FireCounted:
		"####" "#" 0 
		{
		If(CountInv("MariaUsasLoaded") < 1) { return state("DryFire"); }
		If(GetCvar("magclicking") == 0 && CountInv("MariaUsasLoaded") < 9) { A_PlaySound("Weapon/Magclick", 1); }
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlayWeaponSound("Weapon/Usas/Fire");
		A_PlaySound("Weapon/Shotgun/Distant", 6);
		A_AlertMonsters;
		A_TakeInventory("MariaUsasLoaded", 1);
		A_FireBullets (5.5, 5.5, 8, 6, "MariaShotgunPuff");
		A_FireCustomMissile("MariaFlareOrange",0,0,0,8);
		return state("");
		}
		USAF B 0 
		{
		A_SpawnItemEx("ShotgunCasingBuckshot", 17, 3, 35, 0, random(3,6), random(3,7));
		radius_quake (5, 2, 0, 1, 0);
		A_GunFlash;
		}
		USAF A 1 Bright A_SetPitch(pitch-0.5)
		USAF B 1 A_SetPitch(pitch-2.5)
		USAF C 1 A_SetPitch(pitch-1.5)
		USAF D 1 A_SetPitch(pitch-0.5)
		USAF EFGH 1 
		USAG A 1
		USAG A 0 A_ReFire("FireCounted")
		Goto ReadyLoop

	AltFire:
		NULL A 0 A_JumpIf(CountInv("MariaUsasLoaded") < 2, "DryFire")
		USAG A 1 Offset(0,33)
		TNT1 A 0 A_PlaySound("Weapon/Shinigami/Dry",0)
		USAG A 1 Offset(0,34)
		USAG AAAA 1
	AltFireCounted:
		NULL A 0 
		{
		If(CountInv("MariaUsasLoaded") < 2) { return state("DryFire"); }
		If(GetCvar("magclicking") == 0 && CountInv("MariaUsasLoaded") < 9) { A_PlaySound("Weapon/Magclick", 1); }
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); } 
		A_PlayWeaponSound("Weapon/Usas/Fire");
		A_PlaySound("Weapon/Shotgun/Distant", 6);
		A_AlertMonsters;
		A_TakeInventory("MariaUsasLoaded", 2);
		return state("");
		}
		TNT1 AAAAAAAAAA 0 A_FireCustomMissile("MariaDragonsBreathTracer",frandom(-4.0,4.0),0,0,0,0,frandom(-3,3))
		USAF B 0 
		{
		A_SpawnItemEx("ShotgunCasingBuckshot", 17, 3, 35, 0, random(3,6), random(3,7));
		radius_quake (5, 2, 0, 1, 0);
		}
		USAF A 1 Bright A_SetPitch(pitch-0.5)
		USAF B 1 A_SetPitch(pitch-2.5)
		USAF C 1 A_SetPitch(pitch-1.5)
		USAF D 1 A_SetPitch(pitch-0.5)
		USAF EFGH 1 
		USAG A 2 
		USAG A 0 A_ReFire
		Goto ReadyLoop

	Flash:
		TNT1 A 4 Bright A_Light1
		TNT1 A 3 Bright A_Light2
		Goto LightDone

	DryFire:
		TNT1 A 0 A_PlaySound("Weapon/Shotgun/Dry",0)
		USAG A 1 { A_WeaponOffset(0,36); A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH); }
		USAG A 1 { A_WeaponOffset(0,35); A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH); }
		Goto ReadyLoop

	Reload:
		TNT1 A 0 A_JumpIfInventory("MariaUsasLoaded", 0, 2)
		TNT1 A 0 A_JumpIfInventory("Shell", 1, "ReloadWork")
		USAG A 2 A_WeaponReady(WRF_NOFIRE)
		Goto ReadyLoop

	ReloadWork:
		USAG A 2
		TNT1 A 0 A_StartSound("Foley/Rifle/Misc", CHAN_AUTO)
		USAR ABCDEF 2
		USAR A 0 A_PlaySound ("Weapon/Usas/Reload/Out", CHAN_AUTO)
		TNT1 A 0 A_FireCustomMissile("EmptyASGAmmo",-5,0,0,-6) 
		USAR GHHH 2
		USAR IJ 2
		TNT1 A 0 A_StartSound("Foley/Rifle/Misc", CHAN_AUTO)
		USAR KLMN 2
		USAR OPQRST 2
		USAR U 2
		TNT1 A 0 A_PlaySound ("Weapon/Usas/Reload/In", CHAN_AUTO)
		USAR VWX 3
		TNT1 A 0 
		{
		A_StartSound("Foley/Rifle/Misc", CHAN_AUTO);
		If(CountInv("MariaUsasLoaded") < 1) { return state("ReloadingLoop"); }
		return state("ReloadingLoop2");
		}

	ReloadingLoop:
		TNT1 A 0 A_TakeInventory("Shell", 1)
		TNT1 A 0 A_GiveInventory("MariaUsasLoaded", 1)
		TNT1 A 0 A_JumpIfInventory("MariaUsasLoaded", 20, "FinishReload")
		TNT1 A 0 A_JumpIfInventory("Shell", 1, "ReloadingLoop")
		Goto FinishReload

	FinishReload:
		USAR YZ 2
		US2R AB 2
		USAR E 0 A_PlaySound ("Weapon/Usas/Reload/Bolt/Pull", 1) 
		US2R CDE 2
		USAR E 0 A_PlaySound ("Weapon/Usas/Reload/Bolt/Release", 2)
		TNT1 A 0 A_StartSound("Foley/Rifle/Misc", CHAN_AUTO)
		US2R FGHIJK 2
		US2R LMNOP 2
		USAG A 2
		Goto ReadyLoop

	ReloadingLoop2:
		TNT1 A 0 A_TakeInventory("Shell", 1)
		TNT1 A 0 A_GiveInventory("MariaUsasLoaded", 1)
		TNT1 A 0 A_JumpIfInventory("MariaUsasLoaded", 0, "FinishReload2")
		TNT1 A 0 A_JumpIfInventory("Shell", 1, "ReloadingLoop2")
		Goto FinishReload2

	FinishReload2:
		USAR YZ 2
		TNT1 A 0 A_StartSound("Foley/Rifle/Misc", CHAN_AUTO)
		US2R GHIJK 2
		US2R LMNOP 2
		USAG A 2
		Goto ReadyLoop

	ThrowPipebomb:
		USAD ABCDE 1
		TASQ ABCDE 1
		TASG H 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
		TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
		TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
		TASG KLM 1
		TASG OPQR 1 
		TAHA AB 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
		TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
		TAHA CDE 1
		TNT1 A 5
		USAS ABCDE 1
		Goto ReadyLoop

	UseStimShot:
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealth
		USAD ABCDE 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		USAS ABCDE 1
		Goto ReadyLoop

	User3:
	EquipShield:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("MariaShield",1)
		TNT1 A 0 A_SelectWEapon("MariaShield")
		Goto Deselect

	PunchFlash:
		USAK ABC 1
		USAK D 12
		USAK CBA 1
		USAG A 1
		Goto LightDone

	Spawn:
		USAP A -1
		Stop
	}
}

ACTOR MariaUsasLoaded : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 21 //20+1
	Inventory.Icon ""
}