//==============================================================================
ACTOR MariaSniperRifle : MariaWeapon
{
	Inventory.PickupMessage "Sniper Rifle Obtained! Hello Gorgeous."
	Weapon.AmmoGive2 10
	Weapon.AmmoType1 "MariaSniperLoaded"
	Weapon.AmmoType2 "MariaHeavyClip" 
	Inventory.PickupSound "misc/w_pkup"
	Weapon.KickBack 20
	Tag "Sniper Rifle"
	+WEAPON.CHEATNOTWEAPON
	+FLOORCLIP
	+WEAPON.NOAUTOFIRE
	+WEAPON.AMMO_CHECKBOTH
	States
	{
	Spawn:
		SNPP A -1
		Stop

	Ready:
		TNT1 A 0 A_PlaySound("Maria/Draw/Primary")
		SNPS ABCDE 1
		Goto ReadyLoop

	ReadyLoop:
		TNT1 A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		SNPG A 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD|WRF_ALLOWUSER1|WRF_ALLOWUSER2)
		Loop

	Ready2:
		SNP2 A 2 A_WeaponReady (WRF_NOBOB)
		SNP2 A 0 A_SetPitch(pitch-frandom(-0.18,0.18))
		SNP2 A 2 A_WeaponReady (WRF_NOBOB)
		SNP2 A 0 A_SetPitch(pitch-frandom(-0.18,0.18))
		Loop

	Deselect:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_Takeinventory("Zoomed",0)
		SNPD ABCDE 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1
		Wait

	Select:
		TNT1 AA 0 A_Raise
		Loop

	Fire:
		NULL A 0 
		{
		If(CountInv("MariaSniperLoaded") < 1) { return state("dryfire"); }
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlaySound("Weapon/Sniper/Fire", CHAN_AUTO);
		A_PlaySound("Weapon/Sniper/Distant", 6);
		A_TakeInventory("MariaSniperLoaded", 1);
		A_AlertMonsters;
		If(CountInv("Zoomed") == 1) { return state("FireZoomed"); }
		return state("");
		}
		SNPF A 1 Bright 
		{
		A_FireBullets (7.5, 7.5, -1, 95, "MariaPuff");
		A_FireCustomMissile("MariaFlareOrange",0,0,0,8);
		radius_quake (1.5, 2, 0, 1, 0);
		}
		SNPF B 1 A_SetPitch(pitch - 5)
		SNPF C 1 A_SetPitch(pitch - 4)
		SNPF D 1 A_SetPitch(pitch - 3) //15
		SNPF E 1 A_SetPitch(pitch - 2)
		SNPF E 1 A_SetPitch(pitch - 1)
		SNPF EFF 1 
		SNPF GHIJ 1
		MBOW B 0 //A_CheckReload
		SNPG A 3 //A_ReFire
		SNPB ABC 1   
		TNT1 A 0 A_StartSound("Foley/Rifle/Misc", CHAN_AUTO)
		SNPB DEFGHHII 1
		TNT1 A 0 A_PlaySound("Weapon/Sniper/Bolt/Back",1)
		TNT1 A 0 A_SpawnItemEx("SniperCasingSpawner", 14, -2, 35, 0, random(2,4), random(2,4))
		SNPB JKLLLM 2
		TNT1 A 0 A_PlaySound("Weapon/Sniper/Bolt/Foward",2)
		TNT1 A 0 A_StartSound("Foley/Rifle/Misc", CHAN_AUTO)
		SNPB NOPQRSSTTUU 1
		SNPG A 1
		REMG A 0 A_Refire
		Goto ReadyLoop

	AltFire:
		TNT1 A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		TNT1 A 0 A_Giveinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(4.0)
		SNPZ A 0 A_SetBlend("Black",0.1,3)
		SNPZ A 0 A_PlaySound("Foley/Sleeves/Movement", CHAN_AUTO)
		SNPZ ABC 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		SNP2 A 3 A_PlaySound("Maria/Zoom/In",CHAN_BODY)
		SNP2 A 1 /*Bright*/ A_SetBlend("Black",0.4,3)
		SNP2 A 1 /*Bright*/ A_SetBlend("Black",0.6,3)
		SNP2 A 1 /*Bright*/ A_SetBlend("Black",0.8,3)
		SNP2 A 1 /*Bright*/ A_SetBlend("Black",1.0,6)
		SNP2 A 3
		Goto Ready2

	NoAim: 
		SNP2 A 3 A_PlaySound("Maria/Zoom/Out",CHAN_BODY)
		TNT1 A 0 A_Takeinventory("Zoomed",0)
		SNP2 A 1 A_SetBlend("Black",0.2,3)
		SNP2 A 1 A_SetBlend("Black",0.4,3)
		SNP2 A 1 A_SetBlend("Black",0.6,3)
		SNP2 A 1 A_SetBlend("Black",0.8,3)
		SNP2 A 1 A_SetBlend("Black",1.0,6)
		TNT1 A 0 A_ZoomFactor(1.0)
		SNPZ A 0 A_PlaySound("Foley/Sleeves/Movement", CHAN_AUTO)
		SNPZ CBA 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		SNPG A 3 
		Goto ReadyLoop

	FireZoomed:
		SNP2 A 0 Bright 
		{
		A_FireBullets (1, 1, 0, 95, "MariaPuff");
		A_FireCustomMissile("MariaFlareOrange",0,0,0,8);
		}
		SNP2 A 1 A_SetPitch(pitch - 3)
		SNP2 A 1 A_SetPitch(pitch - 2)
		SNP2 A 1 A_SetPitch(pitch - 1)
		SNP2 A 1 A_SetPitch(pitch - 0)
		SNP2 A 1 A_SetPitch(pitch - 0)
		SNP2 A 8 
		SNP2 A 0 //A_CheckReload
		SNP2 A 2 //A_ReFire

		SNP2 A 3 A_PlaySound("Maria/Zoom/Out",CHAN_BODY)
		TNT1 A 0 A_Takeinventory("Zoomed",0)
		SNP2 A 1 A_SetBlend("Black",0.2,3)
		SNP2 A 1 A_SetBlend("Black",0.4,3)
		SNP2 A 1 A_SetBlend("Black",0.6,3)
		SNP2 A 1 A_SetBlend("Black",0.8,3)
		SNP2 A 1 A_SetBlend("Black",1.0,6)
		TNT1 A 0 A_ZoomFactor(1.0)
		SNPZ A 0 A_PlaySound("Foley/Sleeves/Movement", CHAN_AUTO)
		SNPZ CBA 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)

		SNPB ABC 1   
		TNT1 A 0 A_StartSound("Foley/Rifle/Misc", CHAN_AUTO)
		SNPB DEFGHHII 1
		TNT1 A 0 A_PlaySound("Weapon/Sniper/Bolt/Back",1)
		TNT1 A 0 A_SpawnItemEx("SniperCasingSpawner", 14, -2, 35, 0, random(2,4), random(2,4))
		SNPB JKLLLM 2
		TNT1 A 0 A_PlaySound("Weapon/Sniper/Bolt/Foward",2)
		TNT1 A 0 A_StartSound("Foley/Rifle/Misc", CHAN_AUTO)
		SNPB NOPQRSSTTUU 1
		SNPG A 1

		TNT1 A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		TNT1 A 0 A_Giveinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(4.0)
		SNPZ A 0 A_SetBlend("Black",0.1,3)
		SNPZ A 0 A_PlaySound("Foley/Sleeves/Movement", CHAN_AUTO)
		SNPZ ABC 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		SNP2 A 3 A_PlaySound("Maria/Zoom/In",CHAN_BODY)
		SNP2 A 1 /*Bright*/ A_SetBlend("Black",0.4,3)
		SNP2 A 1 /*Bright*/ A_SetBlend("Black",0.6,3)
		SNP2 A 1 /*Bright*/ A_SetBlend("Black",0.8,3)
		SNP2 A 1 /*Bright*/ A_SetBlend("Black",1.0,6)
		SNP2 A 3
		Goto Ready2
		
	Reload:
		TNT1 A 0 A_JumpIfInventory("MariaSniperLoaded", 0, 2)
		TNT1 A 0 A_JumpIfInventory("MariaHeavyClip", 1, "ReloadWork")
		SNPG A 2 A_WeaponReady(WRF_NOFIRE)
		Goto ReadyLoop

	ReloadWork:
		SNPR ABCD 1
		TNT1 A 0 A_StartSound("Foley/Rifle/Misc", CHAN_AUTO)
		SNPR DEF 2
		SNPR GHH 2
		RGUR A 0  A_PlaySound ("Weapon/Sniper/Mag/Out", CHAN_AUTO)
		SNPR IJKLMN 1
		TNT1 A 0 { If(CountInv("MariaSniperLoaded") < 1) { A_SpawnItemEx("EmptyRifleMagazine", 9, -10, 35, 0, random(3,6), 4); } }
		SNPR O 4
		SNPR PQRSS 1
		SNPR TUVWW 2
		TNT1 A 0 A_PlaySound ("Weapon/Sniper/Mag/In", CHAN_AUTO)
		SNPR XYZ 1
		SNPR Z 1
		{
		If(CountInv("MariaSniperLoaded") < 1) { Return state("ReloadingLoop"); }
		return state("ReloadingLoop2");
		}

	ReloadingLoop:
		TNT1 A 0 A_TakeInventory("MariaHeavyClip", 1)
		TNT1 A 0 A_GiveInventory("MariaSniperLoaded", 1)
		TNT1 A 0 A_JumpIfInventory("MariaSniperLoaded", 10, "FinishReload")
		TNT1 A 0 A_JumpIfInventory("MariaHeavyClip", 1, "ReloadingLoop")
		Goto FinishReload

	FinishReload:
		TNT1 A 0 A_StartSound("Foley/Rifle/Misc", CHAN_AUTO)
		SN2R AABBCDEF 1
		SNPB ABCDEFGHHII 1   
		TNT1 A 0 A_PlaySound("Weapon/Sniper/Bolt/Back",1)
		SNPB JKLLLM 2
		TNT1 A 0 A_PlaySound("Weapon/Sniper/Bolt/Foward",2)
		TNT1 A 0 A_StartSound("Foley/Rifle/Misc", CHAN_AUTO)
		SNPB NOPQRSSTTUU 1
		SNPG A 1
		Goto ReadyLoop

	ReloadingLoop2:
		TNT1 A 0 A_TakeInventory("MariaHeavyClip", 1)
		TNT1 A 0 A_GiveInventory("MariaSniperLoaded", 1)
		TNT1 A 0 A_JumpIfInventory("MariaSniperLoaded", 0, "FinishReload2")
		TNT1 A 0 A_JumpIfInventory("MariaHeavyClip", 1, "ReloadingLoop2")
		Goto FinishReload2

	FinishReload2:
		TNT1 A 0 A_StartSound("Foley/Rifle/Misc", CHAN_AUTO)
		SN2R AABBCDEF 1
		SNPG A 2
		Goto ReadyLoop

	DryFire:
		"####" A 0 A_PlaySound("Weapon/Shinigami/Dry",0)
		"####" A 1 { A_WeaponOffset(0,36); A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH); }
		"####" A 10 { A_WeaponOffset(0,35); A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH); }
		Goto ReadyLoop

	ThrowPipebomb:
		SNPD ABCDE 1
		TASQ ABC 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TASG DEH 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
		TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
		TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
		TASG KLM 1
		TASG OPQR 1 
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TAHA AB 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
		TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
		TAHA CDE 1
		TNT1 A 5
		SNPS ABCDE 1
		Goto ReadyLoop

	UseStimShot:
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealth
		SNPD ABCDE 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		SNPS ABCDE 1
		Goto ReadyLoop

	User3:
	EquipShield:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("MariaShield",1)
		TNT1 A 0 A_SelectWEapon("MariaShield")
		Goto Deselect

	PunchFlash:
		SNPK ABC 1
		SNPK D 12
		SNPK CBA 1
		SNPG A 1
		Goto LightDone
	}
}

ACTOR MariaSniperLoaded : Ammo
{
   Inventory.Amount 0
   Inventory.MaxAmount 11 //10+1
   Inventory.Icon ""
}