//==============================================================================
// Incinerator
//==============================================================================
// Caliber: Fuel (Gasoline)
//==============================================================================
//
// 
// 
//
// 
//==============================================================================

actor MariaIncinerator : MariaWeapon //Replaces ID24Incinerator
{
	Weapon.AmmoGive1 50
	Weapon.AmmoType1 "MariaGasoline"
	Inventory.PickupSound "Weapon/Incinerator/Pickup"
	//Weapon.upsound "Weapons/ArmCannon/Select"
	Inventory.PickupMessage "Incinerator obtained! (Aerosol Can upgrade)"
	Tag "Incinerator"
	States
	{
	Ready:
		//INCS A 0 A_TakeInventory("MariaAerosolCan",1)
		TNT1 A 0 A_PlaySound("Maria/Draw/Flamethrower", 1)
		INCS ABCDE 1
		INCG A 0 A_PlaySound("Weapon/Incinerator/Select", 2)
		Goto ReadyLoop

	ReadyLoop:
		INCG A 0 
		{
		A_StopSound(1);
		if(CountInv("MariaGasoline") < 1 || waterlevel > 1)
			{
				return state("WaterReady");
			}
		return state("");
		}
		INCG B 1 Bright { A_FireCustomMissile("MariaFlareBlue",0,0,0,8); A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3); }
		INCG C 1 Bright { A_FireCustomMissile("MariaFlareBlue",0,0,0,8); A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3); }
		INCG D 1 Bright { A_FireCustomMissile("MariaFlareBlue",0,0,0,8); A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3); }
		Loop

	WaterReady:
		INCG A 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
		Loop

	Deselect:
		INCD ABCDE 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1
		Wait

	Select:
		TNT1 AA 0 A_Raise
		Loop

	Fire:
		NULL A 0 A_JumpIf(CountInv("MariaGasoline") < 1, "DryFire")
		TNT1 A 0 A_JumpIf(waterlevel > 1, "Useless")
		INCG A 0 A_PlaySound("Weapon/Incinerator/Fire/Start")
		TNT1 A 0 A_PlaySound("Weapon/Shinigami/Dry",0)
		INCG A 6
	Hold:
		INCG A 0
		{
		If(CountInv("MariaGasoline") < 1) { return state("DryFire"); }
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlaySound("Weapon/Incinerator/Fire/Loop", 1, 1, 1);
		A_AlertMonsters;
		A_SetBlend("DarkRed",0.3,16);
		A_SetPitch(pitch-0.5);
		A_TakeInventory("MariaGasoline", 1, TIF_NOTAKEINFINITE);
		return state("");
		}
		INCF A 1 Bright 
		{
		A_FireCustomMissile("MariaIncineratorFlame");
		radius_quake (2.5, 2, 0, 1, 0);
		}
		INCF B 1 Bright
		{
		A_SetBlend("DarkRed",0.3,16);
		A_SetPitch(pitch-0.5);
		A_TakeInventory("MariaGasoline", 1, TIF_NOTAKEINFINITE);
		}
		INCF C 1 Bright 
		{
		A_FireCustomMissile("MariaIncineratorFlame");
		radius_quake (2.5, 2, 0, 1, 0);
		}
		INCF D 1 Bright
		INCG A 0 Bright A_Refire
		INCG A 0 A_StopSound(1)
		INCG A 0 A_PlaySound("Weapon/Incinerator/Fire/End", 2)
		INCG AAAAAA 5 A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,6)
		INCG A 10 A_GunFlash
		Goto ReadyLoop

	DryFire:
		INCG A 0 A_StopSound(1)
		TNT1 A 0 A_PlaySound("Weapon/PlasmaRifle/Dry",0)
		TNT1 A 0 offset(0,36)
		INCG A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 0 offset(0,35)
		INCG A 10 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		Goto ReadyLoop

	Useless:
		TNT1 A 0 A_PRINT("Are you trying to roast the fish?")
		Goto WaterReady

	User1:
		TNT1 A 0 A_JumpIfInventory("PipebombAmmo", 1, "ThrowPipebomb")
	NoPipebomb:
		TNT1 A 0 A_Print("No Pipebombs left.")
		//PISG A 3
		goto ReadyLoop

	ThrowPipebomb:
		INCD ABCDE 1
		TASQ ABCDE 1
		TASG H 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
		TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
		TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
		TASG KLM 1
		TASG OPQR 1 
		TAHA AB 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
		TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
		TAHA CDE 1
		TNT1 A 5
		INCS ABCDE 1
		Goto ReadyLoop

	UseStimShot:
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealth
		INCD ABCDE 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		INCS ABCDE 1
		Goto ReadyLoop

	User3:
	EquipShield:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("MariaShield",1)
		TNT1 A 0 A_SelectWEapon("MariaShield")
		Goto Deselect

	Zoom:
        TNT1 A 0 
		{
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
        A_PlaySound("weapons/melee/fist/uppercut");
		A_ChangeVelocitY(2.5,0,2,CVF_RELATIVE);
        A_gunflash("PunchFlash"); //PunchFlash
		}
		TNT1 A 2
		HANU AB 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		HANU C 0 A_FireCustomMissile("MariaPunch2",0,0)
		HANU CCDEFGHIJK 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 5 //19
		Goto PunchFinish
	
	PunchFlash:
		INCK ABC 1
		INCK D 11
		INCK CBA 1
		INCG A 1
		Goto LightDone

	Flash:
		TNT1 A 0 Bright A_Light1
		TNT1 A 0 Bright A_Light2
		Goto LightDone

	Spawn:
		INCP A -1
		Stop
	}
}