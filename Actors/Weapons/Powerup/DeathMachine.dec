ACTOR MariaDeathMachine : Weapon
{
	Scale 0.75
	+NOAUTOFIRE
	+INVENTORY.UNDROPPABLE
	+CHEATNOTWEAPON
	Tag "Death Machine"
	Decal "BulletChip"
	Weapon.BobStyle "Smooth"
	Weapon.BobSpeed 2.5
	Weapon.BobRangeX 0.75
	Weapon.BobRangeY 0.5
	States
	{
	Select:
		TNT1 AA 0 A_Raise
		Loop

	DeselectFancy:
		TNT1 A 0 A_StopSound(5)
		TNT1 A 0 A_ZoomFactor(1.0)
		DMGD ABCDEFGH 1 A_WeaponReady(WRF_NoFire|WRF_NoSecondary|WRF_DisableSwitch|WRF_NoSwitch)
	Deselect:
		TNT1 A 0 
		{
		A_StopSound (CHAN_WEAPON);
		A_SetSpeed(1.0);
		If(CountInv("OverkillDuration") > 1) { return state("ReadyLoop"); }
		A_TakeInventory("MariaDeathMachine",1);
		return state("");
		}
		TNT1 A 1
		Wait

	Ready:
		TNT1 A 0 
		{
		A_SetSpeed(0.69);
		If(CountInv("OverkillDuration") < 1) { return state("TakeItOff"); }
		A_PlaySound("Maria/Draw/Heavy", 1);
		return state("");
		}
		DMGS ABCDEFGH 1
		TNT1 A 0 A_PlaySound("Weapon/Chaingun/Select", 2)
		Goto ReadyLoop

	ReadyLoop:
		DMGG A 1 
		{ 
		A_StopSound(5);
		A_WeaponReady(WRF_DisableSwitch|WRF_NoSwitch); 
		If(CountInv("OverkillDuration") < 1) { return state("DeselectFancy"); }
		return state("");
		}
		Loop

	Fire:
		TNT1 A 0 A_PlaySound("Weapon/Chaingun/Start",4)
		DMGG ABCDEF 1
		TNT1 A 0 A_PlaySound("Weapon/Chaingun/Loop",5,1,1)
		//DMGG ABCDEF 1
		DMGG D 0 A_Refire
	FireFinish:
		DMGG A 0 
		{
		A_StopSound (CHAN_WEAPON);
		A_WeaponOffset(0,32); 
		A_PlaySound("Weapon/Chaingun/Post",4);
		}
		DMGG ABCDEF 1 A_WeaponReady
		DMGG A 0 A_PlaySound("Weapon/Chaingun/Stop",5)
		DMGG ABCDEF 1 A_WeaponReady
		DMGG AABBCCDDEEFF 1 A_WeaponReady
		Goto ReadyLoop

	Hold:
		DMGG A 0 
		{
		A_GunFlash;
		A_PlaySound("Weapon/Chaingun/Fire",CHAN_WEAPON);
		}
		DMGF A 1 BRIGHT 
		{
		A_FireBullets (1, 1, -1, 30, "MariaPuffPurple");
		A_FireCustomMissile("MinigunCasingSpawner",-5,0,0,-6);
		A_FireCustomMissile("MinigunLinkCasingSpawner",-5,0,0,-6);
		A_FireCustomMissile("MariaFlarePurple",0,0,0,8);
		A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8);
		A_SetPitch(pitch - 0.5);
		}
		DMGF BC 1
		DMGG A 0 
		{
		If(CountInv("OverkillDuration") < 1) { return state("DeselectFancy"); } 
		A_GunFlash;
		A_PlaySound("Weapon/Chaingun/Fire", CHAN_WEAPON);
		return state("");
		}
		DMGF A 1 BRIGHT 
		{
		A_FireBullets(1.5, 1.5, -1, 30, "MariaPuffPurple");
		A_FireCustomMissile("MinigunCasingSpawner",-5,0,0,-6);
		A_FireCustomMissile("MinigunLinkCasingSpawner",-5,0,0,-6);
		A_FireCustomMissile("MariaFlarePurple",0,0,0,8);
		A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8);
		A_SetPitch(pitch - 0.5);
		}
		DMGF BC 1
		TNT1 A 0 A_JumpIf(CountInv("OverkillDuration") < 1, "DeselectFancy")
		DMGF A 0 A_Refire
		Goto FireFinish

	AltFire:
		TNT1 A 0 A_PlaySound("Weapon/Chaingun/Start",4)
		DMGG AABBCCDDEEFF 1
		TNT1 A 0 A_PlaySound("Weapon/Chaingun/Loop",5,1,1)
		DMGG ABCDEFABCDEF 1
		DMGG D 0 A_Refire
	AltFireFinish:
		TNT1 A 0 A_StopSound (CHAN_WEAPON)
		DMGG A 0 Offset(0,32) A_PlaySound("Weapon/Chaingun/Post",4)
		DMGG ABCDEF 1 A_WeaponReady
		DMGG A 0 A_PlaySound("Weapon/Chaingun/Stop",5)
		DMGG ABCDEFABCDEF 1 A_WeaponReady
		DMGG AABBCCDDEEFF 1 A_WeaponReady
		Goto ReadyLoop

	AltHold:
		DMGG A 0 
		{
		A_GunFlash;
		A_PlaySound("Weapon/Chaingun/Fire",CHAN_WEAPON);
		}
		DMGF A 1 BRIGHT
		{
		A_FireBullets (4.5, 4.5, -1, 30, "MariaPuffPurple");
		A_FireCustomMissile("MinigunCasingSpawner",-5,0,0,-6);
		A_FireCustomMissile("MinigunLinkCasingSpawner",-5,0,0,-6);
		A_FireCustomMissile("MariaFlarePurple",0,0,0,8);
		A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8);
		A_SetPitch(pitch - 0.5);
		}
		DMGF D 1
		{
		If(CountInv("OverkillDuration") < 1) { return state("DeselectFancy"); }
		A_GunFlash;
		A_PlaySound("Weapon/Chaingun/Fire", CHAN_WEAPON);
		return state("");
		}
		DMGF A 1 BRIGHT 
		{
		A_FireBullets (4.5, 4.5, -1, 30, "MariaPuffPurple");
		A_FireCustomMissile("MinigunCasingSpawner",-5,0,0,-6);
		A_FireCustomMissile("MinigunLinkCasingSpawner",-5,0,0,-6);
		A_FireCustomMissile("MariaFlarePurple",0,0,0,8);
		A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8);
		A_SetPitch(pitch - 0.5);
		}
		DMGF D 1
		TNT1 A 0 A_JumpIf(CountInv("OverkillDuration") == 0, "DeselectFancy")
		DMGF A 0 A_Refire
		Goto AltFireFinish

	Flash:
		TNT1 A 3 A_Light2
		TNT1 A 3 A_Light1
		TNT1 A 0 A_Light0
		Goto LightDone
	}
}