//==============================================================================
// Unknown Cannon
//==============================================================================
// Caliber: Cell and Arrows
//==============================================================================
// What the fuck is this!?
//==============================================================================
Actor MariaUnmakyr : MariaWeapon
{
	Weapon.AmmoGive1 25
	Weapon.AmmoGive2 50
	Weapon.AmmoType1 "MariaArrowAmmo"
	Weapon.AmmoType2 "Cell"
	+WEAPON.PRIMARY_USES_BOTH
	+WEAPON.NOAUTOFIRE
	+WEAPON.AMMO_CHECKBOTH
	Inventory.Pickupmessage "What the [REDACTED] is this!?"
	Obituary "%o was railed by %k."
	Inventory.PickupSound "Weapon/Railgun/Pickup"
	Tag "Unmakyr"
	States
	{
	Ready:
		TNT1 A 0 A_PlaySound("Maria/Draw/Heavy", 1) 
		TNT1 A 0 A_SetSpeed(0.67)
		TNT1 A 0 A_JumpIfInventory("UnmakyrModule",1,"ReadyBallista")
		UNES A 0 A_JumpIf(CountInv("Cell") < 3, 2)
		UNMS A 0
		"####" ABC 1
		"####" A 0 //A_PlaySound("Weapon/Railgun/Select", 2) 
		"####" DE 1
		Goto ReadyLoop

	ReadyBallista:
		BAES A 0 
		{
		If(CountInv("MariaArrowAmmo") < 5 || CountInv("Cell") < 10)
			{
				return State(2);
			}
			return state("");
		}
		BALS A 0
		"####" ABC 1
		"####" A 0 //A_PlaySound("Weapon/Railgun/Select", 2) 
		"####" DE 1
		Goto ReadyLoop

	ReadyLoop:
		TNT1 A 0 
		{
		If(CountInv("UnmakyrModule") == 1)
			{
				if(CountInv("MariaArrowAmmo") < 5 || CountInv("Cell") < 10)
				{
					Return State("EmptyLoop");
				}
			}
			else if(CountInv("Cell") < 3)
			{
				Return State("EmptyLoop");
			}
			return State("");
		}
		BALG A 0 A_JumpIfInventory("UnmakyrModule",1,2)
		UNMG A 0
		"####" ABCD 2 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
		Loop

	EmptyLoop:
		BALE A 0 A_JumpIfInventory("UnmakyrModule",1,2)
		UNME A 0 
		"####" A 2 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
		Loop

	Deselect:
		TNT1 A 0 A_SetSpeed(1.0)
		TNT1 A 0 A_StopSound(CHAN_WEAPON)
		TNT1 A 0 A_JumpIfInventory("UnmakyrModule",1,"DeselectBallista")
		UNED A 0 A_JumpIf(CountInv("Cell") < 3, 2)
		UNMD A 0
		"####" ABCDE 1
		Goto DeselectFinish

	DeselectBallista:
		BAED A 0
		{
		If(CountInv("MariaArrowAmmo") < 5 || CountInv("Cell") < 10)
			{
				return state(2);
			}
			return state("");
		}
		BALD A 0
		"####" ABCDE 1
	DeselectFinish:
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1
		Wait

	Select:
		TNT1 AA 0 A_Raise
		Loop

	Fire:
		TNT1 A 0 
		{
		If(CountInv("Cell") < 3) { return state("DryFire"); }
		A_AlertMonsters;
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		If(CountInv("UnmakyrModule") == 1 { return state("FireBallista"); }
		
		A_PlaySound("Weapon/Unmakyr/Fire/Default", CHAN_AUTO);
		return state("");
		}
		UNMF A 0 bright
		TNT1 A 0 A_SetBlend("Cyan",0.2,16)
		TNT1 A 0 A_TakeInventory("Cell", 3)
		TNT1 A 0 BRIGHT A_FireCustomMissile("MariaUnmakyrLaser",0,1)
		TNT1 A 0 BRIGHT A_FireCustomMissile("MariaUnmakyrLaser",4,0)
		TNT1 A 0 BRIGHT A_FireCustomMissile("MariaUnmakyrLaser",-4,0)
		UNMF A 1 BRIGHT A_SetPitch(pitch - 2)
		UNMF B 1 bright
		UNMF C 1
		UNMG A 1
		UNMG A 0 A_ReFire
		Goto ReadyLoop

	FireBallista:
		TNT1 A 0 
		{
		If(CountInv("MariaArrowAmmo") < 5 || CountInv("Cell") < 10) { return state("DryFire"); }
		A_PlaySound("Weapon/Unmakyr/Fire/Ballista", CHAN_AUTO);
		A_Recoil(2.5);
		A_SetBlend("Cyan",0.5,16);
		A_TakeInventory("MariaArrowAmmo", 5);
		A_TakeInventory("Cell", 10);
		return state("");
		}
		BALF A 1 BRIGHT A_FireCustomMissile("MariaBallistaShot",0,1)
		BALF B 1 bright A_SetPitch(pitch - 5)
		BALF C 1 
		BALF D 2 
		BALF E 3
		BALF EFG 4  
		BALF HI 3
		BALF J 2
		UNMA C 2 A_CheckReload
		TNT1 A 0
		{
		If(CountInv("MariaArrowAmmo") < 5 || CountInv("Cell") < 10) { return state("EmptyLoop"); }
		return state("");
		}
		RLGG A 0 A_PlaySound("Weapon/Unmakyr/Reload",CHAN_BODY)
		UNMA DEFG 2
		UNMA A 0 BRIGHT
		RLGG A 0 A_ReFire
		Goto ReadyLoop

	AltFire:
		UNMA A 0 
		{
		If(CountInv("UnmakyrModule") == 1)
			{
			A_PrintBold ("Unmakyr mode selected.");
			A_TakeInventory("UnmakyrModule");
			return state("ReturnToUnmakyr");
			}
			else
			{
			A_PrintBold ("Ballista mode selected.");
			A_GiveInventory("UnmakyrModule");
			return state("");
			}
		}
		TNT1 A 0 A_PlaySound("Weapon/Unmakyr/Switch/1")
		UNMA AB 2
		UNMA C 2 A_CheckReload
		UNMA DEFG 2
		Goto ReadyLoop

	ReturnToUnmakyr:
		UNMA C 2
		TNT1 A 0 A_PlaySound("Weapon/Unmakyr/Switch/2")
		UNMA BA 2
		Goto ReadyLoop

	Flash:
		TNT1 A 3 bright A_Light1
		TNT1 A 3 bright A_Light2
		TNT1 A 0 bright A_Light0
		Goto LightDone

	DryFire:
		BALE A 0 A_JumpIfInventory("UnmakyrModule",1,2)
		UNME A 0 
		"####" A 0 A_PlaySound("Weapon/BFG/Dry",0)
		"####" A 1 { A_WeaponOffset(0,36); A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH); }
		"####" A 10 { A_WeaponOffset(0,35); A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH); }
		Goto ReadyLoop

	ThrowPipebomb:
		TNT1 A 0 A_JumpIfInventory("UnmakyrModule",1,"ThrowPipebombBallista")
		UNED A 0 A_JumpIf(CountInv("Cell") < 3, 2)
		UNMD A 0
		"####" ABCDE 1
		TASQ ABC 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TASG DEH 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
		TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
		TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
		TASG KLM 1
		TASG OPQR 1 
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TAHA AB 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
		TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
		TAHA CDE 1
		TNT1 A 5
		UNES A 0 A_JumpIf(CountInv("Cell") < 3, 2)
		UNMS A 0
		"####" ABCDE 1
		Goto ReadyLoop

	ThrowPipebombBallista:
		BAED A 0
		{
		If(CountInv("MariaArrowAmmo") < 5 || CountInv("Cell") < 10)
			{
			return state(2);
			}
			return state("");
		}
		BALD A 0
		"####" ABCDE 1
		TASQ ABC 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TASG DEH 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
		TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
		TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
		TASG KLM 1
		TASG OPQR 1 
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TAHA AB 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
		TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
		TAHA CDE 1
		TNT1 A 5
		BAES A 0
		{
		If(CountInv("MariaArrowAmmo") < 5 || CountInv("Cell") < 10)
			{
			return state(2);
			}
			return state("");
		}
		BALS A 0
		"####" ABCDE 1
		Goto ReadyLoop

	UseStimShot:
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealth
		TNT1 A 0 A_JumpIfInventory("UnmakyrModule",1,"UseStimShotBallista")		
		UNED A 0 A_JumpIf(CountInv("Cell") < 3, 2)
		UNMD A 0
		"####" ABCDE 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		UNES A 0 A_JumpIf(CountInv("Cell") < 3, 2)
		UNMS A 0
		"####" ABCDE 1
		Goto ReadyLoop

	UseStimShotBallista:
		BAED A 0
		{
		If(CountInv("MariaArrowAmmo") < 5 || CountInv("Cell") < 10)
			{
			return state(2);
			}
			return state("");
		}
		BALD A 0
		"####" ABCDE 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		BAES A 0
		{
		If(CountInv("MariaArrowAmmo") < 5 || CountInv("Cell") < 10)
			{
			return state(2);
			}
			return state("");
		}		
		BALS A 0
		"####" ABCDE 1
		Goto ReadyLoop

	User3:
	EquipShield:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("MariaShield",1)
		TNT1 A 0 A_SelectWEapon("MariaShield")
		Goto Deselect

	Zoom:
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("weapons/melee/fist/uppercut")
		TNT1 A 0 A_ChangeVelocitY(2.5,0,2,CVF_RELATIVE ) 
		TNT1 A 0 A_gunflash("PunchFlash") //PunchFlash
		TNT1 A 2
		HANU AB 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		HANU C 0 A_FireCustomMissile("MariaPunch2",0,0)
		HANU CCDEFGHIJK 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 5 //19
		Goto PunchFinish

	PunchFlash:
		TNT1 A 0 A_JumpIfInventory("UnmakyrModule",1,"PunchFlashBallista")
		UNEK A 0 A_JumpIf(CountInv("Cell") < 3, 2)
		UNMK A 0
		"####" ABC 1
		"####" DEFGDEFGDEFG 1
		"####" CBA 1
		Goto LightDone

	PunchFlashBallista:
		BAEK A 0
		{
		if(CountInv("MariaArrowAmmo") < 5 || CountInv("Cell") < 10)
			{
				return state(2);
			}
			return state("");
		}
		BALK A 0
		"####" ABC 1
		"####" DEFGDEFGDEFG 1
		"####" CBA 1
		Stop

	Spawn:
		UNMP A -1
		Stop
	}
}

ACTOR MariaUnmakyrPiece : WeaponPiece
{
	//Inventory.PickupSound "misc/w_pkup"
	WeaponPiece.Weapon MariaUnmakyrHexen
	+FLOATBOB
	+NOGRAVITY
}

ACTOR MariaUnmakyrPiece1 : MariaUnmakyrPiece
{
	WeaponPiece.Number 1
	Inventory.PickupMessage "You got a Calamity Arbalest Muzzle!"
	States
	{
	Spawn:
		RAI1 A -1 Bright
		Stop
	}
}

ACTOR MariaUnmakyrPiece2 : MariaUnmakyrPiece
{
	WeaponPiece.Number 2
	Inventory.PickupMessage "You got a Calamity Arbalest Base!"
	States
	{
	Spawn:
		RAI2 A -1 Bright
		Stop
	}
}

ACTOR MariaUnmakyrPiece3 : MariaUnmakyrPiece
{
	WeaponPiece.Number 3
	Inventory.PickupMessage "You got a Calamity Arbalest Core!"
	States
	{
	Spawn:
		RAI3 A -1 Bright
		Stop
	}
}

ACTOR MariaUnmakyrDrop
{
	States
	{
	Spawn:
		TNT1 A 1
		TNT1 A 1 A_DropWeaponPieces("MariaUnmakyrPiece1", "MariaUnmakyrPiece2", "MariaUnmakyrPiece3")
		Stop
	}
}

ACTOR MariaUnmakyrHexen : MariaUnmakyr
{
	Health 3
	Weapon.slotnumber 7
	+Weapon.cheatnotweapon
	Inventory.PickupMessage "The Calamity Arbalest assembled!"
}