//==============================================================================
// Heckler and Koch MP5
//==============================================================================
// Caliber: 9x19mm Parabellum
//==============================================================================
// 
// 
// 
// 
//==============================================================================
Actor MariaMP5 : MariaWeapon
{
	obituary "%o was gunned down by %k's MP5."
	Tag "SWAT SMG"
	inventory.pickupmessage "MP5 Obtained!"
	weapon.kickback 100
	Inventory.PickupSound "misc/w_pkup" 
	weapon.ammotype1 "MariaMP5Loaded"
	weapon.ammogive2 31
	weapon.ammotype2 "MariaLightClip"
	+WEAPON.AMMO_CHECKBOTH
	+WEAPON.NOAUTOFIRE
	+CHEATNOTWEAPON
	states
	{
	Ready:
		TNT1 A 0 A_PlaySound("Maria/Draw/Primary")
		MP5S ABCDE 1
		Goto ReadyLoop

	ReadyLoop:
		MP5N A 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
		loop

	Ready2:
		MP52 A 1 A_WeaponReady
		Loop

	Deselect: 
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_Takeinventory("Zoomed",0)
		MP5D ABCDE 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1
		Wait

	Select:
		TNT1 AA 0 A_Raise
		loop

	Fire:
		"####" A 0 A_JumpIf(CountInv("MariaMP5Loaded") < 1, "DryFire")
		"####" A 0 A_PlaySound("Weapon/Shinigami/Dry",0)
		"####" A 1 Offset(0,33)
		"####" A 1 Offset(0,34)
	FireCounted:
		NULL A 0 
		{ 
		If(CountInv("MariaMP5Loaded") < 1 ) { return state("DryFire"); }
		If(GetCvar("magclicking") == 0 && CountInv("MariaMP5Loaded") < 9) { A_PlaySound("Weapon/Magclick", 1); }
		return state("");
		}
		MP5F A 0 bright 
		{
		A_FireBullets (2.5, 2.5, -1, 9, "MariaPuff");
		A_WeaponOffset(0, 33);
		A_FireCustomMissile("9mmBulletCasing",-5,0,0,-6); //A_SpawnItemEx("ARBulletCasing", 17, 3, 35, 0, random(3,6), random(3,7))
		radius_quake (1.5, 2, 0, 1, 0) ;
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_TakeInventory("MariaMP5Loaded", 1);
		A_PlaySound("Weapon/MP5/Fire", CHAN_AUTO);
		A_PlaySound("Weapon/MP5/Distant", 6);
		A_AlertMonsters;
		A_FireCustomMissile("MariaFlareOrange",0,0,0,8);
		A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8);
		A_Recoil(0.2);
		If(CountInv("Zoomed") == 1) { return state("FireZoomedCounted"); }
		return state("");
		}
		MP5F A 1 bright A_SetPitch(pitch-1.0)
		MP5F B 1 bright
		TNT1 A 0 Offset(-1, 32)
		MP5F C 1 
		MP5N A 0 A_Refire("FireCounted")
		Goto ReadyLoop

	FireZoomedCounted:
		MPZF A 1 bright A_SetPitch(pitch-1.0)
		MPZF B 1 bright
		TNT1 A 0 Offset(-1, 32)
		MPZF C 1
		MP52 A 0 A_Refire("FireCounted")
		Goto Ready2
	
	Altfire:
		TNT1 A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		TNT1 A 0 A_Giveinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(2.0)
		MP52 A 0 A_PlaySound("Foley/Sleeves/Movement", CHAN_AUTO)
		MP5Z ABC 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		MP52 A 3 A_PlaySound("Maria/Zoom/In",CHAN_BODY)
		Goto Ready2

	NoAim:
		MP5N A 0 A_PlaySound("Maria/Zoom/Out",CHAN_BODY)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_Takeinventory("Zoomed",0)
		MP52 A 0 A_PlaySound("Foley/Sleeves/Movement", CHAN_AUTO)
		MP5Z CBA 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		MP5N A 3 
		Goto ReadyLoop

	DryFire:
		TNT1 A 0 A_JumpIfInventory("Zoomed",1,"DryFire2")
		TNT1 A 0 A_PlaySound("Weapon/SMG/Dry",0)
		TNT1 A 0 offset(0,36)
		MP5N A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 0 offset(0,35)
		MP5N A 10 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		Goto ReadyLoop

	DryFire2:
		TNT1 A 0 A_PlaySound("Weapon/SMG/Dry",0)
		TNT1 A 0 offset(0,36)
		MP52 A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		TNT1 A 0 offset(0,35)
		MP52 A 10 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		Goto Ready2

	Reload:
		TNT1 A 0 A_JumpIfInventory("MariaMP5Loaded", 0, 2)
		TNT1 A 0 A_JumpIfInventory("MariaLightClip", 1, "ReloadWork")
		MP5N A 2 A_WeaponReady(WRF_NOFIRE)
		Goto ReadyLoop

	ReloadWork:
		MP1R AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		MP1R CDEF 1
		MP1R FGHI 2
		RGUR A 0  A_PlaySound ("Weapon/MP5/Reload/Pull", CHAN_AUTO)
		//TNT1 A 0 A_SpawnItemEx("EmptyRifleMagazine", 9, -10, 35, 0, random(3,6), 4)
		MP1R JKKLMNN 1
		MP1R OPPQQRST 1
		TNT1 A 0 A_PlaySound ("Weapon/MP5/Reload/MagOut", CHAN_AUTO)
		MP1R UV 1
		MP1R W 4
		TNT1 A 0 A_StartSound("Foley/MagPouch/Out", CHAN_AUTO)
		MP1R W 11
		MP1R XYYZZ 1
		MP2R A 3
		TNT1 A 0 A_PlaySound ("Weapon/MP5/Reload/MagIn", CHAN_AUTO)
		MP2R BCD 2
		Goto ReloadingLoop

	ReloadingLoop:
		TNT1 A 0 A_TakeInventory("MariaLightClip", 1,TIF_NOTAKEINFINITE)
		TNT1 A 0 A_GiveInventory("MariaMP5Loaded", 1)
		TNT1 A 0 A_JumpIfInventory("MariaMP5Loaded", 0, "FinishReload")
		TNT1 A 0 A_JumpIfInventory("MariaLightClip", 1, "ReloadingLoop")
		Goto FinishReload

	FinishReload:
		MP2R EFG 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		MP2R HIJKL 2
		TNT1 A 0 A_PlaySound ("Weapon/MP5/Reload/Slap", CHAN_AUTO)
		MP2R MNOPQR 2
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		MP5N A 2
		Goto ReadyLoop

	ThrowPipebomb:
		MP5D ABCDE 1
		TASQ ABC 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TASG DEH 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
		TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
		TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
		TASG KLM 1
		TASG OPQR 1 
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TAHA AB 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
		TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
		TAHA CDE 1
		TNT1 A 5
		MP5S ABCDE 1
		Goto ReadyLoop

	UseStimShot:
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealth
		MP5D ABCDE 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		MP5S ABCDE 1
		Goto ReadyLoop

	User3:
	EquipShield:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("MariaShield",1)
		TNT1 A 0 A_SelectWEapon("MariaShield")
		Goto Deselect

	Flash:
		TNT1 A 1 bright A_Light1
		TNT1 B 1 bright A_Light2
		TNT1 A 0 bright A_Light0
		stop

	PunchFlash:
		MP5K ABC 1
		MP5K D 12
		MP5K CBA 1
		Stop

	Spawn:
		MP5P A -1
		stop
	}
}

ACTOR MariaMP5Loaded : Ammo
{
   Inventory.Amount 0
   Inventory.MaxAmount 31
   Ammo.BackpackAmount 0
   Ammo.BackpackMaxAmount 31
   Inventory.Icon ""
}