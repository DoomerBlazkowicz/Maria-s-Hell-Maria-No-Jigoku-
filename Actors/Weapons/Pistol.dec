//==============================================================================
// Makarov PM
//==============================================================================
// Caliber: 9x18mm Parabellum
//==============================================================================
// I remember that Taiichiro confiscated this from Reiji before my attack on  
// Okaya, never expected that Makarov still reliable to this day. Light trigger
// and comes with a silencer, shame that silencer's weight reduces my spam
// but better than nothing I guess.
//==============================================================================
ACTOR MariaPistol : MariaWeapon
{
  Weapon.AmmoGive2 12
  Weapon.AmmoType1 "MariaPistolLoaded"
  Weapon.AmmoType2 "MariaLightClip"
  +WEAPON.WIMPY_WEAPON
  +WEAPON.NOAUTOFIRE
  +NOALERT
  +NOEXTREMEDEATH
  +WEAPON.AMMO_CHECKBOTH
  Inventory.PickupSound "Weapon/Pistol/Pickup"
  Obituary "%k passed the lead to %o"
  Inventory.PickupMessage "Makarov Obtained!"
  Tag "Makarov"
	States
	{
	Spawn:
		SIGP A -1
		Stop

	Select:
		TNT1 AA 0 A_Raise
		Loop

	Deselect:
		SISD A 0 A_JumpIfInventory("PistolSuppressor",1,"DeselectSilent")
		SEGD A 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1, 2)
		SIGD A 0
		"####" ABCDE 1
		Goto DeselectFinish
	DeselectSilent:
		SESD A 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1, 2) 
		SISD A 0
		"####" ABCDE 1
	DeselectFinish:
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1
		Wait

	Ready:
		TNT1 A 0 A_PlaySound("Maria/Draw/Sidearm")
		TNT1 A 0 A_JumpIfInventory("PistolSuppressor",1,"ReadySilent")
		SEGS A 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1, 2) 
		SIGS A 0
		"####" ABCDE 1
		Goto ReadyLoop
	ReadySilent:
		SESS A 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1, 2) 
		SISS A 0
		"####" ABCDE 1
		Goto ReadyLoop

	ReadyLoop:
		TNT1 A 0 A_JumpIfInventory("PistolSuppressor",1,"ReadySilentLoop")
		SIGG C 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1, 2)
		SIGG A 0
		SIGG "#" 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
		Loop
	ReadySilentLoop:
		SISG C 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1, 2)
		SISG A 0
		SISG "#" 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
		Loop

	Fire:
		"####" "#" 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1, "DryFire")
		"####" "#" 0 A_PlaySound("Weapon/Shinigami/Dry",0)
		"####" "#" 0 Offset(0,33)
	FireCounted:
		"####" "#" 0 A_JumpIfInventory("PistolSuppressor",1,"FireCountedSilent")
		"####" "#" 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1, "DryFire")
		TNT1 A 0 A_JumpIfInventory("MariaPistolLoaded", 2, 2)
		TNT1 A 0 A_PlaySound("Weapon/Magclick", 1)
		SIGG B 1
		SIGG A 0 A_GunFlash
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		SIGG A 0 A_PlayWeaponSound("Weapon/Pistol/Fire", CHAN_AUTO)
		TNT1 A 0 A_PlaySound("Weapon/Pistol/Distant", 6)
		TNT1 A 0 A_TakeInventory("MariaPistolLoaded", 1)
		SIGG B 0 BRIGHT A_AlertMonsters
		TNT1 B 0 radius_quake (1.5, 2, 0, 1, 0)
		SIGF A 1 BRIGHT A_FireBullets (1, 1, -1, 10, "MariaPuff")
		TNT1 A 0 A_FireCustomMissile("MariaFlareOrange",0,0,0,8)
		TNT1 A 0 A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8)
		SIGF B 1 A_SetPitch (pitch - 0.6)
		TNT1 B 0 Offset(0, 33) A_SpawnItemEx("9mmBulletCasing", 17, 3, 35, 0, random(3,6), random(3,7))
		SIGF C 1 
		SIGF D 1 A_WeaponReady(WRF_NOBOB | WRF_ALLOWRELOAD)
		SIGG C 1 A_WeaponReady(WRF_NOBOB | WRF_ALLOWRELOAD)
		SIGG A 1 A_WeaponReady(WRF_NOBOB | WRF_ALLOWRELOAD)
		SIGG A 1 A_WeaponReady(WRF_NOBOB | WRF_ALLOWRELOAD)
		SIGG A 0 //A_Refire
		Goto ReadyLoop

	FireCountedSilent:
		"####" "#" 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1, "DryFire")
		TNT1 A 0 A_JumpIfInventory("MariaPistolLoaded", 2, 2)
		TNT1 A 0 A_PlaySound("Weapon/Magclick", 1)
		SISG B 1
		SISG A 0 A_GunFlash
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		SISG A 0 A_PlayWeaponSound("Weapon/Pistol/Silencer/Fire", CHAN_AUTO)
		TNT1 A 0 A_PlaySound("Weapon/Pistol/Silencer/Distant", 6)
		TNT1 A 0 radius_quake (3, 2, 0, 1, 0)
		TNT1 A 0 A_AlertMonsters(384)
		TNT1 A 0 A_TakeInventory("MariaPistolLoaded", 1)
		SISG B 0 //A_AlertMonsters
		TNT1 B 0 radius_quake (1, 1, 0, 1, 0)
		SISF A 1 A_FireBullets (1, 1, -1, 13, "MariaPuff")
		TNT1 A 0 A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8)
		SISF B 1 A_SetPitch (pitch - 1.0)
		TNT1 B 0 Offset(0, 33) A_SpawnItemEx("9mmBulletCasing", 17, 3, 35, 0, random(3,6), random(3,7))
		SISF CD 1
		SIGG C 1
		SISG AAAA 1 
		SISG A 1
		SISG A 0 //A_Refire
		Goto ReadyLoop

	AltFire:
		SIGG A 0
		SIGG H 0 
		{
		If(CountInv("PistolSuppressor") == 1)
			{
			A_TakeInventory("PistolSuppressor");
			A_PrintBold("Silencer deattaching.");
			}
			else
			{
			A_GiveInventory("PistolSuppressor");
			A_PrintBold("Silencer attaching.");
			}
		}
		SISD A 0 A_JumpIfInventory("PistolSuppressor",1,1)
		Goto SuppressorOut
		SIGD A 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1, 2)
		SEGD A 0
		"####" ABCDE 1
		TNT1 A 5
		TNT1 A 0 A_PlaySound("Weapon/Pistol/Silencer/Attach")
		TNT1 A 10
		SISD A 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1, 2)
		SESD A 0
		"####" EDCBA 1
		Goto ReadyLoop
	SuppressorOut:
		SISD A 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1, 2)
		SESD A 0
		"####" ABCDE 1
		TNT1 A 5
		TNT1 A 0 A_PlaySound("Weapon/Pistol/Silencer/Deattach")
		TNT1 A 10
		SIGD A 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1, 2)
		SEGD A 0
		"####" EDCBA 1
		Goto ReadyLoop

	DryFire:
		"####" "#" 0 A_PlaySound("Weapon/Pistol/Dry",0)
		"####" "#" 1 { A_WeaponOffset(0,36); A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH); }
		"####" "#" 1 { A_WeaponOffset(0,35); A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH); }
		Goto ReadyLoop

	Flash:
		TNT1 A 2 BRIGHT A_Light2
		TNT1 A 2 BRIGHT A_Light1
		TNT1 A 0 A_Light0
		Stop
		
	Reload:
		SIGG A 0 A_JumpIfInventory("PistolSuppressor",1,"ReloadSilent")
		SIGG A 0 A_JumpIfInventory("MariaPistolLoaded", 0, 2)
		SIGG A 0 A_JumpIfInventory("MariaLightClip", 1, "ReloadWork")
		SIGG A 0 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		Goto ReadyLoop
	ReloadWork:
		SIGG A 0 A_JumpIfInventory("PistolSuppressor",1,"ReloadWorkSilent")
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SEGR A 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1,2)
		SIGR A 0
		"####" ABCD 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_Playsound("Weapon/Pistol/Eject")
		"####" D 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_SpawnItemEx("EmptyPistolMagazine", 17, 2, 35, 0, random(3,6), 4)
		"####" D 4 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" E 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_StartSound("Foley/Pistol/Raise", CHAN_AUTO)
		"####" EFF 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" GH 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_StartSound("Foley/MagPouch/Out", CHAN_AUTO)
		"####" IJKKK 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" LMN 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_Playsound("Weapon/Pistol/Load")
		"####" OPP 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1, "ReloadingLoop")
		Goto ReloadingLoop2
	ReloadingLoop:
		"####" A 0 A_TakeInventory("MariaLightClip", 1)
		"####" A 0 A_GiveInventory("MariaPistolLoaded", 1)
		"####" A 0 A_JumpIfInventory("MariaPistolLoaded", 8, "FinishReload")
		"####" A 0 A_JumpIfInventory("MariaLightClip", 1, "ReloadingLoop")
		Goto FinishReload
	FinishReload:
		TNT1 A 0 A_Playsound("Weapon/Pistol/Rack")
		SESR A 0 A_JumpIfInventory("PistolSuppressor",1,2)	
		SEGR A 0
		"####" QRS 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_StartSound("Foley/Pistol/Lower", CHAN_AUTO)
		"####" SSTUVW 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		Goto ReadyLoop

	ReloadingLoop2:
		"####" A 0 A_TakeInventory("MariaLightClip", 1)
		"####" A 0 A_GiveInventory("MariaPistolLoaded", 1)
		"####" A 0 A_JumpIfInventory("MariaPistolLoaded", 0, "FinishReload2")
		"####" A 0 A_JumpIfInventory("MariaLightClip", 1, "ReloadingLoop2")
		Goto FinishReload2
	FinishReload2:
		TNT1 A 0 A_StartSound("Foley/Pistol/Lower", CHAN_AUTO)
		SISR A 0 A_JumpIfInventory("PistolSuppressor",1,2)
		SIGR A 0
		"####" QQRST 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		Goto ReadyLoop

	ReloadWorkSilent:
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SESR A 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1,2)
		SISR A 0		
		"####" ABCD 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_Playsound("Weapon/Pistol/Eject")
		"####" D 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_SpawnItemEx("EmptyPistolMagazine", 17, 2, 35, 0, random(3,6), 4)
		"####" D 4 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" E 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_StartSound("Foley/Pistol/Raise", CHAN_AUTO)
		"####" EFF 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" GH 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_StartSound("Foley/MagPouch/Out", CHAN_AUTO)
		"####" IJKKK 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" LMN 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_Playsound("Weapon/Pistol/Load")
		"####" OPP 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1, "ReloadingLoop")
		Goto ReloadingLoop2

	ThrowPipebomb:
		TNT1 A 0 A_JumpIfInventory("MariaPistolLoaded", 1, 1)
		Goto EmptyThrowPipebomb
		TNT1 A 0 A_JumpIfInventory("PistolSuppressor",1,"ThrowPipebombSilent")
		SIGD ABCDE 1
		TASQ ABC 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TASG DEH 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
		TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
		TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
		TASG KLM 1
		TASG OPQR 1 
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TAHA AB 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
		TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
		TAHA CDE 1
		TNT1 A 5
		SIGS ABCDE 1
		Goto ReadyLoop
	EmptyThrowPipebomb:
		TNT1 A 0 A_JumpIfInventory("PistolSuppressor",1,"EmptyThrowPipebombSilent")
		SEGD ABCDE 1
		TASQ ABC 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TASG DEH 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
		TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
		TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
		TASG KLM 1
		TASG OPQR 1 
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TAHA AB 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
		TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
		TAHA CDE 1
		TNT1 A 5
		SEGS ABCDE 1
		Goto ReadyLoop

	ThrowPipebombSilent:
		TNT1 A 0 A_JumpIfInventory("MariaPistolLoaded", 1, 1)
		Goto EmptyThrowPipebombSilent
		SISD ABCDE 1
		TASQ ABCDE 1
		TASG H 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
		TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
		TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
		TASG KLM 1
		TASG OPQR 1 
		TAHA AB 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
		TNT1 A 0 A_PlaySound("Maria/Yeet", 4)
		TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
		TAHA CDE 1
		TNT1 A 5
		SISS ABCDE 1
		Goto ReadySilentLoop
	EmptyThrowPipebombSilent:
		SESD ABCDE 1
		TASQ ABCDE 1
		TASG H 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
		TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
		TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
		TASG KLM 1
		TASG OPQR 1 
		TAHA AB 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
		TNT1 A 0 A_PlaySound("Maria/Yeet", 4)
		TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
		TAHA CDE 1
		TNT1 A 5
		SESS ABCDE 1
		Goto EmptyReadySilentLoop

	UseStimShot:
		TNT1 A 0 A_JumpIfInventory("MariaPistolLoaded", 1, 1)
		Goto EmptyUseStimShot
		TNT1 A 0 A_JumpIfInventory("PistolSuppressor",1,"UseStimShotSilent")
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealth
		SIGD ABCDE 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		SIGS ABCDE 1
		Goto ReadyLoop
	FullHealth:
		TNT1 A 0 A_Print("You are healthy.")
		Goto ReadyLoop

	EmptyUseStimShot:
		TNT1 A 0 A_JumpIfInventory("PistolSuppressor",1,"EmptyUseStimShotSilent")
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealthEmpty
		SEGD ABCDE 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		SEGS ABCDE 1
		Goto EmptyReady
	FullHealthEmpty:
		TNT1 A 0 A_Print("You are healthy.")
		Goto EmptyReady

	UseStimShotSilent:
		TNT1 A 0 A_JumpIfInventory("MariaPistolLoaded", 1, 1)
		Goto EmptyUseStimShotSilent
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealthSilent
		SISD ABCDE 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		SISS ABCDE 1
		Goto ReadySilentLoop
	FullHealthSilent:
		TNT1 A 0 A_Print("You are healthy.")
		Goto ReadySilentLoop

	EmptyUseStimShotSilent:
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealthSilentEmpty
		SESD ABCDE 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		SESS ABCDE 1
		Goto EmptyReadySilentLoop
	FullHealthSilentEmpty:
		TNT1 A 0 A_Print("You are healthy.")
		Goto EmptyReadySilentLoop

	User3:
	EquipShield:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("MariaShield",1)
		TNT1 A 0 A_SelectWEapon("MariaShield")
		Goto Deselect
		
	PunchFlash:
		TNT1 A 0 A_JumpIfInventory("PistolSuppressor",1,"PunchFlashSilent")
		SIGK A 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1, 2)
		SEGK A 0		
		"####" ABC 1
		"####" D 12
		"####" CBA 1
		Stop
	PunchFlashSilent:
		SISK A 0 A_JumpIf(CountInv("MariaPistolLoaded") < 1, 2)
		SESK A 0
		"####" ABC 1
		"####" D 12
		"####" CBA 1
		Stop
	}
}

