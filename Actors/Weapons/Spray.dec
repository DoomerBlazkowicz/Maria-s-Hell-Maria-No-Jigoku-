//==============================================================================
// Aerosol Can/Zippo Lighter
//==============================================================================
// Caliber: Fuel (Gasoline, Aerosol)
//==============================================================================
//
// 
// 
//
// 
//==============================================================================
actor MariaAerosolCan : MariaWeapon
{
	Weapon.AmmoGive1 50
	Weapon.AmmoType "MariaGasoline"
	/*
	Weapon.AmmoGive1 50
	Weapon.AmmoType1 "MariaGasoline"
	Weapon.AmmoGive2 1
	Weapon.AmmoType2 "MariaCanAmmo"
	*/
	Inventory.PickupSound "Weapon/Spray/Pickup"
	Inventory.PickupMessage "Aerosol Can and a Lighter Obtained!"
	Tag "Aerosol Can"
	States
	{
	Ready:
		TNT1 A 0 A_PlaySound("Maria/Draw/Equipment", 1) 
		MARS ABC 1
		MARG A 0 A_PlaySound("Weapon/Spray/Zippo/Open", 2)
		MARS D 1
		MARG A 0 A_PlaySound("Weapon/Spray/Zippo/Lit", 3)
		TNT1 A 0 A_FireCustomMissile("MariaFlareOrange",0,0,0,8)
		MARS E 1
		TNT1 A 0 A_FireCustomMissile("MariaFlareOrange",0,0,0,8)
		Goto ReadyLoop

	ReadyLoop:
		TNT1 A 0 
		{
		If(CountInv("MariaGasoline") < 1 || waterlevel > 1) { return state("WaterReady"); }
		return state("");
		}
		MARG B 2 Bright { A_FireCustomMissile("MariaFlareOrange",0,0,0,8); A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3); }
		MARG C 2 Bright { A_FireCustomMissile("MariaFlareOrange",0,0,0,8); A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3); }
		MARG D 2 Bright { A_FireCustomMissile("MariaFlareOrange",0,0,0,8); A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3); }
		Loop

	WaterReady:
		MARG A 1 BRIGHT A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
		Loop

	Deselect:
		MARD A 1
		TNT1 A 0 A_FireCustomMissile("MariaFlareOrange",0,0,0,8)
		MARD B 1
		TNT1 A 0 A_FireCustomMissile("MariaFlareOrange",0,0,0,8)
		MARG A 0 A_PlaySound("Weapon/Spray/Zippo/Close",1)
		MARD CDE 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1
		Wait

	Select:
		TNT1 AA 0 A_Raise
		Loop

	Fire:
		NULL A 0 A_JumpIf(CountInv("MariaGasoline") < 1, "DryFire")
		TNT1 A 0 A_JumpIf(waterlevel > 1, "Useless")
		MARG A 3
	Hold:
		MARF A 0 Bright 
		{
		If(CountInv("MariaGasoline") < 1) { return state("DryFire"); }
		A_FireCustomMissile("MariaSprayFlame",0+random(-1,1),1,0+random(-1,1),4+random(-1,1));
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); } 
		A_PlaySound("Weapon/Spray/Fire", 1, 1, 1);
		A_AlertMonsters;
		A_SetBlend("DarkRed",0.3,16);
		A_TakeInventory("MariaGasoline", 1, TIF_NOTAKEINFINITE);
		return state("");
		}
		MARF A 1 Bright A_WeaponOffset(0,34,WOF_INTERPOLATE)
		MARF A 0 Bright 
		{
		If(CountInv("MariaGasoline") < 1) { return state("DryFire"); }
		A_FireCustomMissile("MariaSprayFlame",0+random(-1,1),1,0+random(-1,1),4+random(-1,1));
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlaySound("Weapon/Spray/Fire", 1, 1, 1);
		A_AlertMonsters;
		A_SetBlend("DarkRed",0.3,16);
		return state("");
		}		
		MARF A 1 Bright A_WeaponOffset(0,34,WOF_INTERPOLATE)
		MARF A 0 Bright 
		{
		If(CountInv("MariaGasoline") < 1) { return state("DryFire"); }
		A_FireCustomMissile("MariaSprayFlame",0+random(-1,1),1,0+random(-1,1),4+random(-1,1));
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlaySound("Weapon/Spray/Fire", 1, 1, 1);
		A_AlertMonsters;
		A_SetBlend("DarkRed",0.3,16);
		return state("");
		}
		MARF A 1 Bright A_WeaponOffset(0,34,WOF_INTERPOLATE)
		MARF A 0 Bright
		{
		If(CountInv("MariaGasoline") < 1) { return state("DryFire"); }
		A_FireCustomMissile("MariaSprayFlame",0+random(-1,1),1,0+random(-1,1),4+random(-1,1));
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlaySound("Weapon/Spray/Fire", 1, 1, 1);
		A_AlertMonsters;
		A_SetBlend("DarkRed",0.3,16);
		return state("");
		}		
		MARF A 1 Bright A_WeaponOffset(0,34,WOF_INTERPOLATE)
		MARG A 0 Bright A_Refire
		MARG A 0 A_StopSound(1)
		Goto ReadyLoop

	DryFire:
		TNT1 A 0 //A_PlaySound("Maria/Dryfire",0)
		TNT1 A 0 A_PRINT("Empty can!")
		MARG A 0 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		Goto ReadyLoop

	Useless:
		TNT1 A 0 A_PRINT("Are you trying to roast fish?")
		Goto WaterReady

	AltFire:
		NULL A 0 A_JumpIf(CountInv("MariaGasoline") < 50, "DryFire")
		TNT1 A 0 A_JumpIf(waterlevel > 1, "Useless")
		MART A 0
		MARG A 1 A_FireCustomMissile("MariaFlareOrange",0,0,0,8)
		MART AABC 2 Bright A_FireCustomMissile("MariaFlareOrange",0,0,0,8)
		MART A 0 A_PlaySound("Weapon/Spray/Bomb/Ignite", 1)
		MART DEFG 2 Bright A_FireCustomMissile("MariaFlareOrange",0,0,0,8)
	AltHold:
		CANH ABC 2 Bright A_FireCustomMissile("MariaFlareOrange",0,0,0,8)
		TNT1 A 0 A_ReFire
		CANH DEFG 2 Bright A_FireCustomMissile("MariaFlareOrange",0,0,0,8)
		TNT1 A 0 A_ReFire
	AltFinish:
		MART HIJ 2 Bright A_FireCustomMissile("MariaFlareOrange",0,0,0,8)
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TNT1 A 0 A_PlaySound("Weapon/Spray/Bomb/Throw", 2)
		TNT1 A 0 A_FireCustomMissile("ExplosiveAerosolCan",0,1,0,0)
		MART KLMNO 2
		MART OPQRST 2
		TNT1 A 1
		//TNT1 A 0 A_CheckReload
		TNT1 A 0 A_TakeInventory("MariaGasoline",50)
		TNT1 A 0 A_TakeInventory("MariaAerosolCan",1)
		TNT1 A 35
		Loop   

	ThrowPipebomb:
		MARD ABCDE 1
		TASQ ABC 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TASG DEH 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1, TIF_NOTAKEINFINITE)
		TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
		TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
		TASG KLM 1
		TASG OPQR 1 
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TAHA AB 1
		TNT1 A 0 
		{
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlaySound("Maria/Pipebomb/Throw", 3);
		A_FireCustomMissile("HolyPipebomb",0,1,0,0);
		}
		TAHA CDE 1
		TNT1 A 5
		MARS ABCDE 1
		Goto ReadyLoop

	UseStimShot:
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealth
		MARD ABCDE 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		MARS ABCDE 1
		Goto ReadyLoop

	User3:
	EquipShield:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("MariaShield",1)
		TNT1 A 0 A_SelectWEapon("MariaShield")
		Goto Deselect

	PunchFlash:
		MARK A 1  
		MARG A 0 A_PlaySound("Weapon/Spray/Zippo/Close",1)
		MARK BC 1
		MARK D 13
		MARK CB 1
		MARG A 0 A_PlaySound("Weapon/Spray/Zippo/Open", 2)
		MARK A 1
		MARG A 0 A_PlaySound("Weapon/Spray/Zippo/Lit", 3)
		Goto LightDone

	Flash:
		TNT1 A 0 Bright A_Light1
		TNT1 A 0 Bright A_Light2
		Goto LightDone

	Spawn:
		FARM A -1
		Stop
	}
}

ACTOR ExplosiveAerosolCan
{
	Radius 4
	Height 8
	Speed 30
	//Mass 9
	Damage 3
	-NOGRAVITY
	+EXPLODEONWATER
	+NOBLOCKMAP
	+MISSILE
	+ACTIVATEIMPACT
	+ACTIVATEPCROSS
	+NOTELEPORT
	+FORCEXYBILLBOARD
	+THRUGHOST
	+rollsprite
	//SeeSound "StunGun/Ignite"
	BounceSound "TearBomb/Bounce"
	PoisonDamage 7, 20, 5
	Gravity 0.7
	Scale 0.4
	Obituary "$OB_GRENADE"
	DamageType Grenade
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Changevelocity(0,0,2,CVF_RELATIVE)
	Spawn2:
		STOS ABCDEFGH 2 bright
		Loop
	Death:
		GLXP A 0 Bright A_NoGravity
		GLXP A 0 bright A_quake(1.5,12,0,960) 
		GLXP A 0 A_AlertMonsters
		//GLXP A 0 bright A_Explode(200,400,1,1,128)
		GLXP A 0 bright A_Explode(100,250,1,1,128)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Boom", CHAN_AUTO)
		TNT1 A 0 A_PlaySound("Maria/Explosion/Far", CHAN_AUTO)
		GLXP A 0 A_SetTranslucent(0.75,1)
		//GLXP A 1 bright
		TNT1 A 0 A_PlaySound("Maria/Explosion/Far", CHAN_ITEM)
		TNT1 A 0 A_SpawnItemEx("MariaShockWave")
		TNT1 AAAA 0 A_CustomMissile ("MariaSmallExplosionFlames", 0, 0, random (0, 360), 2, random (0, 360))  
		TNT1 AAAAAAAAAAAAAAAA 0 A_CustomMissile ("MariaSprayFlame", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 AAAAAAA 0 A_CustomMissile ("MariaSprayFlame", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 A 0 A_SpawnItemEx("MolotovFireball",0,0,8,12,0,4)
		TNT1 A 0 A_SpawnItemEx("MolotovFireball",0,0,-8,8,0,0)
		TNT1 A 0 A_SpawnItemEx("MolotovFireball",0,0,0,8,0,0)
		TNT1 AAAAAAA 0 A_CustomMissile ("MariaSprayFlame", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 AAAAAAAAAAAAAAAAAAAAA 8 A_SpawnProjectile("MariaExplosionSmoke", 1, 0, random(0, 360), CMF_AIMDIRECTION, random(-50, -130))
		stop
	XDeath:
		GLXP A 0 Bright A_NoGravity
		GLXP A 0 A_AlertMonsters
		GLXP A 0 bright A_quake(1.5,12,0,960)
		//GLXP A 0 bright A_Explode(200,400,1,1,128)
		GLXP A 0 bright A_Explode(100,250,1,1,128)
		GLXP A 0 A_PlaySound("Pipebomb/Boom",CHAN_BODY)
		TNT1 A 0 A_PlaySound("Maria/Explosion/Far", 3)
		GLXP A 0 A_SetTranslucent(0.75,1)
		//GLXP A 1 bright
		TNT1 A 0 A_SpawnItemEx("MariaShockWave")
		TNT1 AAAA 0 A_CustomMissile ("MariaSmallExplosionFlames", 0, 0, random (0, 360), 2, random (0, 360))  
		TNT1 AAAAAAA 0 A_CustomMissile ("MariaSprayFlame", 0, 0, random (0, 360), 2, random (0, 360))
		TNT1 A 0 A_SpawnItemEx("MolotovFireball",0,0,8,12,0,4)
		TNT1 A 0 A_SpawnItemEx("MolotovFireball",0,0,-8,8,0,0)
		TNT1 A 0 A_SpawnItemEx("MolotovFireball",0,0,0,8,0,0)
		TNT1 AAAAAAAAAAAAAAA 8 A_SpawnProjectile("MariaExplosionSmoke", 1, 0, random(0, 360), CMF_AIMDIRECTION, random(-50, -130))
		//GLXP A 1 bright
		//GLXP CDEFG 2 bright
		//GLXP HIJ 2 bright A_FadeOut(0.25)
		stop
	}
}

Actor MolotovFireball
{
	Projectile
	Radius 8
	Height 8
	Damage 5
	DamageType Fire
	Renderstyle Add
	-NOGRAVITY
	+FORCERADIUSDMG
	States
	{
	Spawn:
		FRTB A 1 Bright Nodelay
		{
		if(waterlevel>2)
			{
			return state("Null");
			}
		else { A_SpawnItemEx("MltvFTrail"); }
		return state("");
		}
		Loop

	Death:
		TNT1 AAAAAA 3 A_CheckFloor("FireBurn")
		Stop

	FireBurn:
		TNT1 A 0 A_StartSound("Weapon/Spray/Flames/Loop",5)
		TNT1 BBCCDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD 4
		{
		A_StartSound("Weapons/Molotov/Fire",7,CHANF_LOOPING,0.5);
		A_SpawnItemEx("MolotovFire",random(-52,52),random(0,52),2,0,0,-4,0,SXF_ORIGINATOR);
		A_SpawnItemEx("MolotovFire",random(-52,52),random(-52,0),2,0,0,-4,0,SXF_ORIGINATOR);
		A_Explode(20,112,XF_HURTSOURCE|XF_NOSPLASH|XF_THRUSTLESS|XF_CIRCULAR);
		A_SpawnItemEx("MolotovFire",random(-52,52),random(0,52),2,0,0,-4,0,SXF_ORIGINATOR);
		A_SpawnItemEx("MolotovFire",random(-52,52),random(-52,0),2,0,0,-4,0,SXF_ORIGINATOR);
		A_Explode(20,112,XF_HURTSOURCE|XF_NOSPLASH|XF_THRUSTLESS|XF_CIRCULAR);
		A_SpawnItemEx("MolotovFire",random(-52,52),random(0,52),2,0,0,-4,0,SXF_ORIGINATOR);
		A_SpawnItemEx("MolotovFire",random(-52,52),random(-52,0),2,0,0,-4,0,SXF_ORIGINATOR);
		A_Explode(20,112,XF_HURTSOURCE|XF_NOSPLASH|XF_THRUSTLESS|XF_CIRCULAR);
		A_SpawnItemEx("MolotovFire",random(-52,52),random(0,52),2,0,0,-4,0,SXF_ORIGINATOR);
		A_SpawnItemEx("MolotovFire",random(-52,52),random(-52,0),2,0,0,-4,0,SXF_ORIGINATOR);
		A_Explode(20,112,XF_HURTSOURCE|XF_NOSPLASH|XF_THRUSTLESS|XF_CIRCULAR);
		A_SpawnItemEx("MolotovFire",random(-52,52),random(0,52),2,0,0,-4,0,SXF_ORIGINATOR);
		A_SpawnItemEx("MolotovFire",random(-52,52),random(-52,0),2,0,0,-4,0,SXF_ORIGINATOR);
		A_Explode(20,112,XF_HURTSOURCE|XF_NOSPLASH|XF_THRUSTLESS|XF_CIRCULAR);
		A_SpawnItemEx("MolotovFire",random(-52,52),random(0,52),2,0,0,-4,0,SXF_ORIGINATOR);
		A_SpawnItemEx("MolotovFire",random(-52,52),random(-52,0),2,0,0,-4,0,SXF_ORIGINATOR);
		A_Explode(20,112,XF_HURTSOURCE|XF_NOSPLASH|XF_THRUSTLESS|XF_CIRCULAR);
		}
		TNT1 DD 4 { A_StartSound("Weapon/Spray/Flames/End",7,CHANF_LOOPING,0.5); A_Explode(4,112,XF_HURTSOURCE|XF_NOSPLASH|XF_THRUSTLESS|XF_CIRCULAR); }
		TNT1 D 4 { A_SoundVolume(7,0.4); A_Explode(4,112,XF_HURTSOURCE|XF_NOSPLASH|XF_THRUSTLESS|XF_CIRCULAR); }
		TNT1 D 4 { A_SoundVolume(7,0.3); A_Explode(4,108,XF_HURTSOURCE|XF_NOSPLASH|XF_THRUSTLESS|XF_CIRCULAR); }
		TNT1 C 4 { A_SoundVolume(7,0.2); A_Explode(3,104,XF_HURTSOURCE|XF_NOSPLASH|XF_THRUSTLESS|XF_CIRCULAR); }
		TNT1 C 4 { A_SoundVolume(7,0.1); A_Explode(3,100,XF_HURTSOURCE|XF_NOSPLASH|XF_THRUSTLESS|XF_CIRCULAR); }
		TNT1 B 4 A_StopSound(7)
		TNT1 BE 4
		Stop
	}
}

Actor MolotovFire
{
	Projectile
	Radius 4
	Height 4
	Damage 0
	Renderstyle Add
	Alpha 0.67
	Scale 1.5
	+THRUACTORS
	+DONTSPLASH
	-ACTIVATEIMPACT
	-ACTIVATEPCROSS
	States
	{
	Spawn:
		TNT1 AAA 2
		{
		if(waterlevel>2)
			{ return state("Null"); }
		return state("");
		}
	Death:
		FRTB GHI 1 Bright
		{
		if(waterlevel>2)
			{ return state("Null"); }
		else if(z==floorz)
			{ return A_JumpIfHigherOrLower("FireBurn","Null",-16,0); }
		else { A_SetScale(1.0); }
		return state("");
		}
		Stop

	FireBurn:
		FRTF ABCDEFGHIJKLMNO 3 Bright 
		Stop
	}
}