//==============================================================================
// M249 SAW
//==============================================================================
// Caliber: 7.62×51mm NATO Rounds
//==============================================================================
// A full automatic "light" machine gun with a ammo box attached, pretty fast
// lot of ammo to fire, but it's heavy to carry and hassle to load it up.
// Calling this "Light Machine Gun" is a irony.
//==============================================================================
Actor MariaLMG : MariaWeapon //replaces Chaingun
{
  obituary "%o was shredded by %k's LMG."
  Tag "Light Machine Gun"
  inventory.pickupmessage "M249 SAW Obtained!"
  weapon.kickback 100
  Inventory.PickupSound "Weapon/LMG/Pickup"
  weapon.ammotype1 "MariaLMGLoaded"
  weapon.ammogive2 100
  weapon.ammotype2 "MariaHeavyClip"
  +WEAPON.AMMO_CHECKBOTH
  +WEAPON.NOAUTOFIRE
  states
  {
  Ready:
    TNT1 A 0 A_JumpIfInventory("MariaLMGLoaded", 1, 1)
    Goto EmptyReady
    TNT1 A 0 A_StartSound("foley/LMG/Movement", CHAN_AUTO)
    TNT1 A 0 A_PlaySound("Maria/Draw/Primary")
    LMGS ABC 1
    TNT1 A 0 A_SetSpeed(0.75)
    LMGS DE 1
    Goto ReadyLoop
  EmptyReady:
    TNT1 A 0 A_PlaySound("Maria/Draw/Primary")
    LMES ABC 1
    TNT1 A 0 A_SetSpeed(0.75)
    LMES DE 1
    Goto ReadyLoop
  ReadyLoop:
    NULL A 0 A_JumpIfInventory("MariaLMGLoaded", 1, 1)
    Goto EmptyReadyLoop
    LMGG A 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
    loop
  EmptyReadyLoop:
    LMGE A 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
    loop
  Deselect: 
    TNT1 A 0 A_JumpIfInventory("MariaLMGLoaded", 1, 1)
    Goto EmptyDeselect
    TNT1 A 0 A_SetSpeed(1.0)
   	LMGD ABCDE 1
    TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
    TNT1 A 1
    Wait
  EmptyDeselect: 
    TNT1 A 0 A_SetSpeed(1.0)
   	LMED ABCDE 1
    TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
    TNT1 A 1
    Wait
  Select:
    TNT1 AA 0 A_Raise
    loop
	
  Fire:
    NULL A 0 A_JumpIfInventory("MariaLMGLoaded", 1, 1)
    Goto dryfire
    LMGG A 1 Offset(0,33)
    LMGG A 1 Offset(0,34)
    TNT1 A 0 A_PlaySound("Weapon/Shinigami/Dry",0)
    LMGG AAAA 1
  FireCounted:
    NULL A 0 A_JumpIfInventory("MariaLMGLoaded", 1, 1)
    Goto dryfire 
    TNT1 A 0 A_JumpIf(CallACS("MagClicking")==1, "FireCountedNoclicking")
    TNT1 A 0 A_JumpIfInventory("MariaLMGLoaded", 9, 2)
    TNT1 A 0 A_PlaySound("Weapon/Magclick", 1)
    LMGF A 0 bright A_FireBullets (3, 3, 1, 20, "MariaPuffPurple")
    LMGF A 0 A_FireCustomMissile("LMGCasingSpawner",-5,0,0,-6) //A_SpawnItemEx("ARBulletCasing", 17, 3, 35, 0, random(3,6), random(3,7))
    TNT1 A 0 A_FireCustomMissile("MinigunLinkCasingSpawner",-5,0,0,-6)
    TNT1 A 0 radius_quake (8, 3, 0, 1, 0) 
    TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
    TNT1 A 0 A_Jump(256,2)
    TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
    TNT1 A 0 A_TakeInventory("MariaLMGLoaded", 1)
    TNT1 A 0 A_PlaySound("Weapon/LMG/Fire", CHAN_AUTO)
    TNT1 A 0 A_PlaySound("Weapon/LMG/Distant", 6)
    TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_FireCustomMissile("MariaFlarePurple",0,0,0,8)
    TNT1 A 0 A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8)
    TNT1 A 0 //A_Recoil(0.2)
    LMGF A 1 bright A_SetPitch(pitch-1.5)
    LMGF B 1
    LMGF C 1
    RGUN A 0
    RGUN A 0 A_Refire("FireCounted")
    Goto ReadyLoop
	
  FireCountedNoclicking:
    NULL A 0 A_JumpIfInventory("MariaLMGLoaded", 1, 1)
    Goto dryfire 
    RGUF A 0 bright A_FireBullets (3, 3, 1, 20, "MariaPuffPurple")
    RGUF A 0 A_FireCustomMissile("LMGCasingSpawner",-5,0,0,-6) //A_SpawnItemEx("ARBulletCasing", 17, 3, 35, 0, random(3,6), random(3,7))
    TNT1 A 0 A_FireCustomMissile("MinigunLinkCasingSpawner",-5,0,0,-6)
    TNT1 A 0 radius_quake (8, 3, 0, 1, 0) 
    TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
    TNT1 A 0 A_Jump(256,2)
    TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
    TNT1 A 0 A_TakeInventory("MariaLMGLoaded", 1)
    TNT1 A 0 A_PlaySound("Weapon/Shinigami/Fire", CHAN_AUTO)
    TNT1 A 0 A_PlaySound("Weapon/LMG/Distant", 6)
    TNT1 A 0 A_AlertMonsters
    TNT1 A 0 A_FireCustomMissile("MariaFlarePurple",0,0,0,8)
    TNT1 A 0 A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8)
    TNT1 A 0 //A_Recoil(0.2)
    LMGF A 1 bright A_SetPitch(pitch-1.5)
    LMGF B 1
    LMGF C 1
    LMGG A 0
    LMGG A 0 A_Refire("FireCounted")
    Goto ReadyLoop
	
  DryFire:
    TNT1 A 0 A_PlaySound("Weapon/Shinigami/Dry",0)
    TNT1 A 0 offset(0,36)
    LMGE A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
    TNT1 A 0 offset(0,35)
    LMGE A 10 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
    Goto ReadyLoop
	
  Reload:
    TNT1 A 0 A_JumpIfInventory("MariaLMGLoaded", 100, 2)
    TNT1 A 0 A_JumpIfInventory("MariaHeavyClip", 1, "ReloadWork")
    LMGR A 0 A_WeaponReady(WRF_NOFIRE)
    Goto ReadyLoop
  ReloadWork:
    TNT1 A 0 A_JumpIfInventory("MariaLMGLoaded", 1, "ReloadWork2")
    TNT1 A 0 A_StartSound("Foley/Rifle/Misc", CHAN_AUTO)
	LMGR ABC 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LMGR DEFFGG 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LMGR A 0  A_PlaySound ("Weapon/LMG/Reload/Open", CHAN_AUTO)
	LMGR HIJ 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LMGR KLM 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LMGR NOP 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LMGR A 0  A_PlaySound ("Weapon/LMG/Reload/BoxOut", CHAN_AUTO)
	LMGR QQRRSTU 1
    TNT1 A 0 A_FireCustomMissile("EmptyASGAmmo",-5,0,0,-6) 
	LMGR VVWWW 2
	LMGR W 15
	LMGR XYZ 2
	LM2R A 1
	TNT1 A 0 A_PlaySound ("Weapon/LMG/Reload/BoxIn", CHAN_AUTO)
	LM2R B 2
	LM2R CCDEFGHH 2
	Goto ReloadingLoop    
  ReloadingLoop:
    TNT1 A 0 A_TakeInventory("MariaHeavyClip", 1)
    TNT1 A 0 A_GiveInventory("MariaLMGLoaded", 1)
    TNT1 A 0 A_JumpIfInventory("MariaLMGLoaded", 100, "FinishReload")
    TNT1 A 0 A_JumpIfInventory("MariaHeavyClip", 1, "ReloadingLoop")		
	Goto FinishReload	 
  FinishReload:
	TNT1 A 0 A_PlaySound ("Weapon/LMG/Reload/Belt", CHAN_AUTO)
	LM2R IJ 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LM2R KLMNN 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LM2R OPQ 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	TNT1 A 0 A_PlaySound ("Weapon/LMG/Reload/Close", CHAN_AUTO)
	LM2R RSTT 2	A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LM2R UUVWX 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LM2R YZ 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
    LM3R AABCDD 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	TNT1 A 0 A_PlaySound ("Weapon/LMG/Reload/Bolt/Back", 1)
    TNT1 A 0 A_StartSound("Foley/Rifle/Misc", CHAN_AUTO)
	LM3R EFFGGGHHHH 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LM3R GGFF 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	TNT1 A 0 A_PlaySound ("Weapon/LMG/Reload/Bolt/Release", 2)
	LM3R ED 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
    TNT1 A 0 A_StartSound("foley/LMG/Movement", CHAN_AUTO)
	LM3R IJKLM 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LMGG A 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	Goto ReadyLoop

  ReloadWork2:
    TNT1 A 0 A_StartSound("Foley/Rifle/Misc", CHAN_AUTO)
	LM4R ABC 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LM4R DEFFGG 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LM4R A 0  A_PlaySound ("Weapon/LMG/Reload/Open", CHAN_AUTO)
	LM4R HIJJJ 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LM4R KLMN 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	TNT1 A 0 A_PlaySound ("Weapon/LMG/Reload/Belt/Remove", CHAN_AUTO)
	LM4R NOP 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LM4R PQR 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LM4R STU 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LM4R A 0  A_PlaySound ("Weapon/LMG/Reload/BoxOut/Full", CHAN_AUTO)
	LM4R VVWXY 1
	LMGR VVWWW 2
	LMGR W 15
	LMGR XYZ 2
	LM2R A 1
	TNT1 A 0 A_PlaySound ("Weapon/LMG/Reload/BoxIn", CHAN_AUTO)
	LM2R B 2
	LM2R CCDEFGHH 2
	Goto ReloadingLoop2    
  ReloadingLoop2:
    TNT1 A 0 A_TakeInventory("MariaHeavyClip", 1)
    TNT1 A 0 A_GiveInventory("MariaLMGLoaded", 1)
    TNT1 A 0 A_JumpIfInventory("MariaLMGLoaded", 100, "FinishReload2")
    TNT1 A 0 A_JumpIfInventory("MariaHeavyClip", 1, "ReloadingLoop2")		
	Goto FinishReload2	 
  FinishReload2:
	TNT1 A 0 A_PlaySound ("Weapon/LMG/Reload/Belt", CHAN_AUTO)
	LM2R IJ 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LM2R KLMNN 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LM2R OPQ 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	TNT1 A 0 A_PlaySound ("Weapon/LMG/Reload/Close", CHAN_AUTO)
	LM2R RSTT 2	A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LM2R UUVWX 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	LMGG A 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
	Goto ReadyLoop

  ThrowPipebomb:
    NULL A 0 A_JumpIfInventory("MariaLMGLoaded", 1, 1)
    Goto EmptyThrowPipebomb
    LMGD ABCDE 1
    TASQ ABC 1
    TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
    TASG DEH 1
    TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
    TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
    TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
    TASG KLM 1
    TASG OPQR 1 
    TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
    TAHA AB 1
    TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
    TNT1 A 0 A_Jump(256,2)
    TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
    TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
    TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
    TAHA CDE 1
    TNT1 A 5
    TNT1 A 0 A_StartSound("foley/LMG/Movement", CHAN_AUTO)
    LMGS ABCDE 1
    Goto ReadyLoop
  EmptyThrowPipebomb:
    LMED ABCDE 1
    TASQ ABCDE 1
    TASG H 1
    TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
    TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
    TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
    TASG KLM 1
    TASG OPQR 1 
    TAHA AB 1
    TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
    TNT1 A 0 A_Jump(256,2)
    TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
    TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
    TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
    TAHA CDE 1
    TNT1 A 5
    TNT1 A 0 A_StartSound("foley/LMG/Movement", CHAN_AUTO)
    LMES ABCDE 1
    Goto ReadyLoop
	
  UseStimShot:
	TNT1 A 0 A_JumpIfHealthLower(100, 1)
	Goto FullHealth
    NULL A 0 A_JumpIfInventory("MariaLMGLoaded", 1, 1)
    Goto EmptyUseStimShot
    LMGD ABCDE 1
    SYRI AB 1
    TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
    SYRI CD 1
    SYRI EEFFGGG 1
    SYRI HIJKKLLL 1
    TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
    SYRI MNOPQQQRR 1
    TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
    SYRI STUUUVV 1
    TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
    SYRI WXYZ 1
    SYR2 AB 1
    TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
    TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
    SYR2 CD 1
    TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
    TNT1 A 0 A_SetBlend("BLUE",.5,25)
    TNT1 A 0 HealThing(10, 100)
    TNT1 A 0 A_GiveInventory("SyringeProtection")
    TNT1 A 0 A_GiveInventory("SyringeRegeneration")
    SYR2 EFGHIJ 2
    SYR2 KLLMMN 1
    TNT1 A 5
    TNT1 A 0 A_StartSound("foley/LMG/Movement", CHAN_AUTO)
    LMGS ABCDE 1
    Goto ReadyLoop	
  EmptyUseStimShot:
	TNT1 A 0 A_JumpIfHealthLower(100, 1)
	Goto FullHealth
    LMED ABCDE 1
    SYRI AB 1
    TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
    SYRI CD 1
    SYRI EEFFGGG 1
    SYRI HIJKKLLL 1
    TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
    SYRI MNOPQQQRR 1
    TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
    SYRI STUUUVV 1
    TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
    SYRI WXYZ 1
    SYR2 AB 1
    TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
    TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
    SYR2 CD 1
    TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
    TNT1 A 0 A_SetBlend("BLUE",.5,25)
    TNT1 A 0 HealThing(10, 100)
    TNT1 A 0 A_GiveInventory("SyringeProtection")
    TNT1 A 0 A_GiveInventory("SyringeRegeneration")
    SYR2 EFGHIJ 2
    SYR2 KLLMMN 1
    TNT1 A 5
    TNT1 A 0 A_StartSound("foley/LMG/Movement", CHAN_AUTO)
    LMES ABCDE 1
    Goto ReadyLoop	
  FullHealth:
	TNT1 A 0 A_Print("You are healthy.")
	Goto ReadyLoop

  User3:
  EquipShield:
	TNT1 A 0 A_ZoomFactor(1.0)
	TNT1 A 0 A_GiveInventory("MariaShield",1)
	TNT1 A 0 A_SelectWEapon("MariaShield")
	Goto Deselect
				
  Flash:
    TNT1 A 1 bright A_Light1
    TNT1 B 1 bright A_Light2
    TNT1 A 0 bright A_Light0
    stop

  /*Zoom:
    TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
    TNT1 A 0 A_Jump(256,2)
    TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
    TNT1 A 0 A_PlaySound("weapons/melee/fist/uppercut")
    TNT1 A 0 A_ChangeVelocitY(2.5,0,2,CVF_RELATIVE ) 
    TNT1 A 0 A_gunflash("PunchFlash") //PunchFlash
    TNT1 A 2
    HANU AB 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
    HANU C 0 A_FireCustomMissile("MariaPunch2",0,0)
    HANU CCDEFGHIJK 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
    TNT1 A 5 //19
    Goto PunchFinish*/

  PunchFlash:
    NULL A 0 A_JumpIfInventory("MariaLMGLoaded", 1, 1)
    Goto PunchFlashEmpty
	LMGK ABC 1
	LMGK D 12
	LMGK CBA 1
    LMGG A 1
	Goto LightDone
  PunchFlashEmpty:
	LMEK ABC 1
	LMEK D 12
	LMEK CBA 1
    LMGE A 1
	Goto LightDone
  Spawn:
    LMGP A -1
    stop
  }
}

ACTOR MariaLMGLoaded : Ammo
{
   Inventory.Amount 0
   Inventory.MaxAmount 100
   Ammo.BackpackAmount 0
   Ammo.BackpackMaxAmount 100
   Inventory.Icon ""
}