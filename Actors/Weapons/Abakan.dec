//==============================================================================
// UAC modified Avtomat Kalashnikova 
//==============================================================================
// Caliber: 5.56x45mm NATO/7.62x39mm
//==============================================================================
// UAC modified Russian Kalashnikov, surpising to see a old relic got relevance
// in 2046. Slow but deals pretty good damage, accurate and even average recoil.
//==============================================================================
Actor MariaAbakan : MariaWeapon //replaces Chaingun
{
	obituary "%o was gunned down by %k's Assault Rifle."
	Tag "Abakan"
	inventory.pickupmessage "Abakan Assault Rifle Obtained!"
	weapon.kickback 100
	Inventory.PickupSound "Weapon/Abakan/Pickup"
	weapon.ammotype1 "MariaShinigamiLoaded"
	weapon.ammogive2 21
	weapon.ammotype2 "MariaHeavyClip"
	+WEAPON.AMMO_CHECKBOTH
	+WEAPON.NOAUTOFIRE
	states
	{
	Ready:
		TNT1 A 0 A_PlaySound("Maria/Draw/Primary")
		RGUS ABCDE 1
		Goto ReadyLoop

	ReadyLoop:
		ZGUN A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
		RGUN A 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
		loop

	Ready2:
		ZGUN A 1 A_WeaponReady
		Loop

	Deselect: 
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_Takeinventory("Zoomed",0)
		RGUD ABCDE 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1
		Wait

	Select:
		TNT1 AA 0 A_Raise
		loop

	Fire:
		"####" A 0 
		{
		If(CountInv("MariaShinigamiLoaded") < 1) { return state("DryFire"); }
		A_PlaySound("Weapon/Shinigami/Dry",0);
		return state("");
		}
		"####" A 1 Offset(0,33)
		"####" A 1 Offset(0,34)
	FireCounted:
		"####" A 0
		{
			If(CountInv("MariaShinigamiLoaded") < 1) { return state("DryFire"); }
			If(GetCvar("magclicking") == 0 && CountInv("MariaShinigamiLoaded") < 9) { A_PlaySound("Weapon/Magclick", 1); }
			return state("");
		}
		RGUF A 0 bright
		{
			A_FireBullets (2, 2, -1, 25, "MariaPuffPurple");
			A_FireCustomMissile("AKCasingSpawner",-5,0,0,-6);
			radius_quake (4, 2, 0, 1, 0);
			If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
			A_TakeInventory("MariaShinigamiLoaded", 1);
			A_PlaySound("Weapon/Shinigami/Fire", CHAN_AUTO);
			A_PlaySound("Weapon/Shinigami/Distant", 6);
			A_AlertMonsters;
			A_FireCustomMissile("MariaFlarePurple",0,0,0,8);
			A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8);
			If(CountInv("Zoomed") == 1) { return state("FireZoomedCounted"); }
			return state("");
		}	
		RGUF A 1 bright A_SetPitch(pitch-1.0)
		NULL A 0 A_WeaponOffset(random(-1,1),32+random(0,1) )
		RGUF B 1 bright
		RGUF CD 1
		RGUN A 0 A_Refire("FireCounted")
		Goto ReadyLoop

	FireZoomedCounted:
		ZGUF A 1 bright A_SetPitch(pitch-0.75)
		ZGUF B 1
		ZGUF C 1
		ZGUF D 1
		ZGUN A 0 A_Refire("FireCounted")
		Goto Ready2

	Altfire:
		TNT1 A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		TNT1 A 0 A_Giveinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(2.0)
		RGUN A 0 A_PlaySound("Foley/Sleeves/Movement", CHAN_AUTO)
		RGUZ ABC 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		ZGUN A 3 A_PlaySound("Maria/Zoom/In",CHAN_BODY)
		Goto Ready2

	NoAim:
		MP5N A 0 A_PlaySound("Maria/Zoom/Out",CHAN_BODY)
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_Takeinventory("Zoomed",0)
		ZGUN A 0 A_PlaySound("Foley/Sleeves/Movement", CHAN_AUTO)
		RGUZ CBA 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		RGUN A 3 
		Goto ReadyLoop	
	
	DryFire:
		"####" A 0 A_PlaySound("Weapon/Shinigami/Dry",0) 
		"####" A 1 { A_Weaponoffset(0,36); A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH); }
		"####" A 10 { A_Weaponoffset(0,35); A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH); }
		Goto ReadyLoop
	
	Reload:
		TNT1 A 0 A_JumpIfInventory("MariaShinigamiLoaded", 0, 2)
		TNT1 A 0 A_JumpIfInventory("MariaHeavyClip", 1, "ReloadWork")
		RGUN A 0 A_WeaponReady(WRF_NOFIRE)
		Goto ReadyLoop

	ReloadWork:
		TNT1 A 0 A_StartSound("Foley/Rifle/Raise", CHAN_AUTO)
		RGUR ABCDEFF 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		RGUR G 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_StartSound("Foley/MagPouch/Out", CHAN_AUTO)
		RGUR G 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		RGUR H 5
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		RGUR IJKL 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		RGUR A 0 A_PlaySound ("Weapon/Shinigami/Reload/MagOut", CHAN_AUTO)
		RGUR MNO 2 
		TNT1 A 0 A_StartSound("Foley/Rifle/Misc", CHAN_AUTO)
		RGUR OPQ 2 
		RGUR RS 1
		TNT1 A 0 A_PlaySound ("Weapon/Shinigami/Reload/MagIn", CHAN_AUTO)
		RGUR TUVV 2
		RGUR WWXYZ 1
		RG2R A 1
		RG2R B 1
		{
		A_StartSound("Foley/MagPouch/In", CHAN_AUTO);
		If(CountInv("MariaShinigamiLoaded") < 1)
			{
				A_SpawnItemEx("EmptyRifleMagazine", 9, -10, 35, 0, random(3,6), 4);
				return state("ReloadingLoop");
			}
		return state("ReloadingLoop2");
		}

	ReloadingLoop:
		TNT1 A 0 A_TakeInventory("MariaHeavyClip", 1, TIF_NOTAKEINFINITE)
		TNT1 A 0 A_GiveInventory("MariaShinigamiLoaded", 1)
		TNT1 A 0 A_JumpIfInventory("MariaShinigamiLoaded", 30, "FinishReload")
		TNT1 A 0 A_JumpIfInventory("MariaHeavyClip", 1, "ReloadingLoop")
		Goto FinishReload

	FinishReload:
		TNT1 A 0 A_StartSound("Foley/Rifle/Misc", CHAN_AUTO)
		RG2R JKLMN 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_PlaySound ("Weapon/Shinigami/Reload/Bolt/Back", 1)
		RG2R OPQRS 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_PlaySound ("Weapon/Shinigami/Reload/Bolt/Release", 2)
		RG2R TUV 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_StartSound("Foley/Rifle/Lower", CHAN_AUTO)
		RG2R WXGHI 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		RGUN A 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		Goto ReadyLoop

	ReloadingLoop2:
		TNT1 A 0 A_TakeInventory("MariaHeavyClip", 1, TIF_NOTAKEINFINITE)
		TNT1 A 0 A_GiveInventory("MariaShinigamiLoaded", 1)
		TNT1 A 0 A_JumpIfInventory("MariaShinigamiLoaded", 0, "FinishReload2")
		TNT1 A 0 A_JumpIfInventory("MariaHeavyClip", 1, "ReloadingLoop2")
		Goto FinishReload2

	FinishReload2:
		TNT1 A 0 A_StartSound("Foley/Rifle/Lower", CHAN_AUTO)
		RG2R CDEF 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		RG2R GH 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		//TNT1 A 0 A_StartSound("Foley/Rifle/Misc", CHAN_AUTO)
		RG2R I 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		RGUN A 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		Goto ReadyLoop

	ThrowPipebomb:
		RGUD ABCDE 1
		TASQ ABC 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TASG DEH 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
		TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
		TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
		TASG KLM 1
		TASG OPQR 1 
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TAHA AB 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
		TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
		TAHA CDE 1
		TNT1 A 5
		RGUS ABCDE 1
		Goto ReadyLoop

	UseStimShot:
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealth
		RGUD ABCDE 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		RGUS ABCDE 1
		Goto ReadyLoop

	User3:
	EquipShield:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("MariaShield",1)
		TNT1 A 0 A_SelectWEapon("MariaShield")
		Goto Deselect

	Flash:
		TNT1 A 1 bright A_Light1
		TNT1 B 1 bright A_Light2
		TNT1 A 0 bright A_Light0
		stop

	PunchFlash:
		RGUK ABC 1
		RGUK D 12
		RGUK CBA 1
		RGUN A 1
		Goto LightDone

	Spawn:
		RGUP A -1
		stop
	}
}

ACTOR MariaShinigamiLoaded : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 31
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 31
	Inventory.Icon ""
}