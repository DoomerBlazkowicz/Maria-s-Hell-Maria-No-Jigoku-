//==============================================================================
// Crossbow
//==============================================================================
// Caliber: Arrow
//==============================================================================
// Another relic from my journey, how I used against Kinugawa before switching
// to Chainsaw, it's unfortunatelt weak but to my luck it's a silent weapon
// and it causes them to bleed for a time being.
//==============================================================================
ACTOR MariaCrossbow : MariaWeapon
{
	Inventory.PickupMessage "Crossbow Obtained! Welcome back."
	Weapon.AmmoGive2 5
	Weapon.AmmoType1 "MariaCrossbowLoaded"
	Weapon.AmmoType2 "MariaArrowAmmo" 
	Inventory.PickupSound "Weapon/Crossbow/Pickup"
	Weapon.KickBack 20
	Tag "Crossbow"
	+FLOORCLIP
	+WEAPON.NOAUTOFIRE
	+WEAPON.AMMO_CHECKBOTH
	States
	{
	Spawn:
		CBOW A -1
		Stop

	Ready:
		TNT1 A 0 A_PlaySound("Maria/Draw/Primary")
		MBES A 0 A_JumpIf(CountInv("MariaCrossbowLoaded") < 1, 2)
		MBOS A 0
		"####" ABCD 1
		Goto ReadyLoop

	ReadyLoop:
		MBOW B 0 A_JumpIf(CountInv("MariaCrossbowLoaded") < 1, 2)
		MBOW A 0
		MBOW "#" 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
		Loop

	Ready2:
		BOWS A 2 A_WeaponReady (WRF_NOBOB)
		BOWS A 0 A_SetPitch(pitch-frandom(-0.18,0.18))
		BOWS A 2 A_WeaponReady (WRF_NOBOB)
		BOWS A 0 A_SetPitch(pitch-frandom(-0.18,0.18))
		Loop

	Deselect:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_Takeinventory("Zoomed",0)
		MBED A 0 A_JumpIf(CountInv("MariaCrossbowLoaded") < 1, 2)
		MBOD A 0
		"####" ABCD 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1
		Wait

	Select:
		TNT1 AA 0 A_Raise
		Loop

	Fire:
		"####" "#" 0  A_JumpIf(CountInv("MariaCrossbowLoaded") < 1, "DryFire")
		TNT1 A 0 A_PlaySound("Weapon/Shinigami/Dry",0)
		MBOW A 0 Offset(0,33)
	FireCounted:
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Weapon/Crossbow/Fire", CHAN_AUTO)
		TNT1 A 0 A_TakeInventory("MariaCrossbowLoaded", 1)
		TNT1 A 0 A_JumpIfInventory("Zoomed",1,"FireZoomed")
		MBOF A 1 A_FireCustomMissile("MariaArrowMissile")
		MBOF BC 1
		MBOW B 4
		MBOW B 0 A_CheckReload
		MBOW B 1 //A_ReFire
		Goto ReadyLoop

	FireZoomed:
		TNT1 A 0 A_FireCustomMissile("MariaArrowMissile",0,1,0,0)
		BOWS A 4 
		BOWS A 0 A_CheckReload
		BOWS AAAAAA 2
		BOWS A 3
		Goto Ready2

	Reload:
		TNT1 A 0 A_JumpIfInventory("MariaCrossbowLoaded", 0, 2)
		REVG A 0 A_JumpIfInventory("MariaArrowAmmo", 1, "ReloadWork")
		MBOW B 0 A_WeaponReady(WRF_NOFIRE)
		Goto ReadyLoop

	ReloadWork:
		MB1R ABCDEFGGHHIIIJJJ 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		MB1R J 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_PlaySound("Weapon/Crossbow/Pull", CHAN_AUTO)
		MB1R K 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		MB1R L 6 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		MB1R MNOPPQQRR 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_PlaySound("Weapon/Crossbow/Load", CHAN_AUTO)
		MB1R SSSTTTTT 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		//TNT1 A 0 A_PlaySound("Weapon/Crossbow/Load", CHAN_AUTO)
		Goto ReloadingLoop

	ReloadingLoop:
		TNT1 A 0 A_TakeInventory("MariaArrowAmmo", 1)
		TNT1 A 0 A_GiveInventory("MariaCrossbowLoaded", 1)
		TNT1 A 0 A_JumpIfInventory("MariaCrossbowLoaded", 0, "FinishReload")
		TNT1 A 0 A_JumpIfInventory("MariaArrowAmmo", 1, "ReloadingLoop")
		Goto FinishReload

	FinishReload:
		MB1R UUUWWWXXYZ 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		MB2R AABCD 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		MBOW A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		Goto ReadyLoop

	DryFire:
		"####" A 0 A_PlaySound("Maria/Dryfire",0)
		"####" A 0 
		"####" B 1 { A_WeaponOffset(0,36); A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH); }
		"####" B 10 { A_WeaponOffset(0,35); A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH); }
		Goto ReadyLoop

	AltFire:
		TNT1 A 0 A_JumpIfInventory("Zoomed",1,"NoAim")
		TNT1 A 0 A_Giveinventory("Zoomed",1)
		TNT1 A 0 A_ZoomFactor(2.5)
		TNT1 A 0 A_PlaySound("Foley/Sleeves/Movement", CHAN_AUTO)
		MBOZ A 0 A_SetBlend("Black",0.2,3)
		MBOW B 0 A_JumpIf(CountInv("MariaCrossbowLoaded") < 1, 2)
		MBOW A 0
		MBOW "#" 1 A_JumpIf(CountInv("MariaCrossbowLoaded") < 1, "EmptyAltFire")
		MBOZ ABC 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		MBOZ C 0 A_PlaySound("Maria/Zoom/In",CHAN_BODY)
		BOWS A 1 /*Bright*/ A_SetBlend("Black",0.4,3)
		BOWS A 1 /*Bright*/ A_SetBlend("Black",0.6,3)
		BOWS A 1 /*Bright*/ A_SetBlend("Black",0.8,3)
		BOWS A 1 /*Bright*/ A_SetBlend("Black",1.0,6)
		BOWS A 3
		Goto Ready2

	EmptyAltFire: 
		MBOZ DEF 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		MBOZ F 0 A_PlaySound("Maria/Zoom/In",CHAN_BODY)
		BOWS A 1 /*Bright*/ A_SetBlend("Black",0.4,3)
		BOWS A 1 /*Bright*/ A_SetBlend("Black",0.6,3)
		BOWS A 1 /*Bright*/ A_SetBlend("Black",0.8,3)
		BOWS A 1 /*Bright*/ A_SetBlend("Black",1.0,6)
		BOWS A 3
		Goto Ready2

	NoAim:
		BOWS A 3 A_PlaySound("Maria/Zoom/Out",CHAN_BODY)
		TNT1 A 0 A_Takeinventory("Zoomed",0)
		BOWS A 1 A_SetBlend("Black",0.2,3)
		BOWS A 1 A_SetBlend("Black",0.4,3)
		BOWS A 1 A_SetBlend("Black",0.6,3)
		BOWS A 1 A_SetBlend("Black",0.8,3)
		BOWS A 1 A_SetBlend("Black",1.0,6)
		TNT1 A 0 A_ZoomFactor(1.0)
		MBOZ A 0 A_PlaySound("Foley/Sleeves/Movement", CHAN_AUTO)
		TNT1 A 0 A_JumpIf(CountInv("MariaCrossbowLoaded") < 1, "EmptyNoAim")
		MBOZ CBA 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		MBOW A 3 
		Goto ReadyLoop

	EmptyNoAim:
		MBOZ FED 1 A_WeaponReady(/*WRF_ALLOWRELOAD|*/WRF_NOSECONDARY|WRF_NOBOB)
		MBOW B 3 
		Goto ReadyLoop 

	ThrowPipebomb:
		MBED A 0 A_JumpIf(CountInv("MariaCrossbowLoaded") < 1, 2)
		MBOD A 0
		"####" ABCD 1
		TASQ ABC 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TASG DEH 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
		TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
		TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
		TASG KLM 1
		TASG OPQR 1 
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TAHA AB 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
		TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
		TAHA CDE 1
		TNT1 A 5
		MBES A 0 A_JumpIf(CountInv("MariaCrossbowLoaded") < 1, 2)
		MBOS A 0
		"####" ABCD 1
		Goto ReadyLoop

	UseStimShot:
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealth
		MBED A 0 A_JumpIf(CountInv("MariaCrossbowLoaded") < 1, 2)
		MBOD A 0
		"####" ABCD 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		MBES A 0 A_JumpIf(CountInv("MariaCrossbowLoaded") < 1, 2)
		MBOS A 0
		"####" ABCD 1
		Goto ReadyLoop

	User3:
	EquipShield:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("MariaShield",1)
		TNT1 A 0 A_SelectWEapon("MariaShield")
		Goto Deselect

	PunchFlash:
		MBOK ABC 1
		MBOK D 12
		MBOK CBA 1
		MBOW A 1
		Goto LightDone
	}
}

ACTOR MariaCrossbowLoaded : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 1
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 1
	Inventory.Icon ""
}