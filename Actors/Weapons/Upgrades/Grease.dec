//==============================================================================
// M3 Grease Gun
//==============================================================================
// Caliber: 9X19mm Parabelum / 9X18mm Makarov
//==============================================================================
// 
// 
// 
//
// 
//==============================================================================
Actor MariaGrease : MariaWeapon
{
	Weapon.AmmoType1 "MariaGreaseLoaded"
	Weapon.AmmoType2 "MariaLightClip"
	Weapon.AmmoGive2 64
	Weapon.Kickback 150
	//decal Bulletchip
	Tag "M3 Grease Gun"
	Inventory.PickupSound "Weapon/Greaser/Reload/Bolt/Back"
	//Weapon.upsound "Weapon/DualSMG/Select"
	Inventory.PickupMessage "M3 Grease Gun obtained! (Makarov Upgrade)"
	+WEAPON.AMMO_CHECKBOTH
	+WEAPON.NOALERT
	+WEAPON.NOAUTOFIRE
	+CHEATNOTWEAPON
	States
	{
	Spawn:
		AAYP A 1
		Loop

	Select:
		TNT1 AA 0 A_Raise
		Loop

	Deselect:
		MESD A 0 A_JumpIfInventory("GreaseSuppressor",1,2)
		MEAD A 0
		"####" ABCDE 1
		TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1
		Wait

	Ready:
		TNT1 A 0 A_PlaySound("Maria/Draw/Primary")
		MESS A 0 A_JumpIfInventory("GreaseSuppressor",1,2)
		MEAS A 0
		"####" ABCDE 1
		Goto ReadyLoop

	ReadyLoop:
		MEAI B 0 A_JumpIfInventory("GreaseSuppressor",1,2)
		MEAI A 0
		MEAI "#" 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
		loop

	Fire:
		NULL A 0 A_JumpIf(CountInv("MariaGreaseLoaded") < 1, "DryFire")
		TNT1 A 0 A_PlaySound("Weapon/Shinigami/Dry",0)
		MEAI B 0 A_JumpIfInventory("GreaseSuppressor",1,2)
		MEAI A 0
		MEAI "#" 1 Offset(0,33)
		MEAI "#" 1 Offset(0,34)
		MEAI "#" 1
	FireCounted:
		NULL A 0 A_JumpIf(CountInv("MariaGreaseLoaded") < 1, "DryFire")
		TNT1 A 0 A_JumpIfInventory("GreaseSuppressor",1,"FireCountedSilent")
		MEAF A 1 BRIGHT 
		{
		A_FireBullets (1, 1, -1, 10, "MariaPuff");
		A_TakeInventory("MariaGreaseLoaded", 1);
		radius_quake (3, 2, 0, 1, 0);
		If(GetCvar("MagClicking") ==0 && CountInv("MariaGreaseLoaded") < 9) { A_PlaySound("Weapon/Magclick", 1); }
		A_FireCustomMissile("MariaFlareOrange",0,0,0,8);
		A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8);
		A_SetPitch(pitch-0.50);
		A_WeaponOffset(random(-1,1),32+random(0,1));
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlaySound("Weapon/Greaser/Fire", CHAN_AUTO);
		A_PlaySound("Weapon/Greaser/Distant", 6);
		A_AlertMonsters;
		}
		MEAF BCD 1
		MEAI A 0 A_ReFire("FireCounted")
		Goto ReadyLoop

	FireCountedSilent:
		MESF A 1
		{
		A_FireBullets (1, 1, -1, 15, "MariaPuff");
		A_TakeInventory("MariaGreaseLoaded", 1);
		radius_quake (3, 2, 0, 1, 0);
		If(GetCvar("MagClicking") ==0 && CountInv("MariaGreaseLoaded") < 9) { A_PlaySound("Weapon/Magclick", 1); }
		A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8);
		A_SetPitch(pitch-0.50);
		A_WeaponOffset(random(-1,1),32+random(0,1));
		If(CountInv("PowerQuadDamage") == 1) { A_PlaySound("Maria/Powerup/Quad/Shoot",7); }
		A_PlaySound("Weapon/Greaser/Silenced", CHAN_AUTO);
		A_PlaySound("Weapon/Greaser/Supressed/Distant", 6);
		A_AlertMonsters(384);
		}
		MESF BCD 1
		MEAI B 0 A_ReFire("FireCounted")
		Goto ReadyLoop 

	AltFire:
		MESD A 0 
		{
		If(CountInv("GreaseSuppressor") == 1)
			{
				A_TakeInventory("GreaseSuppressor");
				A_PrintBold ("Suppressor deattaching.");
				return state(2);
			}
			else
			{
				A_PrintBold ("Suppressor attaching.");
				A_GiveInventory("GreaseSuppressor");
				return state("");
			}
		}
		MEAD A 0
		"####" ABCDE 1
		TNT1 A 5
		TNT1 A 0 
		{
		If(CountInv("GreaseSuppressor") == 1)
			{		
				A_PlaySound("Weapon/Pistol/Silencer/Deattach");
			}
			else
			{
				A_PlaySound("Weapon/Pistol/Silencer/Attach");
			}
		}
		TNT1 A 10
		MESD A 0 A_JumpIfInventory("GreaseSuppressor",1,2)
		MEAD A 0
		"####" EDCBA 1
		Goto ReadyLoop
		
	DryFire:
		MEAI "#" 0 A_PlaySound("Weapon/SMG/Dry",1)
		MEAI "#" 0 offset(0,36)
		MEAI "#" 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		MEAI "#" 0 offset(0,35)
		MEAI "#" 10 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		Goto ReadyLoop

	Reload:
		TNT1 A 0 A_JumpIfInventory("MariaGreaseLoaded", 0, 2)
		TNT1 A 0 A_JumpIfInventory("MariaLightClip", 1, "ReloadWork")
		MEAI A 0 A_WeaponReady(WRF_NOFIRE)
		Goto ReadyLoop

	ReloadWork:
		TNT1 A 0 A_StartSound("Foley/PDW/Raise", CHAN_AUTO)
		SER1 A 0 A_JumpIfInventory("GreaseSuppressor",1,2)
		MER1 A 0
		"####" ABCCDD 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" EFGG 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		//TNT1 A 0 A_StartSound("Foley/PDW/Mag/Out", CHAN_AUTO)
		"####" A 0 A_Playsound("Weapon/Greaser/Reload/Out", 1)
		"####" HHIIJKMN 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_SpawnItemEx("EmptyPistolMagazine", 17, 2, 35, 0, random(3,6), 4)
		"####" O 4 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_StartSound("Foley/MagPouch/Out", CHAN_AUTO)
		"####" O 11 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" PQRS 1 
		"####" STU 2 
		"####" A 0 A_Playsound("Weapon/Greaser/Reload/In", 2)
		"####" V 3
		{
		If(CountInv("MariaGreaseLoaded") < 1) { return state("ReloadingLoop"); }
		return state("ReloadingLoop2");
		}

	ReloadingLoop:
		"####" A 0 A_TakeInventory("MariaLightClip", 1)
		"####" A 0 A_GiveInventory("MariaGreaseLoaded", 1)
		"####" A 0 A_JumpIfInventory("MariaGreaseLoaded", 30, "FinishReload")
		"####" A 0 A_JumpIfInventory("MariaLightClip", 1, "ReloadingLoop")
		Goto FinishReload

	FinishReload:
		"####" WX 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_StartSound("Foley/PDW/Lower", CHAN_AUTO)
		"####" YZ 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		SER2 A 0 A_JumpIfInventory("GreaseSuppressor",1,2)
		MER2 A 0		
		"####" A 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		SER1 A 0 A_JumpIfInventory("GreaseSuppressor",1,2)
		MER1 A 0
		"####" A 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)

		/*MER2 BCD 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		TNT1 A 0 A_Playsound("Weapon/Greaser/Reload/Bolt/Back", 2)
		MER2 DEEDCB 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)*/
		MEAI B 0 A_JumpIfInventory("GreaseSuppressor",1,2)
		MEAI A 0
		MEAI "#" 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		Goto ReadyLoop

	ReloadingLoop2:
		"####" A 0 A_JumpIfInventory("GreaseSuppressor",1,"ReloadingLoop2Silent")
		"####" A 0 A_TakeInventory("MariaLightClip", 1)
		"####" A 0 A_GiveInventory("MariaGreaseLoaded", 1)
		"####" A 0 A_JumpIfInventory("MariaGreaseLoaded", 0, "FinishReload2")
		"####" A 0 A_JumpIfInventory("MariaLightClip", 1, "ReloadingLoop2")
		Goto FinishReload2

	FinishReload2:
		"####" WX 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		"####" A 0 A_StartSound("Foley/PDW/Lower", CHAN_AUTO)
		"####" YZ 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		SER2 A 0 A_JumpIfInventory("GreaseSuppressor",1,2)
		MER2 A 0		
		"####" A 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		SER1 A 0 A_JumpIfInventory("GreaseSuppressor",1,2)
		MER1 A 0
		"####" A 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		MEAI B 0 A_JumpIfInventory("GreaseSuppressor",1,2)
		MEAI A 0
		MEAI "#" 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
		Goto ReadyLoop

	ThrowPipebomb:
		MESD A 0 A_JumpIfInventory("GreaseSuppressor",1,2)
		MEAD A 0
		"####" ABCDE 1
		TASQ ABC 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TASG DEH 1
		TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
		TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
		TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
		TASG KLM 1
		TASG OPQR 1 
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		TAHA AB 1
		TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
		TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
		TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
		TAHA CDE 1
		TNT1 A 5
		MESS A 0 A_JumpIfInventory("GreaseSuppressor",1,2)
		MEAS A 0
		"####" ABCDE 1
		Goto ReadyLoop

	UseStimShot:
		TNT1 A 0 A_JumpIfHealthLower(100, 1)
		Goto FullHealth
		MESD A 0 A_JumpIfInventory("GreaseSuppressor",1,2)
		MEAD A 0
		"####" ABCDE 1
		SYRI AB 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI CD 1
		SYRI EEFFGGG 1
		SYRI HIJKKLLL 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
		SYRI MNOPQQQRR 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
		SYRI STUUUVV 1
		TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
		SYRI WXYZ 1
		SYR2 AB 1
		TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
		SYR2 CD 1
		TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
		TNT1 A 0 A_SetBlend("BLUE",.5,25)
		TNT1 A 0 HealThing(10, 100)
		TNT1 A 0 A_GiveInventory("SyringeProtection")
		TNT1 A 0 A_GiveInventory("SyringeRegeneration")
		SYR2 EFGHIJ 2
		SYR2 KLLMMN 1
		TNT1 A 5
		MESS A 0 A_JumpIfInventory("GreaseSuppressor",1,2)
		MEAS A 0
		"####" ABCDE 1
		Goto ReadyLoop

	User3:
	EquipShield:
		TNT1 A 0 A_ZoomFactor(1.0)
		TNT1 A 0 A_GiveInventory("MariaShield",1)
		TNT1 A 0 A_SelectWEapon("MariaShield")
		Goto Deselect

	PunchFlash:
		MESK A 0 A_JumpIfInventory("GreaseSuppressor",1,2)
		MEAK A 0
		"####" ABC 1
		"####" D 12
		"####" CBA 1
		MEAI B 0  A_JumpIfInventory("GreaseSuppressor",1,2)
		MEAI A 0
		MEAI "#" 1
		Goto LightDone
	}
}

Actor MariaGreaseLoaded: Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 31 //(30+1)
	Inventory.Icon ""
}