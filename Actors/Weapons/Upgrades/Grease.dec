//==============================================================================
// M3 Grease Gun
//==============================================================================
// Caliber: 9X19mm Parabelum / 9X18mm Makarov
//==============================================================================
// 
// 
// 
//
// 
//==============================================================================
Actor MariaGrease : MariaWeapon
{
   Weapon.AmmoType1 "MariaGreaseLoaded"
   Weapon.AmmoType2 "MariaLightClip"
   Weapon.AmmoGive2 64
   Weapon.Kickback 150
   //decal Bulletchip
   Tag "M3 Grease Gun"
   Inventory.PickupSound "Weapon/Greaser/Reload/Bolt/Back"
   //Weapon.upsound "Weapon/DualSMG/Select"
   Inventory.PickupMessage "M3 Grease Gun obtained! (Makarov Upgrade)"
   +WEAPON.AMMO_CHECKBOTH
   +WEAPON.NOALERT
   +WEAPON.NOAUTOFIRE
   +CHEATNOTWEAPON
   States
   {
 Spawn:
   AAYP A 1
   Loop
 Select:
   TNT1 AA 0 A_Raise
   Loop

 Deselect:
   TNT1 A 0 A_JumpIfInventory("GreaseSuppressor",1,"DeselectSilent")
   MEAD ABCDE 1
   TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
   TNT1 A 1
   Wait
 DeselectSilent:
   MESD ABCDE 1
   TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
   TNT1 A 1
   Wait

 Ready:
   TNT1 A 0 A_JumpIfInventory("GreaseSuppressor",1,"ReadySilent")
   TNT1 A 0 A_PlaySound("Maria/Draw/Primary")
   MEAS ABCDE 1
   Goto ReadyLoop
 ReadySilent:
   TNT1 A 0 A_PlaySound("Maria/Draw/Primary")
   MESS ABCDE 1
   Goto ReadyLoopSilent

 ReadyLoop:
   TNT1 A 0 A_JumpIfInventory("GreaseSuppressor",1,"ReadyLoopSilent")
   MEAI A 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
   loop
 ReadyLoopSilent:
   MEAI B 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD|WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
   loop
 Fire:
   TNT1 A 0 A_JumpIfInventory("GreaseSuppressor",1,"FireSilent")
   NULL A 0 A_JumpIfInventory("MariaGreaseLoaded", 1, 1)
   Goto dryfire
   TNT1 A 0 A_PlaySound("Weapon/Shinigami/Dry",0)
   MEAI A 1 Offset(0,33)
   MEAI A 1 Offset(0,34)
   MEAI A 1
 FireCounted:
   TNT1 A 0 A_JumpIfInventory("GreaseSuppressor",1,"FireCountedSilent")
   NULL A 0 A_JumpIfInventory("MariaGreaseLoaded", 1, 1)
   Goto dryfire
   MEAF A 1 BRIGHT 
   TNT1 A 0 A_FireBullets (1, 1, -1, 10, "MariaPuff")
   TNT1 A 0 A_TakeInventory("MariaGreaseLoaded", 1)
   TNT1 A 0 //A_WeaponOffset (random(-2,2),random(30,30), WOF_INTERPOLATE)
   TNT1 A 0 radius_quake (3, 2, 0, 1, 0)
   TNT1 A 0 A_JumpIf(CallACS("MagClicking")==1, "FireCountedNoclicking")
   TNT1 A 0 A_JumpIfInventory("MariaGreaseLoaded", 9, 2)
   TNT1 A 0 A_PlaySound("Weapon/Magclick", 1)
   //TNT1 A 0 A_SpawnItemEx("9mmBulletCasing", 17, 8, 32, FRandom(1, -2), FRandom(2, 4), FRandom(1, 3))
   TNT1 A 0 A_FireCustomMissile("MariaFlareOrange",0,0,0,8)
   TNT1 A 0 A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8)
   TNT1 A 0 //A_Recoil(0.1)
   TNT1 A 0 A_SetPitch(pitch-0.50) 
   NULL A 0 A_WeaponOffset(random(-1,1),32+random(0,1) )
   TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
   TNT1 A 0 A_Jump(256,2)
   TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
   TNT1 A 0 A_PlaySound("Weapon/Greaser/Fire", CHAN_AUTO)
   TNT1 A 0 A_PlaySound("Weapon/Greaser/Distant", 6)
   TNT1 A 0 A_AlertMonsters
   MEAF BCD 1
   MEAI A 0 A_ReFire("FireCounted")
   Goto ReadyLoop 
 FireCountedNoclicking:
   TNT1 A 0 A_JumpIfInventory("GreaseSuppressor",1,"FireCountedNoclickingSilent")
   NULL A 0 A_JumpIfInventory("MariaGreaseLoaded", 1, 1)
   Goto dryfire
   MEAF A 1 BRIGHT 
   TNT1 A 0 A_FireBullets (1, 1, -1, 10, "MariaPuff")
   TNT1 A 0 A_TakeInventory("MariaGreaseLoaded", 1)
   TNT1 A 0 //A_WeaponOffset (random(-2,2),random(30,30), WOF_INTERPOLATE)
   TNT1 A 0 radius_quake (3, 2, 0, 1, 0)
   //TNT1 A 0 A_SpawnItemEx("9mmBulletCasing", 17, 8, 32, FRandom(1, -2), FRandom(2, 4), FRandom(1, 3))
   TNT1 A 0 A_FireCustomMissile("MariaFlareOrange",0,0,0,8)
   TNT1 A 0 A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8)
   TNT1 A 0 //A_Recoil(0.1)
   TNT1 A 0 A_SetPitch(pitch-0.50) 
   NULL A 0 A_WeaponOffset(random(-1,1),32+random(0,1) )
   TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
   TNT1 A 0 A_Jump(256,2)
   TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
   TNT1 A 0 A_PlaySound("Weapon/Greaser/Fire", CHAN_AUTO)
   TNT1 A 0 A_PlaySound("Weapon/Greaser/Distant", 6)
   TNT1 A 0 A_AlertMonsters
   MEAF BCD 1
   MEAI A 0 A_ReFire("FireCountedNoclicking")
   Goto ReadyLoop 

 FireSilent:
   NULL A 0 A_JumpIfInventory("MariaGreaseLoaded", 1, 1)
   Goto SilentDryFire
   TNT1 A 0 A_PlaySound("Weapon/Shinigami/Dry",0)
   MEAI B 1 Offset(0,33)
   MEAI B 1 Offset(0,34)
   MEAI B 1
 FireCountedSilent:
   NULL A 0 A_JumpIfInventory("MariaGreaseLoaded", 1, 1)
   Goto SilentDryFire
   MESF A 1 
   TNT1 A 0 A_FireBullets (1, 1, -1, 15, "MariaPuff")
   TNT1 A 0 A_TakeInventory("MariaGreaseLoaded", 1)
   TNT1 A 0 //A_WeaponOffset (random(-2,2),random(30,30), WOF_INTERPOLATE)
   TNT1 A 0 radius_quake (3, 2, 0, 1, 0)
   TNT1 A 0 A_JumpIf(CallACS("MagClicking")==1, "FireCountedNoclicking")
   TNT1 A 0 A_JumpIfInventory("MariaGreaseLoaded", 9, 2)
   TNT1 A 0 A_PlaySound("Weapon/Magclick", 1)
   //TNT1 A 0 A_SpawnItemEx("9mmBulletCasing", 17, 8, 32, FRandom(1, -2), FRandom(2, 4), FRandom(1, 3))
   TNT1 A 0 A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8)
   TNT1 A 0 //A_Recoil(0.1)
   TNT1 A 0 A_SetPitch(pitch-0.50) 
   NULL A 0 A_WeaponOffset(random(-1,1),32+random(0,1) )
   TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
   TNT1 A 0 A_Jump(256,2)
   TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
   TNT1 A 0 A_PlaySound("Weapon/Greaser/Silenced", CHAN_AUTO)
   TNT1 A 0 A_PlaySound("Weapon/Greaser/Supressed/Distant", 6)
   TNT1 A 0 A_AlertMonsters(384)
   MESF BCD 1
   MEAI B 0 A_ReFire("FireCounted")
   Goto ReadyLoop 
 FireCountedNoclickingSilent:
   NULL A 0 A_JumpIfInventory("MariaGreaseLoaded", 1, 1)
   Goto SilentDryFire
   MESF A 1 
   TNT1 A 0 A_FireBullets (1, 1, -1, 15, "MariaPuff")
   TNT1 A 0 A_TakeInventory("MariaGreaseLoaded", 1)
   TNT1 A 0 //A_WeaponOffset (random(-2,2),random(30,30), WOF_INTERPOLATE)
   TNT1 A 0 radius_quake (3, 2, 0, 1, 0)
   //TNT1 A 0 A_SpawnItemEx("9mmBulletCasing", 17, 8, 32, FRandom(1, -2), FRandom(2, 4), FRandom(1, 3))
   TNT1 A 0 A_FireCustomMissile("MariaMuzzleSmoke",0,0,0,8)
   TNT1 A 0 //A_Recoil(0.1)
   TNT1 A 0 A_SetPitch(pitch-0.50) 
   NULL A 0 A_WeaponOffset(random(-1,1),32+random(0,1) )
   TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
   TNT1 A 0 A_Jump(256,2)
   TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
   TNT1 A 0 A_PlaySound("Weapon/Greaser/Silenced", CHAN_AUTO)
   TNT1 A 0 A_PlaySound("Weapon/Greaser/Supressed/Distant", 6)
   TNT1 A 0 A_AlertMonsters(384)
   MESF BCD 1
   MEAI B 0 A_ReFire("FireCountedNoclicking")
   Goto ReadyLoop 

 AltFire:
   MEAI A 0 A_JumpIfInventory("GreaseSuppressor",1,"SuppressorOut")
   MEAI A 0 A_GiveInventory("GreaseSuppressor")
   MEAI H 0 A_PrintBold ("Suppressor attaching.")
   MEAD ABCDE 1
   TNT1 A 5
   TNT1 A 0 A_PlaySound("Weapon/Pistol/Silencer/Attach")
   TNT1 A 10
   MESD EDCBA 1
   Goto ReadyLoopSilent
 SuppressorOut:
   SISG A 0 A_TakeInventory("GreaseSuppressor")
   SISG A 0 A_PrintBold ("Suppressor deattaching.")
   MESD ABCDE 1
   TNT1 A 5
   TNT1 A 0 A_PlaySound("Weapon/Pistol/Silencer/Deattach")
   TNT1 A 10
   MEAD EDCBA 1
   Goto ReadyLoop
		
 DryFire:
   TNT1 A 0 A_PlaySound("Weapon/SMG/Dry",1)
   TNT1 A 0 offset(0,36)
   MEAI A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
   TNT1 A 0 offset(0,35)
   MEAI A 10 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
   Goto ReadyLoop
 SilentDryFire:
   TNT1 A 0 A_PlaySound("Weapon/SMG/Dry",1)
   TNT1 A 0 offset(0,36)
   MEAI B 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
   TNT1 A 0 offset(0,35)
   MEAI B 10 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
   Goto ReadyLoop

 Reload:
   TNT1 A 0 A_JumpIfInventory("GreaseSuppressor",1,"ReloadSilent")
   TNT1 A 0 A_JumpIfInventory("MariaGreaseLoaded", 31, 2)
   TNT1 A 0 A_JumpIfInventory("MariaLightClip", 1, "ReloadWork")
   MEAI A 0 A_WeaponReady(WRF_NOFIRE)
   Goto ReadyLoop
 ReloadWork:
   TNT1 A 0 A_JumpIfInventory("GreaseSuppressor",1,"ReloadWorkSilent")
   TNT1 A 0 A_JumpIfInventory("MariaGreaseLoaded", 1,"ReloadWork2")
   TNT1 A 0 A_StartSound("Foley/PDW/Raise", CHAN_AUTO)
   MER1 ABCCDD 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   MER1 EFGG 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   //TNT1 A 0 A_StartSound("Foley/PDW/Mag/Out", CHAN_AUTO)
   TNT1 A 0 A_Playsound("Weapon/Greaser/Reload/Out", 1)
   MER1 HHIIJKMN 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   TNT1 A 0 A_SpawnItemEx("EmptyPistolMagazine", 17, 2, 35, 0, random(3,6), 4)
   MER1 O 4 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   TNT1 A 0 A_StartSound("Foley/MagPouch/Out", CHAN_AUTO)
   MER1 O 11 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   MER1 PQRS 1 
   MER1 STU 2 
   TNT1 A 0 A_Playsound("Weapon/Greaser/Reload/In", 2)
   //TNT1 A 0 A_StartSound("Foley/PDW/Mag/In", CHAN_AUTO)
   MER1 V 3 
   Goto ReloadingLoop    
 ReloadingLoop:
   TNT1 A 0 A_JumpIfInventory("GreaseSuppressor",1,"ReloadingLoopSilent")
   TNT1 A 0 A_TakeInventory("MariaLightClip", 1)
   TNT1 A 0 A_GiveInventory("MariaGreaseLoaded", 1)
   TNT1 A 0 A_JumpIfInventory("MariaGreaseLoaded", 30, "FinishReload")
   TNT1 A 0 A_JumpIfInventory("MariaLightClip", 1, "ReloadingLoop")		
   Goto FinishReload	 
 FinishReload:
   TNT1 A 0 A_JumpIfInventory("GreaseSuppressor",1,"FinishReloadSilent")
   MER1 WX 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   TNT1 A 0 A_StartSound("Foley/PDW/Lower", CHAN_AUTO)
   MER1 YZ 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   MER2 A 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   MER1 A 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)

   /*MER2 BCD 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   TNT1 A 0 A_Playsound("Weapon/Greaser/Reload/Bolt/Back", 2)
   MER2 DEEDCB 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)*/

   MEAI A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   Goto ReadyLoop

 ReloadWork2:
   TNT1 A 0 A_JumpIfInventory("GreaseSuppressor",1,"ReloadWork2Silent")
   TNT1 A 0 A_StartSound("Foley/PDW/Raise", CHAN_AUTO)
   MER1 ABCCDD 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   MER1 EFGG 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   //TNT1 A 0 A_StartSound("Foley/PDW/Mag/Out", CHAN_AUTO)
   TNT1 A 0 A_Playsound("Weapon/Greaser/Reload/Out", 1)
   MER1 HHIIJKMN 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   MER1 O 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)   
   TNT1 A 0 A_StartSound("Foley/MagPouch/In", CHAN_AUTO)
   MER1 O 5 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   TNT1 A 0 A_StartSound("Foley/MagPouch/Out", CHAN_AUTO)
   MER1 O 9 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   MER1 PQRS 1 
   MER1 STU 2 
   TNT1 A 0 A_Playsound("Weapon/Greaser/Reload/In", 2)
   //TNT1 A 0 A_StartSound("Foley/PDW/Mag/In", CHAN_AUTO)
   MER1 V 3 
   Goto ReloadingLoop2   
 ReloadingLoop2:
   TNT1 A 0 A_JumpIfInventory("GreaseSuppressor",1,"ReloadingLoop2Silent")
   TNT1 A 0 A_TakeInventory("MariaLightClip", 1)
   TNT1 A 0 A_GiveInventory("MariaGreaseLoaded", 1)
   TNT1 A 0 A_JumpIfInventory("MariaGreaseLoaded", 31, "FinishReload2")
   TNT1 A 0 A_JumpIfInventory("MariaLightClip", 1, "ReloadingLoop2")		
   Goto FinishReload2	 
 FinishReload2:
   TNT1 A 0 A_JumpIfInventory("GreaseSuppressor",1,"FinishReload2Silent")
   MER1 WX 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   TNT1 A 0 A_StartSound("Foley/PDW/Lower", CHAN_AUTO)
   MER1 YZ 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   MER2 A 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   MER1 A 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   MEAI A 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   Goto ReadyLoop

 ReloadSilent:
   TNT1 A 0 A_JumpIfInventory("MariaGreaseLoaded", 31, 2)
   TNT1 A 0 A_JumpIfInventory("MariaLightClip", 1, "ReloadWorkSilent")
   MEAI A 0 A_WeaponReady(WRF_NOFIRE)
   Goto ReadyLoopSilent
 ReloadWorkSilent:
   TNT1 A 0 A_JumpIfInventory("MariaGreaseLoaded", 1, "ReloadWork2Silent")
   TNT1 A 0 A_StartSound("Foley/PDW/Raise", CHAN_AUTO)
   SER1 ABCCDD 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   SER1 EFGG 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   //TNT1 A 0 A_StartSound("Foley/PDW/Mag/Out", CHAN_AUTO)
   TNT1 A 0 A_Playsound("Weapon/Greaser/Reload/Out", 1)
   SER1 HHIIJKMN 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   TNT1 A 0 A_SpawnItemEx("EmptyPistolMagazine", 17, 2, 35, 0, random(3,6), 4)
   SER1 O 4 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   TNT1 A 0 A_StartSound("Foley/MagPouch/Out", CHAN_AUTO)
   SER1 O 11 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   SER1 PQRS 1 
   SER1 STU 2 
   TNT1 A 0 A_Playsound("Weapon/Greaser/Reload/In", 2)
   //TNT1 A 0 A_StartSound("Foley/PDW/Mag/In", CHAN_AUTO)
   SER1 V 3 
   Goto ReloadingLoop    
 ReloadingLoopSilent:
   TNT1 A 0 A_TakeInventory("MariaLightClip", 1)
   TNT1 A 0 A_GiveInventory("MariaGreaseLoaded", 1)
   TNT1 A 0 A_JumpIfInventory("MariaGreaseLoaded", 30, "FinishReload")
   TNT1 A 0 A_JumpIfInventory("MariaLightClip", 1, "ReloadingLoop")		
   Goto FinishReload	 
 FinishReloadSilent:
   SER1 WX 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   TNT1 A 0 A_StartSound("Foley/PDW/Lower", CHAN_AUTO)
   SER1 YZ 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   SER2 A 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   SER1 A 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)

   /*SER2 BCD 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   TNT1 A 0 A_Playsound("Weapon/Greaser/Reload/Bolt/Back", 2)
   SER2 DEEDCB 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)*/

   MEAI B 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   Goto ReadyLoopSilent

 ReloadWork2Silent:
   TNT1 A 0 A_StartSound("Foley/PDW/Raise", CHAN_AUTO)
   SER1 ABCCDD 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   SER1 EFGG 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   //TNT1 A 0 A_StartSound("Foley/PDW/Mag/Out", CHAN_AUTO)
   TNT1 A 0 A_Playsound("Weapon/Greaser/Reload/Out", 1)
   SER1 HHIIJKMN 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   SER1 O 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)   
   TNT1 A 0 A_StartSound("Foley/MagPouch/In", CHAN_AUTO)
   SER1 O 5 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   TNT1 A 0 A_StartSound("Foley/MagPouch/Out", CHAN_AUTO)
   SER1 O 9 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   SER1 PQRS 1 
   SER1 STU 2 
   TNT1 A 0 A_Playsound("Weapon/Greaser/Reload/In", 2)
   //TNT1 A 0 A_StartSound("Foley/PDW/Mag/In", CHAN_AUTO)
   SER1 V 3 
   Goto ReloadingLoop2   
 ReloadingLoop2Silent:
   TNT1 A 0 A_TakeInventory("MariaLightClip", 1)
   TNT1 A 0 A_GiveInventory("MariaGreaseLoaded", 1)
   TNT1 A 0 A_JumpIfInventory("MariaGreaseLoaded", 31, "FinishReload2")
   TNT1 A 0 A_JumpIfInventory("MariaLightClip", 1, "ReloadingLoop2")		
   Goto FinishReload2	 
 FinishReload2Silent:
   SER1 WX 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   TNT1 A 0 A_StartSound("Foley/PDW/Lower", CHAN_AUTO)
   SER1 YZ 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   SER2 A 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   SER1 A 2 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   MEAI B 1 A_WeaponReady(WRF_NOFIRE|WRF_NOBOB)
   Goto ReadyLoopSilent

 ThrowPipebomb:
   TNT1 A 0 A_JumpIfInventory("GreaseSuppressor",1,"ThrowPipebombSilent")
   MEAD ABCDE 1
   TASQ ABC 1
   TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
   TASG DEH 1
   TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
   TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
   TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
   TASG KLM 1
   TASG OPQR 1 
   TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
   TAHA AB 1
   TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
   TNT1 A 0 A_Jump(256,2)
   TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
   TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
   TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
   TAHA CDE 1
   TNT1 A 5
   MEAS ABCDE 1
   Goto ReadyLoop
 ThrowPipebombSilent:
   MESD ABCDE 1
   TASQ ABC 1
   TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
   TASG DEH 1
   TNT1 A 0 A_TakeInventory("PipebombAmmo", 1)
   TASG I 1 A_PlayWeaponSound("Maria/Pipebomb/Miss",1)
   TASG J 1 A_PlaySound("Maria/Pipebomb/Ignite", 2)
   TASG KLM 1
   TASG OPQR 1 
   TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
   TAHA AB 1
   TNT1 A 0 A_JumpIfInventory("PowerQuadDamage",1,2)
   TNT1 A 0 A_Jump(256,2)
   TNT1 A 0 A_PlaySound("Maria/Powerup/Quad/Shoot",7)
   TNT1 A 0 A_PlaySound("Maria/Pipebomb/Throw", 3)
   TNT1 A 0 A_FireCustomMissile("HolyPipebomb",0,1,0,0)
   TAHA CDE 1
   TNT1 A 5
   MESS ABCDE 1
   Goto ReadyLoopSilent

  UseStimShot:
	TNT1 A 0 A_JumpIfHealthLower(100, 1)
	Goto FullHealth
    TNT1 A 0 A_JumpIfInventory("GreaseSuppressor",1,"UseStimShotSilent")
    MEAD ABCDEF 1
    SYRI AB 1
    TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
    SYRI CD 1
    SYRI EEFFGGG 1
    SYRI HIJKKLLL 1
    TNT1 A 0 A_PlaySound("Weapon/Syringe/Cap", 1)
    SYRI MNOPQQQRR 1
    TNT1 A 0 A_PlaySound("Weapon/Syringe/Tab", 1)
    SYRI STUUUVV 1
    TNT1 A 0 A_StartSound("Foley/Sleeves/Movement", CHAN_AUTO)
    SYRI WXYZ 1
    SYR2 AB 1
    TNT1 A 0 A_TakeInventory("MariaSyringeAmmo", 1)
    TNT1 A 0 A_PlaySound("Weapon/Syringe/Inject", 1)
    SYR2 CD 1
    TNT1 A 0 A_PlaySound("Weapon/Syringe/Heal", 2)
    TNT1 A 0 A_SetBlend("BLUE",.5,25)
    TNT1 A 0 HealThing(10, 100)
    TNT1 A 0 A_GiveInventory("SyringeProtection")
    TNT1 A 0 A_GiveInventory("SyringeRegeneration")
    SYR2 EFGHIJ 2
    SYR2 KLLMMN 1
    TNT1 A 5
    MEAS ABCDEF 1
    Goto ReadyLoop	
  FullHealth:
	TNT1 A 0 A_Print("You are healthy.")
