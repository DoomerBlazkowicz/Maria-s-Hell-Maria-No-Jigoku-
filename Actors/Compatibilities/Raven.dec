Actor MariaBerserkPortable : Custominventory
{
	+COUNTITEM
	+INVENTORY.INVBAR
    +INVENTORY.FANCYPICKUPSOUND
	Inventory.Icon "BERHA0"
	Inventory.MaxAmount 15
	Inventory.PickupMessage "Berserk added in your inventory!"
	tag "Berserk"
	States
	{
	Spawn:
    BERH A -1
	Stop
	Use:
	TNT1 A 0 A_SpawnItem("MariaBerserk")
	Stop
	}
}

