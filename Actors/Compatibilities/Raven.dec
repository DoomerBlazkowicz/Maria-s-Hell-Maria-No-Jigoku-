ACTOR MariaArtiTeleportOther : ArtiTeleportOther
{
    Inventory.PickupSound "misc/i_pkup"
	Inventory.MaxAmount 15
	Inventory.PickupMessage "Banishment Device added in your inventory!"
}

ACTOR MariaArtiTeleport : ArtiTeleport
{
    Inventory.PickupSound "misc/i_pkup"
	Inventory.MaxAmount 15
	Inventory.PickupMessage "Chaos Device added in your inventory!"
}

actor Salvate : ArtiTeleport
{
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.ALWAYSPICKUP
}

ACTOR MariaEgg : CustomInventory
{
	+COUNTITEM
	+INVENTORY.INVBAR
	Inventory.Icon "ARTIEGGC"
	Inventory.PickupMessage "A big EGG added in your inventory...?"
	Inventory.MaxAmount 15
	Tag "$TAG_ARTIEGG"
	States
	{
	Spawn:
		EGGC ABCB 6
		Loop
	Use:
		TNT1 A 0 A_FireCustomMissile("EggFX", -15, 0, 0, 0, 1)
		TNT1 A 0 A_FireCustomMissile("EggFX", -7.5, 0, 0, 0, 1)
		TNT1 A 0 A_FireCustomMissile("EggFX", 0, 0, 0, 0, 1)
		TNT1 A 0 A_FireCustomMissile("EggFX", 7.5, 0, 0, 0, 1)
		TNT1 A 0 A_FireCustomMissile("EggFX", 15, 0, 0, 0, 1)
		Stop
	}
}

ACTOR MariaWings : ArtiFly
{
    Inventory.PickupSound "misc/i_pkup"
	Inventory.MaxAmount 15
	Inventory.Icon "ANWIA0"
	Inventory.PickupMessage "Wings of Angel added in your inventory!"
	States
	{
	Spawn:
		ANWI ABCDCB 5
		Loop
    }
}

ACTOR MariaStimpackHeretic : Health //Replaces Stimpack
{
	Tag "Stimpack"
	Inventory.Amount 10
    Inventory.PickupSound "Maria/Health/Stimpack"
    Inventory.PickupMessage "$GOTSTIM"
	Health.LowMessage 25, "$GOTSTIMNEED"
	States
	{
	Spawn:
		HTIM A -1
		Stop
	}
}

ACTOR MariaMedikitHeretic : Health //Replaces Medikit
{
	Tag "Medikit"
    Inventory.PickupSound "Maria/Health/Medkit"
	Inventory.Amount 25
	Inventory.PickupMessage "$GOTMEDIKIT"
	Health.LowMessage 25, "$GOTMEDINEED"	
  	States
	{
	Spawn:
		HEDI A -1
		Stop
	}
}

ACTOR CosmobyteBombSpawner replaces ArtiPoisonBag //just so nobody uses an obvious name
{
	+DONTSPLASH
	+NOGRAVITY
	+NOINTERACTION
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("RKAmmoToggle")==0, "SpawnPipebomb")
		TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("RKAmmoToggle")==1, "SpawnGrenade")
		Goto Death
	SpawnPipebomb:
		TNT1 A 1 A_SpawnItem("PipebombAmmo",0,0,1,0)
		Goto Death
	SpawnGrenade:
		TNT1 A 1 A_SpawnItem("Slot5AmmoSpawnerA",0,0,1,0)
		Goto Death
	Death:
		TNT1 A 1
		Stop
	}
}