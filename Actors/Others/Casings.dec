ACTOR EmptyPistolMagazine
{
   Height 2
   Radius 2
   Speed 4
   Scale 0.75
   BounceType "Doom"
   +DOOMBOUNCE
   -BLOODSPLATTER
   +WINDTHRUST
   +CLIENTSIDEONLY
   +MOVEWITHSECTOR
   +MISSILE
   +NOBLOCKMAP
   -DROPOFF
   +NOTELEPORT
   +FORCEXYBILLBOARD
   +NOTDMATCH
   +GHOST
   +FLOORCLIP
   +THRUACTORS
   Mass 1
   BounceFactor 0.5
   SeeSound "Casing/Mag/Pistol"
   States
   {
   Spawn:
      TNT1 A 7
      EPMA ABCDEFGHABCDEFGHABCDEFGHABCDEFGHABCDEFGH 4
      Stop
   Death:
      TNT1 A 0
      TNT1 A 0 A_Jump(256,"Rest1","Rest2")
   Rest1:
      EPMA I 1
      Goto Lying
   Rest2:
      EPMA J 1
      Goto Lying
    Lying:
        "----" A -1
        Loop
   }
}

