//Spawners

ACTOR 9mmCasingSpawnerA
{
	Speed 20
	PROJECTILE
	+NOCLIP
	+CLIENTSIDEONLY
	States
	{
	Spawn:
        TNT1 A 0
		TNT1 A 1 A_CustomMissile("9mmBulletCasing",1,0,random(50,80),2,random(45,80))
		Stop
	}
}

ACTOR 9mmCasingSpawnerB : 9mmCasingSpawnerA
{
	States
	{
	Spawn:
        TNT1 A 0
		TNT1 A 1 A_CustomMissile("9mmBulletCasing",1,0,random(-50,-80),2,random(45,80))
		Stop
	}
}

