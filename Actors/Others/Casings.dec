///////////
//Casings//
///////////

ACTOR 9mmBulletCasing
{
   Height 2
   Radius 2
   Speed 8
   Scale 0.14
   +DOOMBOUNCE
   -BLOODSPLATTER
   +WINDTHRUST
   +CLIENTSIDEONLY
   +MOVEWITHSECTOR
   +MISSILE
   +NOBLOCKMAP
   -DROPOFF
   +NOTELEPORT
   +FORCEXYBILLBOARD
   +NOTDMATCH
   +GHOST
   +FLOORCLIP
   +THRUACTORS
   Mass 1
   BounceFactor 0.4
   SeeSound "Casing/Bullet/Light"
   States
   {
   Spawn:
      CAS2 ABCDEFGHIJKLMNOPABCDEFGHIJKLMNOP 2
      STOP
   Death:
       TNT1 A 0
       TNT1 A 0 A_Jump(256,"Rest1","Rest2","Rest3","Rest4")
    Rest1:
      CAS2 Q 1
      Goto Lying
    Rest2:
      CAS2 R 1
      Goto Lying
    Rest3:
      CAS2 S 1
      Goto Lying
    Rest4:
      CAS2 T 1
      Goto Lying
    Lying:
        "----" A -1
        Loop
   }
}

