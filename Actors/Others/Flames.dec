ACTOR MariaFlameTrails
{
    Game Doom
    Radius 1
    Height 1
    Speed 3
    Damage 0 
    +NOBLOCKMAP
    +NOTELEPORT
    +DONTSPLASH
    +MISSILE
    +FORCEXYBILLBOARD
    +CLIENTSIDEONLY
    +NOINTERACTION
    +NOCLIP
    RenderStyle Add
    DamageType Flames
    Scale 0.5
    Alpha 1
    Gravity 0
    States
    {
    Spawn:
        TNT1 A 1
        FRPR ABCDEFGH 3 BRIGHT
        Stop
    }
}

ACTOR MariaExplosionFlames: MariaFlameTrails
{
Scale 2.0
Speed 2
    States
    {
    Spawn:
        TNT1 AAA 0 A_CustomMissile ("MariaExplosionSmoke", 0, 0, random (0, 360), 2, random (0, 360))
        EXPL ABCDFGHI 2 BRIGHT
        Stop
    }
}

ACTOR MariaSmallExplosionFlames: MariaExplosionFlames
{
Scale 0.9
Speed 3
}

ACTOR MariaMediumExplosionFlames: MariaExplosionFlames
{
Scale 1.3
Speed 4
}


