ACTOR MariaKatanaSlash
{
   Radius 8
   Height 4
   Speed 50
   Damage 8
   PROJECTILE
   Renderstyle Add
   Alpha 0.75
   ReactionTime 15 //8
   DONTHURTSHOOTER
   Obituary "%k cleaved %o in half."
   DeathSound "Weapon/Sword/Projectile"
  +SEEKERMISSILE
  +RIPPER
  +EXTREMEDEATH
  +LOOKALLAROUND
  +FORCERADIUSDMG
   States
   {
	Spawn:
		//TNT1 A 0 A_SeekerMissile(20,30,SMF_LOOK|SMF_PRECISE)  
		BWAV A 1 bright A_SpawnItem("MariaKatanaSlashTrail",0,0)
		Loop
	Death:
		TNT1 A 0 A_StopSound(5)
		BWAV B 8 Bright A_Explode
		BWAV CD 8 bright A_FadeOut(0.10)
		Stop
	}
}

ACTOR MariaKatanaSlashTrail 
{ 
   Radius 8
   Height 16
   Speed 25
   Damage 0
   PROJECTILE
   RENDERSTYLE none
   ReactionTime 15
   Scale 0.5
   +RIPPER
   +FORCEXYBILLBOARD
   +CLIENTSIDEONLY
   States
   {
   Spawn:
      TNT1 A 0
      BWAV A 1 Bright A_FadeOut(0.10)
      Stop
   }
}

/////////////////////////////////
////////////Pipebomb/////////////
/////////////////////////////////

ACTOR HolyPipebomb
{
    Radius 4
    Height 8
    Speed 30	
	//Mass 9	
    Damage 3
	-NOGRAVITY
	+EXPLODEONWATER
    //+NOBLOCKMAP
    +MISSILE
    +ACTIVATEIMPACT
    +ACTIVATEPCROSS
    +NOTELEPORT
    +FORCEXYBILLBOARD
    +THRUGHOST
    +rollsprite
	//SeeSound "StunGun/Ignite"
	BounceType "Doom"
    BounceSound "TearBomb/Bounce"	
	BounceFactor 0.36
	WallBounceFactor 0.43
	BounceCount 3
    Gravity 0.7
	Obituary "$OB_GRENADE"
	DamageType Grenade
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Changevelocity(0,0,2,CVF_RELATIVE)
	Spawn2:
		PIPB ABCDEFGH 2 bright
		Loop
	Death:
        TNT1 A 0 A_JumpIf(CallACS("AntiTinnitus")==1, "NoRinging")
		PIPB AIJAIJAIJAIJAIJAIJAIJAIJAIJAIJAIJAIJ 2 bright
		GLXP A 0 Bright A_NoGravity
		TNT1 A 0 Radius_Quake (2, 54, 0, 15, 0)
		GLXP A 0 A_AlertMonsters
		//GLXP A 0 bright A_Explode(200,400)
		GLXP A 0 bright A_Explode(100,300)
		TNT1 A 0 A_CustomBulletAttack(180,100,FRandom(48,64),FRandom(2,10),"MariaPuff")
        TNT1 A 0 A_PlaySound("Maria/Pipebomb/Boom", CHAN_AUTO)
		TNT1 A 0 A_PlaySound("Maria/Explosion/Ear",5,1,0,1)
        TNT1 A 0 A_PlaySound("Maria/Explosion/Far", CHAN_AUTO)
		GLXP A 0 A_SetTranslucent(0.75,1)
		//GLXP A 1 bright
        TNT1 A 0 A_PlaySound("Maria/Explosion/Far", CHAN_ITEM)
		TNT1 A 0 A_SpawnItemEx("MariaShockWave")
        TNT1 AAAAAAAAAA 0 A_SpawnItemEx("MariaMediumExplosionFlames",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
        TNT1 AAAA 0 A_SpawnItemEx("MariaSmallExplosionFlames",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
        TNT1 AAAAAAAAAAAAAAA 0 A_SpawnItemEx("MariaExplosionSmoke",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
		stop
	NoRinging:
		PIPB AIJAIJAIJAIJAIJAIJAIJAIJAIJAIJAIJAIJ 2 bright
		GLXP A 0 Bright A_NoGravity
		TNT1 A 0 Radius_Quake (2, 54, 0, 15, 0)
		GLXP A 0 A_AlertMonsters
		//GLXP A 0 bright A_Explode(200,400)
		GLXP A 0 bright A_Explode(100,300)
		TNT1 A 0 A_CustomBulletAttack(180,100,FRandom(48,64),FRandom(2,10),"MariaPuff")
        TNT1 A 0 A_PlaySound("Maria/Pipebomb/Boom", CHAN_AUTO)
        TNT1 A 0 A_PlaySound("Maria/Explosion/Far", CHAN_AUTO)
		GLXP A 0 A_SetTranslucent(0.75,1)
		//GLXP A 1 bright
        TNT1 A 0 A_PlaySound("Maria/Explosion/Far", CHAN_ITEM)
		TNT1 A 0 A_SpawnItemEx("MariaShockWave")
        TNT1 AAAAAAAAAA 0 A_SpawnItemEx("MariaMediumExplosionFlames",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
        TNT1 AAAA 0 A_SpawnItemEx("MariaSmallExplosionFlames",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
        TNT1 AAAAAAAAAAAAAAA 0 A_SpawnItemEx("MariaExplosionSmoke",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
		stop
	XDeath:
        TNT1 A 0 A_JumpIf(CallACS("AntiTinnitus")==1, "NoRingingX")
		GLXP A 0 Bright A_NoGravity
		GLXP A 0 A_AlertMonsters
		TNT1 A 0 Radius_Quake (2, 54, 0, 15, 0)
		//GLXP A 0 bright A_Explode(200,400)
		GLXP A 0 bright A_Explode(100,300)
		TNT1 A 0 A_CustomBulletAttack(180,100,FRandom(48,64),FRandom(2,10),"MariaPuff")
		GLXP A 0 A_PlaySound("Pipebomb/Boom",CHAN_BODY)
		TNT1 A 0 A_PlaySound("Maria/Explosion/Ear",5,1,0,1)
        TNT1 A 0 A_PlaySound("Maria/Explosion/Far", 3)
		GLXP A 0 A_SetTranslucent(0.75,1)
		//GLXP A 1 bright
		TNT1 A 0 A_SpawnItemEx("MariaShockWave")
        TNT1 AAAAAAAAAA 0 A_SpawnItemEx("MariaMediumExplosionFlames",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
        TNT1 AAAA 0 A_SpawnItemEx("MariaSmallExplosionFlames",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
        TNT1 AAAAAAAAAAAAAAA 0 A_SpawnItemEx("MariaExplosionSmoke",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
		stop
	NoRingingX:
		GLXP A 0 Bright A_NoGravity
		GLXP A 0 A_AlertMonsters
		TNT1 A 0 Radius_Quake (2, 54, 0, 15, 0)	
		//GLXP A 0 bright A_Explode(200,400)
		GLXP A 0 bright A_Explode(100,300)
		TNT1 A 0 A_CustomBulletAttack(180,100,FRandom(48,64),FRandom(2,10),"MariaPuff")
		GLXP A 0 A_PlaySound("Pipebomb/Boom",CHAN_BODY)
        TNT1 A 0 A_PlaySound("Maria/Explosion/Far", 3)
		GLXP A 0 A_SetTranslucent(0.75,1)
		//GLXP A 1 bright
		TNT1 A 0 A_SpawnItemEx("MariaShockWave")
        TNT1 AAAAAAAAAA 0 A_SpawnItemEx("MariaMediumExplosionFlames",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
        TNT1 AAAA 0 A_SpawnItemEx("MariaSmallExplosionFlames",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
        TNT1 AAAAAAAAAAAAAAA 0 A_SpawnItemEx("MariaExplosionSmoke",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
		stop
	}
}

