Actor MariaCryoProjectile
{
	Radius 8
	Height 8
	Speed 25
    Gravity 0.15
	Damage 18
	Mass 9
	Projectile
	DamageType Ice
	RenderStyle Add
	//MaxStepHeight 9
    Alpha 0.75
    scale 0.50
	Alpha 1
    -NOGRAVITY
	+DROPOFF
	+NOBLOOD
    +NOTELEPORT
	+NOEXTREMEDEATH
	+BLOODLESSIMPACT
    +NOBOSSRIP
	States
	{
	Spawn:
		TNT1 A 0 NoDelay //A_SetScale(0.75)
		CRYO ABCD 2 Bright A_SpawnItem("MariaCyanPlasmaFlare", 0, 0)
		CRYO EFGH 2 Bright A_SpawnItem("MariaCyanPlasmaFlare", 0, 0)
		CRYO IJKL 1 Bright A_SpawnItem("MariaCyanPlasmaFlare", 0, 0)
		CRYO MN 1 Bright A_SpawnItem("MariaCyanPlasmaFlare", 0, 0)
        Stop
	Death:
        TNT1 A 0 //A_Explode(2,64)
		TNT1 A 0 //A_Fadeout(0.6)
		Stop	
	XDeath:
        TNT1 A 0 //A_Explode(2,64)
		TNT1 A 0 //A_Fadeout(0.6)
		Stop
		}
}

