    TNT1 A 0 A_SetScale (1.0)
    TNT1 A 0 A_Explode(6,50,1)
    TNT1 AAA 0 A_SpawnProjectile("MariaMiniSmoke", 1, 0, random(0, 360), CMF_AIMDIRECTION, random(0, -160))
	PLPE ABCDE 2 Bright
	Stop
