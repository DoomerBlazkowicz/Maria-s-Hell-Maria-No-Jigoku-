Actor MariaUnmakyrLaserTrail
{
Scale 0.2
Alpha 0.99
Renderstyle Add
+THRUACTORS
+CLIENTSIDEONLY
+NOBLOCKMAP
+NOGRAVITY
	States
	{
	Spawn:
		UNPR ABCD 1 Bright
		Stop
	Death:
		UNPR A 1 BRIGHT A_SetScale (0.55)
		UNPR B 1 BRIGHT A_SetScale (0.45)
		UNPR C 1 BRIGHT A_SetScale (0.35)
		UNPR D 1 BRIGHT A_SetScale (0.25)
		UNPR A 1 BRIGHT A_SetScale (0.15)
		UNPR B 1 BRIGHT A_SetScale (0.05)
		UNPR C 1 BRIGHT A_SetScale (0)
		Stop
	}
}

