ACTOR MariaPestilenceShot
{
   Radius 8
   Height 16
   Speed 100
   Damage 4
   PoisonDamage 32, 13, 45
   RENDERSTYLE ADD
   Scale 1.15
   ALPHA 0.67
   PROJECTILE
   +THRUGHOST
   Seesound "Weapon/Book/Pestilence/Active"
   DeathSound "Weapon/Book/Pestilence/Death"
   Decal "DoomImpScorch"
   States
   {
   Spawn:
      PES1 AAABBB 1 Bright A_SpawnItemEx("MariaPestilenceShotTrail",0,0,0,0,0,0,0,128,0)
      loop
   Death:
      TNT1 A 0 Bright A_Explode ( 3, 64 )
      PES1 CDEF 4 Bright
      stop
   }
}

ACTOR MariaPestilenceShotTrail
{   
   Radius 0
   Height 1
   PROJECTILE
   RENDERSTYLE ADD
   Scale 0.75
   ALPHA 0.75
   States
   {
