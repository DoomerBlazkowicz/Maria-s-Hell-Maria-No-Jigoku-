Actor MariaRocketPlayer : Rocket
{
	Radius 6
	Height 6
	Speed 120
	Damage 500
    Gravity 0.2
	Projectile
	//Scale 0.75
	SeeSound ""
	Obituary "$OB_MPROCKET"
	DamageType "Explosive"
    Damagetype "ExplosiveImpact"
    DamageType "Extreme"
	Decal "Scorch"
	+MISSILE 	
    //+DEHEXPLOSION
    +EXTREMEDEATH
    +BLOODSPLATTER 
	+FORCERADIUSDMG
    +THRUSPECIES
    +NODAMAGETHRUST
	States
	{
	Spawn:
		//TNT1 A 0 A_PlaySound("Rocket/Fly")	
	Live:
		RCKT A 1 Bright
        {
        //A_PlaySound("weapons/rocket/fly")
        A_SpawnItem("MariaRocketFlare", -20, 0);
        A_SpawnItem("MariaSmokeTrail", 0, 0);
		A_SpawnItem("MariaFlameTrails", 0, 0);
        }
		Loop
	Death:
        TNT1 A 0 A_JumpIf(CallACS("AntiTinnitus")==1, "NoRinging")
		TNT1 A 0 A_Explode(300,256,1,1,128)
		TNT1 A 0 Bright A_NoGravity
		TNT1 A 0 Bright radius_quake(11,20,0,1200,0)
		GLXP A 0 A_PlaySound("Weapon/Barrel/Explosion")
		TNT1 A 0 A_PlaySound("Maria/Explosion/Ear",5,1,0,1)
        TNT1 A 0 A_PlaySound("Maria/Explosion/Far", 3)
		//RCKT A 2 Bright 
        TNT1 A 0 A_SpawnItemEx ("DetectCeilCrater",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 A 0 A_SpawnItemEx("MariaShockWave")
		TNT1 A 0 A_RadiusThrust(128,-1,RTF_AFFECTSOURCE|RTF_NOIMPACTDAMAGE) 
        TNT1 A 0 A_SpawnItemEx ("MariaExplosionFlareSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
        TNT1 A 0 A_SpawnItemEx ("MariaExplosionFlareSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
        //TNT1 AAAAAAAAAA 0 A_SpawnItemEx("MariaMediumExplosionFlames",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
        TNT1 AAAAAAAAAA 0 A_CustomMissile("MariaMediumExplosionFlames", 0, 0, random (0, 360), 2, random (0, 360))
        TNT1 A 0 A_SpawnProjectile("MariaBarrelExplosionFlame")
        TNT1 AAAAAAAAAAAAAAA 0 A_SpawnItemEx("MariaExplosionSmoke",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
		Stop
	NoRinging:
		TNT1 A 0 A_Explode(300,256,1,1,128) 
		TNT1 A 0 Bright A_NoGravity
		TNT1 A 0 Bright radius_quake(11,20,0,1200,0) 
		GLXP A 0 A_PlaySound("Weapon/Barrel/Explosion")
        TNT1 A 0 A_PlaySound("Maria/Explosion/Far", 3)
		//RCKT A 2 Bright 
        TNT1 A 0 A_SpawnItemEx ("DetectCeilCrater",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 A 0 A_SpawnItemEx("MariaShockWave")
		TNT1 A 0 A_RadiusThrust(128,-1,RTF_AFFECTSOURCE|RTF_NOIMPACTDAMAGE) 
        TNT1 A 0 A_SpawnItemEx ("MariaExplosionFlareSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
        //TNT1 AAAAAAAAAA 0 A_SpawnItemEx("MariaMediumExplosionFlames",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
        TNT1 AAAAAAAAAA 0 A_CustomMissile("MariaMediumExplosionFlames", 0, 0, random (0, 360), 2, random (0, 360))
        TNT1 A 0 A_SpawnProjectile("MariaBarrelExplosionFlame")
        TNT1 AAAAAAAAAAAAAAA 0 A_SpawnItemEx("MariaExplosionSmoke",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
		Stop
      }
}

