ACTOR MariaGrimProjectile
{
  Radius 8
  Height 8
  Speed 999999999999999
  Damage 100
  Projectile
  +EXTREMEDEATH
  +ALLOWPARTICLES
  +PUFFONACTORS
  +FORCERADIUSDMG
  RenderStyle Add
  Alpha 0.75
  Obituary "%k taught %o about voodoo magic!"
  States
  {
  Spawn:
    TNT1 A 0 BRIGHT 
    Loop
  Death:
    TNT1 A 0 A_BFGSpray("MariaGrimSoul")
    TNT1 A 0 A_BFGSpray("MariaGrimSoul")
    TNT1 A 0 A_BFGSpray("MariaGrimSoul")
    TNT1 A 0 A_BFGSpray("MariaGrimSoul")	
    Stop
  }
}

ACTOR MariaGrimSoul
{
  +NOBLOCKMAP
  +NOGRAVITY
  RenderStyle Add
  Alpha 0.75
  DamageType "BFGSplash"
  States
  {
