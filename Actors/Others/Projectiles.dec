    TNT1 A 0 Bright A_StopSound(CHAN_BODY)
	TNT1 A 0 A_Explode(150, 180, 1, 1)
	TNT1 A 0 Bright radius_quake(7,16,0,960,0) 
	TNT1 A 0 A_PlaySound ("Weapon/RocketLauncher/Boom")
	TNT1 A 0 A_PlaySound("Maria/Explosion/Ear",5,1,0,1)
    TNT1 A 0 A_PlaySound("Maria/Explosion/Far", 3)
    TNT1 A 0 A_SpawnItemEx("MariaShockWave")
    TNT1 AAAAA 0 A_SpawnProjectile("MariaMediumExplosionFlames", 0, 0, random(0, 360), CMF_AIMDIRECTION, random(0, -360))
    TNT1 AAAAA 0 A_SpawnProjectile("MariaExplosionSmoke", 0, 0, random(0, 360), CMF_AIMDIRECTION, random(0, -360))
    Stop
  NoRinging:    
    TNT1 A 0 Bright A_StopSound(CHAN_BODY)
	TNT1 A 0 A_Explode(150, 180, 1, 1)
	TNT1 A 0 Bright radius_quake(7,16,0,960,0) 
	TNT1 A 0 A_PlaySound ("Weapon/RocketLauncher/Boom")
    TNT1 A 0 A_PlaySound("Maria/Explosion/Far", 3)
    TNT1 A 0 A_SpawnItemEx("MariaShockWave")
    TNT1 AAAAA 0 A_SpawnProjectile("MariaMediumExplosionFlames", 0, 0, random(0, 360), CMF_AIMDIRECTION, random(0, -360))
    TNT1 AAAAA 0 A_SpawnProjectile("MariaExplosionSmoke", 0, 0, random(0, 360), CMF_AIMDIRECTION, random(0, -360))
    Stop
  }
}

