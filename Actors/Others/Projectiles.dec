/////////////////////////////////
/////////////Famine//////////////
/////////////////////////////////

Actor MariaFamineCloud : FastProjectile
{
Radius 4
Height 4
Speed 120
Damage 0
MissileType "DarkCloudTrail3"
MissileHeight 8
Renderstyle Translucent
Alpha 0.7
DeathSound "Weapon/Book/DarkCloud/Impact"
Obituary "%o's soul was fed to %k's Dark Claw"
+SEEKERMISSILE
+EXTREMEDEATH
+NODAMAGETHRUST
+FORCERADIUSDMG
+FORCEXYBILLBOARD
States
	{
	Spawn:
    	TNT1 A 0 A_SeekerMissile(50, 65, SMF_LOOK | SMF_PRECISE)
		TNT1 A 1 A_SpawnItemEx("MariaFamineCloudTrail2",0,0,0,0,random(-1,1),random(-1,1))
		Loop
	Death:
		ECLD A 2
		{
		A_SetRenderstyle(0.7,STYLE_Translucent);
		A_StopSound(8);
		A_StartSound("Weapon/Book/DarkCloud/End",9);
		A_SpawnItemEx("MariaFamineCloudTrail",0,0,0,3,0,random(0,3),random(0,359));
		A_SpawnItemEx("MariaFamineCloudTrail",0,0,0,3,0,random(0,3),random(0,359));
		A_SpawnItemEx("MariaFamineCloudTrail",0,0,0,3,0,random(-3,0),random(0,359));
		A_SpawnItemEx("MariaFamineCloudTrail",0,0,0,3,0,random(-3,0),random(0,359));
		}
		ECLD BCDEFGHI 2
		Stop
	XDeath:
		TNT1 A 0 A_SetRenderstyle(1.0,STYLE_Add)
		TNT1 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 4 Bright
		{
		A_SpawnItemEx("MariaFamineCloudTrail",0,0,0,3,0,random(-1,1),random(0,359));
		A_SpawnItemEx("MariaFamineCloudTrail",0,0,0,3,0,random(-1,1),random(0,359));
		A_SpawnItemEx("MariaFamineCloudTrail2",0,0,0,3,0,random(-2,2),random(0,359),0,80);
		A_SpawnItemEx("MariaFamineCloudTrail3",0,0,0,3,0,random(-4,4),random(0,359),0,140);
		A_Explode(4,180,XF_NOSPLASH);
		A_Warp(AAPTR_TRACER,2,0,40,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE);
		A_StartSound("Weapon/Book/DarkCloud/Loop",8,CHANF_LOOPING,0.4);
		}
		ECLD A 2
		{
		A_SetRenderstyle(0.7,STYLE_Translucent);
		A_StopSound(8);
		A_StartSound("Weapon/Book/DarkCloud/End",9);
		A_SpawnItemEx("MariaFamineCloudTrail",0,0,0,3,0,random(0,3),random(0,359));
		A_SpawnItemEx("MariaFamineCloudTrail",0,0,0,3,0,random(0,3),random(0,359));
		A_SpawnItemEx("MariaFamineCloudTrail",0,0,0,3,0,random(-3,0),random(0,359));
		A_SpawnItemEx("MariaFamineCloudTrail",0,0,0,3,0,random(-3,0),random(0,359));
		}
		ECLD BCDEFGHI 2
		Stop
	}
}

Actor MariaFamineCloudTrail
{
+NOINTERACTION
+ROLLSPRITE
+ROLLCENTER
+FORCEXYBILLBOARD
Scale 0.6
Renderstyle Translucent
Alpha 0.5
States
