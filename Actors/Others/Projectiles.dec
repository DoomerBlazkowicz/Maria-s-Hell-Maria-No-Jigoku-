ACTOR MariaBFGBall : BFGBall //replaces BFGBall
{
  Speed 30
  Damage 300
  Height 19
  Radius 19	
  Damagetype "BFG"
  Decal "BFGScorch"
  +EXTREMEDEATH
  +FRIENDLY
  +NODAMAGETHRUST
  +FORCERADIUSDMG
  +MTHRUSPECIES
  ActiveSound "Weapon/BFG/Fly"
  DeathSound "Weapon/BFG/Explode"
  States
  {
  Spawn:
	BFGB ABCDE 2 Bright 
	{
		A_LoopActiveSound ;
		A_SpawnProjectile("MariaBFGAlpha",0,0,0,CMF_AIMDIRECTION|CMF_TRACKOWNER|CMF_OFFSETPITCH|CMF_ABSOLUTEANGLE,0,AAPTR_NULL);
        A_SpawnItem("MariaGreenFlareMedium");
		A_SpawnProjectile("MariaBFGAlpha",0,0,30,CMF_AIMDIRECTION|CMF_TRACKOWNER|CMF_OFFSETPITCH|CMF_ABSOLUTEANGLE,0,AAPTR_NULL);
        A_SpawnItem("MariaGreenFlareMedium");
		A_SpawnProjectile("MariaBFGAlpha",0,0,60,CMF_AIMDIRECTION|CMF_TRACKOWNER|CMF_OFFSETPITCH|CMF_ABSOLUTEANGLE,0,AAPTR_NULL);
        A_SpawnItem("MariaGreenFlareMedium");
		A_SpawnProjectile("MariaBFGAlpha",0,0,90,CMF_AIMDIRECTION|CMF_TRACKOWNER|CMF_OFFSETPITCH|CMF_ABSOLUTEANGLE,0,AAPTR_NULL);
        A_SpawnItem("MariaGreenFlareMedium");
		A_SpawnProjectile("MariaBFGAlpha",0,0,120,CMF_AIMDIRECTION|CMF_TRACKOWNER|CMF_OFFSETPITCH|CMF_ABSOLUTEANGLE,0,AAPTR_NULL);
        A_SpawnItem("MariaGreenFlareMedium");
		A_SpawnProjectile("MariaBFGAlpha",0,0,150,CMF_AIMDIRECTION|CMF_TRACKOWNER|CMF_OFFSETPITCH|CMF_ABSOLUTEANGLE,0,AAPTR_NULL);
        A_SpawnItem("MariaGreenFlareMedium");
		A_SpawnProjectile("MariaBFGAlpha",0,0,180,CMF_AIMDIRECTION|CMF_TRACKOWNER|CMF_OFFSETPITCH|CMF_ABSOLUTEANGLE,0,AAPTR_NULL);
        A_SpawnItem("MariaGreenFlareMedium");
		A_SpawnProjectile("MariaBFGAlpha",0,0,210,CMF_AIMDIRECTION|CMF_TRACKOWNER|CMF_OFFSETPITCH|CMF_ABSOLUTEANGLE,0,AAPTR_NULL);
        A_SpawnItem("MariaGreenFlareMedium");
		A_SpawnProjectile("MariaBFGAlpha",0,0,240,CMF_AIMDIRECTION|CMF_TRACKOWNER|CMF_OFFSETPITCH|CMF_ABSOLUTEANGLE,0,AAPTR_NULL);
        A_SpawnItem("MariaGreenFlareMedium");
		A_SpawnProjectile("MariaBFGAlpha",0,0,270,CMF_AIMDIRECTION|CMF_TRACKOWNER|CMF_OFFSETPITCH|CMF_ABSOLUTEANGLE,0,AAPTR_NULL);
        A_SpawnItem("MariaGreenFlareMedium");
		A_SpawnProjectile("MariaBFGAlpha",0,0,300,CMF_AIMDIRECTION|CMF_TRACKOWNER|CMF_OFFSETPITCH|CMF_ABSOLUTEANGLE,0,AAPTR_NULL);
        A_SpawnItem("MariaGreenFlareMedium");
	}
    Loop
  Death:
    TNT1 A 0 A_JumpIf(CallACS("AntiTinnitus")==1, "NoRinging")
	BFE1 A 0 BRIGHT //A_Explode(1024,192)
    TNT1 A 0 radius_quake(11,20,0,1200,0)
    BFE1 A 0 Bright //A_Explode
	TNT1 A 0 A_PlaySound("Maria/Explosion/Ear",5,1,0,1)
    TNT1 AAAA 0 A_BFGSpray("MariaBFGExtra",255,200)    
    TNT1 AAAAAAAA 0 A_BFGSpray("MariaBFGExtra")    
	TNT1 A 0 A_SpawnItemEx("MariaShockWave")
    /*TNT1 AAAAA 0 A_SpawnProjectile("MariaBFGFlames", 0, 0, random(0, 360), CMF_AIMDIRECTION, random(0, -360))*/
    TNT1 AAAAA 0 A_SpawnProjectile("MariaExplosionSmoke", 0, 0, random(0, 360), CMF_AIMDIRECTION, random(0, -360))
    TNT1 A 0 A_SetScale(1.5)
	BFBE ABCDE 2 bright A_SpawnItem("MariaGreenFlare")
	BFBE F 4 bright A_SpawnItem("MariaGreenFlare")
	BFBE GHIJK 3 bright
    Stop
  NoRinging:
	BFE1 A 0 BRIGHT //A_Explode(1024,192)
    TNT1 A 0 radius_quake(11,20,0,1200,0)
    BFE1 A 0 Bright //A_Explode
    TNT1 AAAAAAAA 0 A_BFGSpray("MariaBFGExtra",255,200)    
    //TNT1 AAAAAAAA 0 A_BFGSpray("MariaBFGExtra")    
	TNT1 A 0 A_SpawnItemEx("MariaShockWave")
    /*TNT1 AAAAA 0 A_SpawnProjectile("MariaBFGFlames", 0, 0, random(0, 360), CMF_AIMDIRECTION, random(0, -360))*/
    TNT1 AAAAA 0 A_SpawnProjectile("MariaExplosionSmoke", 0, 0, random(0, 360), CMF_AIMDIRECTION, random(0, -360))
    TNT1 A 0 A_SetScale(1.5)
	BFBE ABCDE 2 bright A_SpawnItem("MariaGreenFlare")
	BFBE F 4 bright A_SpawnItem("MariaGreenFlare")
	BFBE GHIJK 3 bright A_SpawnItem("MariaGreenFlare")
    Stop
  }
}

