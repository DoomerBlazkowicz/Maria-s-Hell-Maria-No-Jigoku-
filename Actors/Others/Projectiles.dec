	SPI1 A 2 A_SeekerMissile(17, 17, SMF_LOOK | SMF_PRECISE)
	SPI1 B 2 A_SeekerMissile(17, 17, SMF_LOOK | SMF_PRECISE)
	SPI1 C 2 A_SeekerMissile(17, 17, SMF_LOOK | SMF_PRECISE)
	SPI1 D 2 A_SeekerMissile(17, 17, SMF_LOOK | SMF_PRECISE)
    Loop
  Death:
    SPI1 EFGHIJKLMNO 2
    Stop
  }
}   

