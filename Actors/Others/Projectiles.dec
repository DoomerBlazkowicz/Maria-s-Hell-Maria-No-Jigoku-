  SeeSound "Weapons/Grimoire/Spirits/Active"
  DeathSound "Weapons/Grimoire/Spirits/Death"
  +SeekerMissile
  +ScreenSeeker
  +Ripper
  -BloodSplatter
  +BloodlessImpact
  -ThruGhost
  Projectile
  States
  {
