/////////////////////////////////
//////////////Arrow//////////////
/////////////////////////////////

ACTOR MariaArrowMissile : FastProjectile //For Crossbow
{
	Radius 2
	Height 4
	Damage 30
    Gravity 0.2
	DamageType "Bleeding"
	PoisonDamage 14, 6, 45
	Speed 150
	PROJECTILE
    +DROPOFF
	-NOGRAVITY
	+STRIFEDAMAGE
	+BLOODSPLATTER
	+NOEXTREMEDEATH
	+ADDITIVEPOISONDAMAGE
	+ADDITIVEPOISONDURATION
	+PIERCEARMOR
	States
	{
		Spawn:
			ARWP A 1 A_SpawnItem("MariaArrowTrail", 0, 0)
			Loop
		Death:
		Crash:
			NLPJ B 3 A_PlaySound("Weapon/Crossbow/Arrow/Hit")
            TNT1 A 0 A_SetScale(0.3)
	        TNT1 A 0 A_SetTranslucent(0.8)	  
            MUFF AABCDE 1 BRIGHT
			Stop
		XDeath:
			TNT1 A 10 A_PlaySound("Weapon/Crossbow/Arrow/Splatter")
			Stop
	}
}

ACTOR MariaArrowMissile2 : MariaArrowMissile //For Oscillator
{
	Radius 2
	Height 4
	Damage 35
	DamageType "Bleeding"
	PoisonDamage 2, 2, 5
	Speed 150
}


Actor MariaArrowTrail
{
  +ForceXYBillBoard
  +NoInteraction
  Radius 4
  Height 8
  Renderstyle "Add"
  Alpha 0.75
  //Scale 0.65
  States
  {
  Spawn:
    ARTR ABCDEF 1 Bright
    Stop
  }
}

/////////////////////////////////
///////////Grenades//////////////
/////////////////////////////////

ACTOR ShinigamiGrenade //From removed Shinigami, now serves as a base for Grenades
{
	Radius 5
	Height 5
    Speed 60	
	//Mass 9	
    Damage (random(102,120))
    //+NOBLOCKMAP
    //+DROPOFF
    +MISSILE
    +ACTIVATEIMPACT
    +ACTIVATEPCROSS
    +NOTELEPORT
    +FORCEXYBILLBOARD
    +THRUGHOST
	BounceSound "Weapon/Shinigami/Grenade/Bounce"
    Gravity 0.7
    ReactionTime 139
	DeathSound "Weapon/RocketLauncher/Boom"
	Obituary "$OB_GRENADE"
	DamageType "UGL"
	DamageType Grenade
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Changevelocity(0,0,2,CVF_RELATIVE)
	Spawn2:
		HLGR AA 2 bright //A_CountDown
		Loop
	Death:
        TNT1 A 0 A_JumpIf(CallACS("AntiTinnitus")==1, "NoRinging")
		GLXP A 0 Bright A_NoGravity
		TNT1 A 0 Bright radius_quake(7,24,0,960,0)
		GLXP A 0 bright A_Explode(128,256)
		GLXP A 0 A_SetTranslucent(0.75,1)
		//RCKT A 2 Bright 
		TNT1 A 0 A_PlaySound("Maria/Explosion/Ear",5,1,0,1)
		TNT1 A 0 A_SpawnItemEx("MariaShockWave")
        TNT1 AAAAAAAAAA 0 A_SpawnItemEx("MariaMediumExplosionFlames",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
        TNT1 AAAAAAAAAAAAAAA 0 A_SpawnItemEx("MariaExplosionSmoke",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
		stop
	NoRinging:
		GLXP A 0 Bright A_NoGravity
		TNT1 A 0 Bright radius_quake(7,24,0,960,0)
		GLXP A 0 bright A_Explode(128,256,1,1)
		GLXP A 0 A_SetTranslucent(0.75,1)
		//RCKT A 2 Bright 
		TNT1 A 0 A_SpawnItemEx("MariaShockWave")
        TNT1 AAAAAAAAAA 0 A_SpawnItemEx("MariaMediumExplosionFlames",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
        TNT1 AAAAAAAAAAAAAAA 0 A_SpawnItemEx("MariaExplosionSmoke",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
		stop
	}
}

ACTOR MariaGrenadeLauncherGrenade : ShinigamiGrenade //For Thumper
{
    Speed 80	
    Damage 225
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Changevelocity(0,0,2,CVF_RELATIVE)
	Spawn2:
		HLGR AA 2 bright //A_CountDown
		Loop
	Death:
        TNT1 A 0 A_JumpIf(CallACS("AntiTinnitus")==1, "NoRinging")
		GLXP A 0 Bright A_NoGravity
		TNT1 A 0 Bright radius_quake(7,16,0,960,0)
		GLXP A 0 bright A_Explode(200,192,1,1)
		GLXP A 0 A_SetTranslucent(0.75,1)
		//RCKT A 2 Bright 
		TNT1 A 0 A_PlaySound("Maria/Explosion/Ear",5,1,0,1)
		TNT1 A 0 A_SpawnItemEx("MariaShockWave")
        TNT1 AAAAAAAAAA 0 A_SpawnItemEx("MariaMediumExplosionFlames",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
        TNT1 AAAAAAAAAAAAAAA 0 A_SpawnItemEx("MariaExplosionSmoke",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
		stop
	NoRinging:
		GLXP A 0 Bright A_NoGravity
		TNT1 A 0 Bright radius_quake(7,16,0,960,0)
		GLXP A 0 bright A_Explode(200,256,1,1)
		GLXP A 0 A_SetTranslucent(0.75,1)
		//RCKT A 2 Bright 
		TNT1 A 0 A_SpawnItemEx("MariaShockWave")
        TNT1 AAAAAAAAAA 0 A_SpawnItemEx("MariaMediumExplosionFlames",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
        TNT1 AAAAAAAAAAAAAAA 0 A_SpawnItemEx("MariaExplosionSmoke",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
		stop
	}
}

ACTOR MariaMicroRocket : ShinigamiGrenade //For Micro Rocket Launcher 
{
    Gravity 0.3
    Speed 100	
    Damage 225
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Changevelocity(0,0,2,CVF_RELATIVE)
	Spawn2:
		HLGR A 1 Bright
        {
        //A_PlaySound("weapons/rocket/fly")
        A_SpawnItem("MariaRocketFlare", -20, 0);
        A_SpawnItem("MariaSmokeTrail", 0, 0);
		A_SpawnItem("MariaFlameTrails", 0, 0);
        }
		Loop
	Death:
        TNT1 A 0 A_JumpIf(CallACS("AntiTinnitus")==1, "NoRinging")
		GLXP A 0 Bright A_NoGravity
		TNT1 A 0 Bright radius_quake(7,16,0,960,0)
		GLXP A 0 bright A_Explode(200,256,1,1)
		GLXP A 0 A_SetTranslucent(0.75,1)
		//RCKT A 2 Bright 
		TNT1 A 0 A_PlaySound("Maria/Explosion/Ear",5,1,0,1)
		TNT1 A 0 A_SpawnItemEx("MariaShockWave")
        TNT1 AAAAAAAAAA 0 A_SpawnItemEx("MariaMediumExplosionFlames",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
        TNT1 AAAAAAAAAAAAAAA 0 A_SpawnItemEx("MariaExplosionSmoke",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
		stop
	NoRinging:
		GLXP A 0 Bright A_NoGravity
		TNT1 A 0 Bright radius_quake(7,16,0,960,0)
		GLXP A 0 bright A_Explode(200,256,1,1)
		GLXP A 0 A_SetTranslucent(0.75,1)
		//RCKT A 2 Bright 
		TNT1 A 0 A_SpawnItemEx("MariaShockWave")
        TNT1 AAAAAAAAAA 0 A_SpawnItemEx("MariaMediumExplosionFlames",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
        TNT1 AAAAAAAAAAAAAAA 0 A_SpawnItemEx("MariaExplosionSmoke",0,0,0,Random(-10,10),Random(-10,10),Random(-10,10))
		stop
	}
}

/////////////////////////////////
///////////FlameTracer///////////
/////////////////////////////////

ACTOR MariaFlameTracer : FastProjectile
{
	Alpha 0.90
	RenderStyle Add
	Radius 2
	Height 2
	Speed 100
    Damage 15
	PROJECTILE
    +THRUGHOST
    +THRUSPECIES
    +NOTIMEFREEZE
    +NOEXTREMEDEATH
    +BLOODSPLATTER
    //DamageType Bullet
	DamageType Fire
	MissileHeight 8
	Decal BulletChip
	DeathSound "booletricochet"
	States
	{
	Spawn:
		INCB A 1 BRIGHT
        {
        A_SpawnItem("MariaFlameBulletFlare", 0, 0);
		A_SpawnItem("MariaFlameTracerTrail", 0, 0);
        }
		Loop
	Death:
		PUFF A 0 BRIGHT
	Crash:
        TNT1 A 0 A_SetScale(0.3)
	    TNT1 A 0 A_SetTranslucent(0.8)
        TNT1 A 0 A_PlaySound("booletricochet")	  
        MUFF AABCDE 1 BRIGHT
		Stop
	XDeath:
		TNT1 A 3 A_PlaySound("hitflesh")
		Stop
	}
}

ACTOR MariaFlameTracerTrail
{
    +ForceXYBillBoard
    +NoInteraction
    Radius 4
    Height 8
	RenderStyle Add
	Alpha 0.50
    Scale 0.15
	States
	{
		Spawn:
			FRPR ABCDEFG 2 BRIGHT
			Stop
	}
}

ACTOR MariaDragonsBreathTracer : MariaFlameTracer //For USAS-12
{
    Damage 7
}

ACTOR MariaFlameArrowMissile : MariaArrowMissile //For Oscillator
{
	Radius 2
	Height 4
	Damage (random(30,60))
    Gravity 0.2
	DamageType Fire
	//PoisonDamage 14, 6, 45
	Speed 150
	PROJECTILE
    +DROPOFF
	-NOGRAVITY
	+STRIFEDAMAGE
	+BLOODSPLATTER
	+NOEXTREMEDEATH
	-ADDITIVEPOISONDAMAGE
	-ADDITIVEPOISONDURATION
	+PIERCEARMOR
	States
	{
		Spawn:
			AROP A 1
            {
            A_SpawnItem("MariaFlameBulletFlare", 0, 0);
	    	A_SpawnItem("MariaFlameTracerTrail", 0, 0);
            }
			Loop
	}
}

