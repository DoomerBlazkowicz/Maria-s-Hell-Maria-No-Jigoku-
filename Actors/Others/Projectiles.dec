Actor MariaSprayFlame //For Aerosol Can
{
    Radius 2
    Height 2
    Speed 20
	Damage 1
	Projectile	
	RenderStyle add
    Gravity 0
    Scale 0.3
	alpha 1
	DamageType "Fire"
    PoisonDamage 7, 10, 5
    Obituary "%o was incinerated by %k."
	Decal "Scorch"
	Projectile
    +NOBLOCKMAP
    +NOTELEPORT
    +DONTSPLASH
	+MISSILE
	+FORCEXYBILLBOARD
	+STRIFEDAMAGE
	-RIPPER
	+NOBLOOD
	+NOBLOODDECALS
	+BLOODLESSIMPACT
	-BLOODSPLATTER
	States
	{
	Spawn:
     HONO A 1 Bright
     TNT1 A 0 A_Explode(1, 100, 0)
     HONO B 1 Bright
     TNT1 A 0 A_Explode(1, 100, 0)
     HONO C 1 Bright
     TNT1 A 0 A_Explode(1, 100, 0)
     HONO D 1 Bright
     TNT1 A 0 A_Explode(1, 100, 0)
     HONO E 1 Bright
     TNT1 A 0 A_Explode(1, 100, 0)
     HONO F 1 Bright
     TNT1 A 0 A_Explode(1, 100, 0)
     HONO G 1 Bright 
     TNT1 A 0 A_Explode(1, 100, 0)
     HONO H 1 Bright 
     TNT1 A 0 A_Explode(1, 100, 0)
     HONO I 1 Bright 
     TNT1 A 0 A_Explode(1, 100, 0)
     HONO J 1 Bright 
     TNT1 A 0 A_Explode(1, 100, 0)
     HONO K 1 Bright 
     TNT1 A 0 A_Explode(1, 100, 0)
     HONO L 1 Bright 
     TNT1 A 0 A_Explode(1, 100, 0)
     HONO M 1 Bright 
     TNT1 A 0 A_Explode(1, 100, 0)
     HONO N 1 Bright 
     TNT1 A 0 A_Explode(1, 100, 0)
     HONO O 1 Bright 
     TNT1 A 0 A_Explode(1, 100, 0)
     HONO P 1 Bright 
     TNT1 A 0 A_Explode(1, 100, 0)
	stop
   Death:
 	 HONO ABCDEFGHIJKLMNOP 1 Bright
     TNT1 A 0 A_Explode(1, 50)
      stop
	}
}

