Actor MariaGasGrenade
{
  Radius 3
  Height 9
  Speed 75
  Damage 1
  PROJECTILE
  -BOUNCEONACTORS
  +EXPLODEONWATER
  +NOEXTREMEDEATH
  -NOGRAVITY
  BounceFactor 0.65
  WallBounceFactor 0.7
  Bouncetype Hexen
  BounceCount 1
  ReactionTime 115
  BounceSound "TearBomb/Bounce"	
  Deathsound "TearBomb/Gas"
  States
  {
  Spawn:
    SHGR A 0 A_CountDown		
    SHGR A 2 A_CustomMissile("", 3, 0, 0, 1)	 
	SHGR A 0 A_JumpIf(waterlevel >= 2, "DeepWater")
    Loop
  Death:
    //TNT1 A 0 Radius_Quake (2, 54, 0, 15, 0)
	TNT1 AAAAA 1 A_CustomMissile ("MariaGasCloudMissile", 2, 0, random (0, 360), 2, random (0, 360))
    TNT1 AAAAAAAAA 2 A_CustomMissile ("MariaGasCloudFake", 2, 0, random (0, 360), 2, random (0, 360))
	TNT1 AAAAA 1 A_CustomMissile ("MariaGasCloudMissile", 2, 0, random (0, 360), 2, random (0, 360))
	TNT1 AAAAAAAAA 2 A_CustomMissile ("MariaGasCloudFake", 2, 0, random (0, 360), 2, random (0, 360))
	TNT1 AAAAA 1 A_CustomMissile ("MariaGasCloudMissile", 2, 0, random (0, 360), 2, random (0, 360))
	TNT1 AAAAAAAAA 2 A_CustomMissile ("MariaGasCloudFake", 2, 0, random (0, 360), 2, random (0, 360))
	TNT1 AAAAA 1 A_CustomMissile ("MariaGasCloudMissile", 2, 0, random (0, 360), 2, random (0, 360))
	TNT1 AAAAAAAAA 2 A_CustomMissile ("MariaGasCloudFake", 2, 0, random (0, 360), 2, random (0, 360))
	TNT1 AAAAA 1 A_CustomMissile ("MariaGasCloudMissile", 2, 0, random (0, 360), 2, random (0, 360))
	TNT1 AAAAAAAAA 2 A_CustomMissile ("MariaGasCloudFake", 2, 0, random (0, 360), 2, random (0, 360))
	TNT1 AAAAA 1 A_CustomMissile ("MariaGasCloudMissile", 2, 0, random (0, 360), 2, random (0, 360))
	TNT1 AAAAAAAAA 2 A_CustomMissile ("MariaGasCloudFake", 2, 0, random (0, 360), 2, random (0, 360))
	TNT1 AAAAA 1 A_CustomMissile ("MariaGasCloudMissile", 2, 0, random (0, 360), 2, random (0, 360))
	TNT1 AAAAAAAAA 2 A_CustomMissile ("MariaGasCloudFake", 2, 0, random (0, 360), 2, random (0, 360))
	TNT1 AAAAA 1 A_CustomMissile ("MariaGasCloudMissile", 2, 0, random (0, 360), 2, random (0, 360))
	TNT1 AAAAAAAAA 2 A_CustomMissile ("MariaGasCloudFake", 2, 0, random (0, 360), 2, random (0, 360))
	TNT1 AAAAA 1 A_CustomMissile ("MariaGasCloudMissile", 2, 0, random (0, 360), 2, random (0, 360))
	TNT1 AAAAAAAAA 2 A_CustomMissile ("MariaGasCloudFake", 2, 0, random (0, 360), 2, random (0, 360))
	TNT1 AAAAA 1 A_CustomMissile ("MariaGasCloudMissile", 2, 0, random (0, 360), 2, random (0, 360))
	TNT1 AAAAAAAAA 2 A_CustomMissile ("MariaGasCloudFake", 2, 0, random (0, 360), 2, random (0, 360))
    Stop
  DeepWater:
    SHGR A 0 A_ScaleVelocity(0.5)
    SHGR A 0 A_PlaySound("TearBomb/End")
    SHGR AAA 6
	SHGR AAAAAAAAAAAAAAAAAAA 1 A_FadeOut( 0.05 )
	SHGR A 1 A_FadeOut( 1 )
	SHGR A -1
    stop
  }
}

ACTOR MariaGasCloudMissile
