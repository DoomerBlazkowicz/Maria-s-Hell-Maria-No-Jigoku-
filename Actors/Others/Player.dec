Actor MariaPlayer : PlayerPawn 
{
  Player.ForwardMove 1.0
  Player.SideMove 1.0
  Health 100
  Radius 16
  Height 56
  Mass 100
  Player.jumpz 10 
  PainChance 256
  Player.DisplayName "Pistol Start"
  Player.Face "MOM"
  //+SOLID
  //+MTHRUSPECIES
  //+DONTHURTSPECIES
  //+THRUGHOST
  //+THRUSPECIES
  //-NOSKIN
  Player.Soundclass "MariaPlayer"  
  Player.StartItem "MariaCrackKnucklesA"
  Player.StartItem "MariaPistol"
  Player.StartItem "MariaKnife"
  Player.StartItem "PipebombAmmo", 2
  Player.StartItem "MariaRevolverLoaded", 6
  Player.StartItem "MariaCrossbowLoaded", 1
  Player.StartItem "MariaPistolLoaded", 8
  Player.StartItem "MariaShotgunLoaded", 8
  Player.StartItem "MariaBoomstickAmmo", 2
  Player.StartItem "MariaUsasLoaded", 20
  Player.StartItem "MariaShinigamiLoaded", 30
  Player.StartItem "MariaLMGLoaded", 100
  Player.StartItem "MariaBizonLoaded", 64
  Player.StartItem "MariaMP5Loaded", 30
  Player.StartItem "MariaSniperLoaded", 10
  Player.StartItem "MariaThumperLoaded", 1
  Player.StartItem "MariaMicroRocketLauncherLoaded", 6
  Player.StartItem "MariaPlasmaRifleLoaded", 50
  Player.StartItem "MariaRocketLauncherLoaded", 1
  Player.StartItem "MariaLightClip", 50
  Player.Portrait "CLASS1"
  DamageFactor "ExplosiveBarrel", 0.3
  DamageFactor "UGL", 0.3
  DamageFactor "BFG", 0.1
  DamageFactor "PoisonDamage", 0.1
  DamageFactor "MariaGasCloudSpawner", 0.1
  DamageFactor "MariaGasCloudMissile", 0.1
  DamageFactor "NewBFGTurn", 0.1
  DamageFactor "PlayerTaser", 0.1
  DamageFactor "NopainforBFG", 0.0
	States
	{
	Spawn:
		PFSC A 1
		Goto Standstill //Loop	
	Standstill:	
        PFSI A 1
		Loop
	See:
		PFSC ABCD 4		
		Loop
	Missile:
		PFSC E 12
		Goto Spawn
	Melee:
		PFSC F 6 BRIGHT
		Goto Missile
	Pain:
		PFSC G 4
		PFSC G 4 A_Pain
		Goto Spawn
	Death:
		PFSC H 0 A_PlayerSkinCheck("AltSkinDeath")
	Death1:
		PFSC H 10
		PFSC I 10 A_PlayerScream
		PFSC J 10 A_NoBlocking
		PFSC KLM 10
		PFSC N -1
		Stop
    Death.Fire:
		BURN A 3 Bright 
		BURN B 3 Bright A_PlaySound("Maria/Death/Burning") //A_PlayerScream 
		BURN C 3 Bright A_NoBlocking
		BURN D 3 Bright
		BURN E 5 Bright 
		BURN FGH 5 Bright
		BURN I 5 Bright
		BURN JKL 5 Bright 
		BURN M 5 Bright
		BURN N 5 Bright 
		BURN OPQPQ 5 Bright
		BURN RSTU 7 Bright
		BURN V -1
		Stop
	Death.Plasma:
        PBR1 A 2
        TNT1 A 0 
        PBR1 BBBBBB 2 A_NoBlocking
        PBR1 CDEFGH 6 
        PBR1 HHHHHHHHHHHHHHHHHHHHHH 8 
        TNT1 A -1
		Stop
	Death.BFG:
		DISR A 5
		DISR BC 5
		DISR D 5 A_NoBlocking
		DISR EF 5
		DISR GHIJ 4
		TNT1 A -1
		Stop
	XDeath:
		PFSC O 0 A_PlayerSkinCheck("AltSkinXDeath")
	XDeath1:
		PFSC O 5
		PFSC P 5 A_XScream
		PFSC Q 5 A_NoBlocking
		PFSC RSTUV 5
		PFSC W -1
		Stop
	AltSkinDeath:
		PFSC H 6
		PFSC I 6 A_PlayerScream
		PFSC JK 6
		PFSC L 6 A_NoBlocking
		PFSC MNO 6
		PFSC P -1
		Stop
	AltSkinXDeath:
		PFSC Q 5 A_PlayerScream
		PFSC R 0 A_NoBlocking
		PFSC R 5 A_SkullPop
		PFSC STUVWX 5
		PFSC Y -1
		Stop
	}
}

