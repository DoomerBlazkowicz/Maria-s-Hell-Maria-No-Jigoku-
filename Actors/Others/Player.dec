ACTOR MariaTaunter
{
	//+ISMONSTER
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_Playsound("maria/taunts", 3, 1, 0, attn_none)
		TNT1 A 0 A_AlertMonsters
		Stop
	}
}

ACTOR Maria_Level_Clear : CustomInventory
{
	+INVENTORY.ALWAYSPICKUP
	States
	{
	Spawn:
		PINV AB 2 Bright
		Loop
	Pickup:
		TNT1 A 0 HealThing(50, 0)
		TNT1 A 0 A_GiveInventory("MariaLightClip",60)
		TNT1 A 0 A_GiveInventory("MariaHeavyClip",30)
		TNT1 A 0 A_GiveInventory("Shell",8)
		TNT1 A 0 A_GiveInventory("MariaGrenadeAmmo",6)
		TNT1 A 0 A_GiveInventory("Cell",25)
        TNT1 A 0 A_GiveInventory("MariaArrowAmmo", 10)
        TNT1 A 0 A_GiveInventory("MariaGasoline", 20)
        TNT1 A 0 A_GiveInventory("PipebombAmmo", 1)
        TNT1 A 0 A_GiveInventory("MariaSecretWeaponToken",1)
        TNT1 A 0 A_GiveInventory("MariaSecretWeaponGiver",1)
		Stop
	}
}