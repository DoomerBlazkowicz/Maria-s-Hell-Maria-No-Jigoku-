
Actor MariaPunch1 : FastProjectile //Main Punches
{
    Radius 20
    Height 6
    DamageType Melee
    Projectile 
    +FORCEXYBILLBOARD
	+noextremedeath
	RenderStyle Translucent
    projectilekickback 150
    Decal "PunchWall"
	Alpha 0.75
	Scale 1.00
	Damage 5
	Speed 30
	decal "none"
	SeeSound "none"
	DeathSound "none"
	States
	{
	Spawn:
		TNT1 A 0
		STOP
	Death:
		TNT1 A 0 A_quake(1,7,0,70,"")
		TNT1 A 0 A_PlaySound("weapons/melee/fist/wall",CHAN_BODY)
		TNT1 A 3
		Stop
	XDeath:
		TNT1 A 0 A_quake(1,7,0,70,"")
		TNT1 A 0 A_PlaySound("weapons/melee/fist/hit",CHAN_BODY)
		TNT1 A 3
		Stop
	}
}

