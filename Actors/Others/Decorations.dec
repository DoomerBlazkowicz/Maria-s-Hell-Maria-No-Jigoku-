Actor MariaCandelabra : Candelabra replaces Candelabra
{
+LOOKALLAROUND
+INVULNERABLE
+NOBLOOD
+FORCEYBILLBOARD
+GHOST
+DONTTHRUST
//scale 0.7
states
    {
    Spawn:
        TNT1 A 0 A_SpawnItem("MariaYellowFlare22",0,61)
        SAMD AA 1 bright
        TNT1 A 0 A_SpawnItem("MariaYellowFlare22",0,61)
        SAMD BA 1 bright
        TNT1 A 0 A_SpawnItem("MariaYellowFlare22",0,61)
        SAMD BA 1 bright
        TNT1 A 0 A_SpawnItem("MariaYellowFlare22",0,61)
        SAMD BB 1 bright
        Loop
    }
}

Actor MariaCandlestick : Candlestick replaces Candlestick
{
+LOOKALLAROUND
scale 0.75
states
    {
    Spawn:
        TNT1 A 0 A_CheckSight("Spawn2")
        TNT1 A 0 A_SpawnItem("MariaYellowFlareSmall22Long",0,16)
        CIER AABA 1 bright
        TNT1 A 0 A_SpawnItem("MariaYellowFlareSmall22Long",0,16)
        CIER BABB 1 bright
        Loop
    Spawn2:
        CIER A 1
        Goto Spawn
    }
}

Actor MariaBurningBarrel : BurningBarrel replaces BurningBarrel
{
+LOOKALLAROUND
states
    {
    Spawn:
        TNT1 A 0 A_CustomMissile ("MariaBlackSmoke", 38, 0, random (40, 180), 2, random (60, 120))
        TNT1 A 0 A_CustomMissile ("MariaTorchFlameTrails", 38, 0, random (40, 180), 2, random (50, 130))
        TNT1 A 0 A_CustomMissile ("MariaFlameBallBarrel", 37, 0, random (0, 140), 2, random (0, 160))
        BURB AAA 1 bright A_SpawnItem("MariaRedFlare3",0,42)

        
        TNT1 A 0 A_CustomMissile ("MariaBlackSmoke", 38, 0, random (40, 180), 2, random (60, 120))
        TNT1 A 0 A_CustomMissile ("MariaTorchFlameTrails", 38, 0, random (40, 180), 2, random (50, 130))
        TNT1 A 0 A_CustomMissile ("MariaFlameBallBarrel", 37, 0, random (0, 140), 2, random (0, 160))
        BURB AA 2 bright A_SpawnItem("MariaRedFlare3",0,46)
        
        TNT1 A 0 A_CustomMissile ("MariaBlackSmoke", 38, 0, random (40, 180), 2, random (60, 120))
        TNT1 A 0 A_CustomMissile ("MariaTorchFlameTrails", 38, 0, random (40, 180), 2, random (50, 130))
        TNT1 A 0 A_CustomMissile ("MariaFlameBallBarrel", 35, 0, random (0, 140), 2, random (0, 160))
        BURB AA 2 bright A_SpawnItem("MariaRedFlare3",0,38)
        
        TNT1 A 0 A_CustomMissile ("MariaBlackSmoke", 38, 0, random (40, 180), 2, random (60, 120))
        TNT1 A 0 A_CustomMissile ("MariaTorchFlameTrails", 38, 0, random (40, 180), 2, random (50, 130))
        TNT1 A 0 A_CustomMissile ("MariaFlameBallBarrel", 37, 0, random (0, 140), 2, random (0, 160))
        BURB AA 2 bright A_SpawnItem("MariaRedFlare3",0,44)
       //TNT1 A 0 A_Playsound("world/burning")
        TNT1 A 0 A_SpawnItem("BurningBarrelDamage",0,42)
        TNT1 A 0 A_CustomMissile ("MariaBlackSmoke", 38, 0, random (40, 180), 2, random (60, 120))
        TNT1 A 0 A_CustomMissile ("MariaTorchFlameTrails", 30, 0, random (0, 360), 2, random (50, 130))
        TNT1 A 0 A_CustomMissile ("MariaFlameBallBarrel", 37, 0, random (0, 140), 2, random (0, 160))
        BURB AA 2 bright A_SpawnItem("MariaRedFlare3",0,42)
        Loop

    Spawn2:
        BURB A 1
        TNT1 A 0 A_CustomMissile ("FlameBallBarrel", 35, 0, random (0, 140), 2, random (0, 160))
        Goto Spawn

    }
}
