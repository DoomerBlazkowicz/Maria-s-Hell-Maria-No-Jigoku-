// P R O P S

ACTOR MariaExplosiveBarrel Replaces ExplosiveBarrel  
{
	Health 40
	Radius 10
	Height 34
    -COUNTKILL
	+PUSHABLE
	+SlidesOnWalls
	+SOLID
	+SHOOTABLE
	+NOBLOOD
	+ACTIVATEMCROSS
	+DONTGIB
	+NOICEDEATH
	+OLDRADIUSDMG
	+FLOORCLIP
	+lookallaround
    //+EXTREMEDEATH
    +DROPOFF	
    DamageType "ExplosiveBarrel"
    damagefactor "Kick", 0.1 
	PainChance "Kick", 255
	Obituary "$OB_BARREL"
	States
	{
	Spawn:
		MBAR ABCB 6
		Loop
	Death:
		MBEX ABCDE 4 BRIGHT 
        TNT1 A 0 A_Scream
        TNT1 A 0 A_Explode
        TNT1 A 0 A_Quake(4, 24, 0, 960)
		TNT1 A 0 A_PlaySound("Maria/Barrel/Explosion",CHAN_AUTO)
        TNT1 A 0 A_PlaySound("Maria/Explosion/Far", CHAN_AUTO)
		TNT1 A 0 bright A_Explode(150,200,1,1)
        TNT1 A 0 A_PlaySound("Maria/Explosion/Far", CHAN_ITEM)
		TNT1 A 0 A_SpawnItemEx("MariaShockWave")
		TNT1 AAAAAAAA 0 A_CustomMissile("MariaHeavyExplosionSmoke",0,0,random(0,360),2,random(0,360))
        TNT1 AAAAA 0 A_SpawnProjectile("MariaExplosionFlames", 0, 0, random(0, 360), CMF_AIMDIRECTION, random(0, 360))
        TNT1 AAAA 0 A_SpawnItemEx ("MariaBarrelShrapnel", 0, 0, random(0,42), random(2,6), random(2,6), 0, random(0,360), 160)
        TNT1 A 0 A_SpawnProjectile("MariaBarrelExplosionFlame")
		TNT1 AAAAAAAA 0 A_CustomMissile("MariaHeavyExplosionSmoke",0,0,random(0,360),2,random(0,360))
        TNT1 AAAAAAAAA 0 A_CustomMissile ("MariaSmallExplosionFlames", 20, 0, random (0, 360), 2, random (0, 180))
		MBEX FGHFGHFGHFGHFGHFGHFGH 4 BRIGHT 
		TNT1 A 0 A_SpawnItemEx("MariaExplosiveBarrelDead")
		TNT1 A 1050 BRIGHT A_BarrelDestroy
		TNT1 A 1 //A_Respawn
		Stop
	}
}

actor MariaExplosiveBarrelDead
{
	Health 40
	Radius 10
	Height 34
   states
{
    Spawn:
	MBEX I 6
	loop
}
}

actor MariaBarrelShrapnel
{
    Speed 25
	Health	4
	Radius	2
	Height	3
	Speed	5
	Scale	0.3
    PROJECTILE
    +DOOMBOUNCE
    -NOGRAVITY
    +NOBLOCKMAP
    +CANNOTPUSH
    -NOTELEPORT
    -SOLID
	+GRENADETRAIL
    SeeSound "Maria/Barrel/Shrapnel"
    States
    {
	Spawn:
		SHAR ABCDEFGH 3
		Loop
	Death:
		SHAR C 1
		Stop
    }
}

Actor MariaTechLamp1 : TechLamp replaces TechLamp
{
    health 15
    deathheight 80
    +LOOKALLAROUND
    +DONTTHRUST
    +SHOOTABLE
    +NOBLOOD
    +GHOST
    +SOLID
    +FORCEYBILLBOARD
    +USESPECIAL
    states
         {
    Spawn:
        LAMP A 1 bright A_Playsound("Maria/Prop/Lamp",CHAN_BODY,1,1)
        LAMP ABCD 2 bright A_SpawnItemEx("MariaLensFlareAltLong", 0, 0, 71)
        Loop
    Death:
        LAMP E 1
        //TNT1 A 0 A_SpawnItem("Spark_UpOnce",0,81)
        TNT1 A 0 A_PlaySound ("Maria/Glass/Breaking")
        //TNT1 AAAAAAAAAA 0 A_CustomMissile("GlassPart",16,random(-3,3),random(0,360),2,random(40,70))
        //TNT1 AAAAAAAAAA 0 A_CustomMissile("ExplosionParticleHeavy",75,random(-3,3),random(0,360),2,random(0,70))
        //TNT1 AAAA 0 A_CustomMissile("MiniSmoke",75,random(-3,3),random(0,360),2,random(0,70))
        LAMP E -1
        stop
    }
}

