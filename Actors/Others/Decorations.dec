Actor MariaTallTorchRed : RedTorch replaces RedTorch
{
height 85
radius 10
+LOOKALLAROUND
-SHOOTABLE
+INVULNERABLE
+NOBLOOD
+GHOST
+DONTTHRUST
states
    {
    Spawn:
        TNT1 A 0 A_CheckSight("Spawn2")
        TNT1 A 0 A_CustomMissile ("MariaTorchFlameTrails", 58, 0, random (0, 360), 2, random (70, 110))
        TNT1 A 0 A_CustomMissile ("MariaFlameBallRed", 57, 0, random (0, 140), 2, random (0, 160))
        TRCH A 1 bright A_Playsound("Maria/Prop/Torch",CHAN_5,1,1)
        TRCH AA 1 A_SpawnItem("MariaRedFlare22",0,59)
        Loop

   Spawn2:
        TRCH A 1
        Goto Spawn

    }
}

