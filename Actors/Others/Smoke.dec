ACTOR MariaExplosionSmoke
{
    Radius 1
    Height 1
    Alpha 2
    RenderStyle Add
    Speed 3
    Gravity 0
	Scale 0.7
    +NOBLOCKMAP
    +NOTELEPORT
    +DONTSPLASH
    +MISSILE
    +FORCEXYBILLBOARD

    +CLIENTSIDEONLY
    +NOINTERACTION
    +BLOODSPLATTER
    +DOOMBOUNCE
    +THRUACTORS	
    States
    {
    Spawn:
        GNSK ABCDEFGHIJKLMNOPQR 2
        Goto Death
    }
}

ACTOR MariaHeavyExplosionSmoke: MariaExplosionSmoke
{
    Scale 1.4
    Alpha 0.12
    Speed 1
}


Actor MariaMiniSmoke: MariaExplosionSmoke
{
    Speed 1
    Scale 0.5
    Alpha 0.1
}

actor MariaMeleeSmoke: MariaExplosionSmoke
{
    Speed 1
    Alpha 0.15
    Scale 0.2
}

Actor MariaSmokeTrail: MariaExplosionSmoke
{
    Alpha 0.6
    Speed 1
    +CLIENTSIDEONLY
    +NOINTERACTION
    +NOCLIP
    Scale 0.2
}
    
ACTOR MariaBlackSmoke : MariaExplosionSmoke
{
    Radius 1
    Height 1
    Alpha 1.0
    RenderStyle Add
    //Scale 0.3
    Speed 2
    States
    {
    Spawn:
        GNSK ABCDEFGHIJKLMNOPQR 2
        Goto Death
    }
}

Actor MariaMuzzleSmoke: MariaExplosionSmoke
{
	Alpha 0.5
	Speed 4
	Scale 0.11
    States
    {
    Spawn:
        TNT1 A 0
        GNSK ABCDEFGHIJKLMNOPQR 1
        Goto Death
    Death:
        TNT1 A 0
        Stop
    }
}
