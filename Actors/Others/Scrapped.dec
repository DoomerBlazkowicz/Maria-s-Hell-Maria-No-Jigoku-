ACTOR MariaUnmakyrDrop
{
	States
	{
	Spawn:
		TNT1 A 1
		TNT1 A 1 A_DropWeaponPieces("MariaUnmakyrPiece1", "MariaUnmakyrPiece2", "MariaUnmakyrPiece3")
		Stop
	}
}

