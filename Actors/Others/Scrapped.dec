Actor ValmetProjectile
{
  Projectile
  Radius 3
  Height 3
  Speed 69
  Damage (random(120, 120))
  Scale 0.65
  -NOGRAVITY
  +FORCEXYBILLBOARD
  +NOEXTREMEDEATH
  +SKYEXPLODE
  +NOEXTREMEDEATH
  +THRUSPECIES
  +BLOODSPLATTER
  +USEBOUNCESTATE
  SeeSound ""
  DeathSound ""
  Decal BulletChip
  DamageType "Bullet"
  Damagetype "Saw"
  MissileHeight 8
  States
  {
  Spawn:
    VALY A 1 
    VALY A 0 //A_PlaySound("Weapons/NailFlight")
    Loop
  Crash:
  Death:
    PUFF B 0 A_PlaySound("Weapon/ValmerWall")
    PUFF B 0 A_spawnItemEx("MariaKnife",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    PUFF ABCD 2
    Stop
  XDeath:
    PUFF B 0 A_PlaySound("Weapon/ValmerYeetHit")
    PUFF B 0 A_spawnItemEx("MariaKnife",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
    Stop
  }
}

Actor HolyPipebombCrate
{
  Radius 15
  Height 10
  Damage (0)
  Speed 10
  Scale 0.9
  Obituary "%o got too close to %k's proximity mine."
  Projectile
  +CanBounceWater
  +BounceOnActors
  +BounceOnWalls
  +BounceOnCeilings
  -NoGravity
  +DoomBounce
  +ThruGhost
  +NoTarget
  -SlidesOnWalls
   DamageType Kick
  BounceFactor 0.0
  States
  {
  Spawn:
    PBOX A 1 A_CheckFloor("Planted")
    Loop
  Planted:
    PBOX A 1 A_PlaySound("Weapons/ProxHit")
    PBOX A 0 A_CustomMissile("HolyPipebombCratePlanted", 0, 0, 0, 4)
    Stop
  Death:
    PBOX A 1 A_PlaySound("Weapons/ProxHit")
    PBOX A 0 A_CustomMissile("HolyPipebombCratePlanted", 0, 0, 0, 4)
    Stop
  }
}

Actor HolyPipebombCratePlanted
{
  Radius 15
  Height 10
  //Scale 0.9
  Obituary "%o got too close to %k's proximity mine."
  States
  {
  Spawn:
    PBOX A 0
    PBOX A 1 A_JumpIfInventory("DetonateSignal", 1, "Detonate",AAPTR_TARGET) //Destroys the mine if the player uses Altfire.
    Loop
  Pain:
  Death:
  Detonate:
    PBOX A 20 A_PlaySound("Maria/Pipebomb/Box/Activate")
    TNT1 A 0 A_Quake(11,24,0,1200)
    TNT1 A 0 bright A_Explode(300,250,1,1,150) 
	GLXP A 0 A_PlaySound("Maria/Barrel/Explosion",0,1.0,0,0.1)
	TNT1 A 0 A_SpawnItemEx("MariaShockWave")
    TNT1 AAAAAAAA 0 A_SpawnProjectile("MariaExplosionFlames", 0, 0, random(0, 360), CMF_AIMDIRECTION, random(0, 360))
    TNT1 A 0 A_SpawnProjectile("MariaBarrelExplosionFlame")
    TNT1 AAAAAAAAAAAAAAAAAA 0 A_CustomMissile ("MariaSmallExplosionFlames", 20, 0, random (0, 360), 2, random (0, 180))
	TNT1 A 1050 BRIGHT A_BarrelDestroy
    Stop
  }
}

actor KinugawaChainsawGiver : CustomInventory //From Major Crisis by OSJC, play the mod.
{
  inventory.pickupmessage "Chainsaw Acquired! Time to Kick Back!"
  +INVENTORY.AUTOACTIVATE
  +INVENTORY.QUIET
  scale 1
  states
  {
  Spawn:
    TNT1 A 1
    KSAW A 1 a_spawnitemex("DeadKinugawa")
    goto Spawned
  Spawned:
	KSAW A -1
	stop
  pickup:
	TNT1 A 0 a_Jumpifinventory("MariaChainsaw", 1, "spawned")
	TNT1 A 0 A_PlaySound("Weapon/Chainsaw/Hit") 
	TNT1 A 0 A_SpawnItemEx("MariaChainsaw",0,0,25)
    TNT1 A 0 A_Print("Thank you for keeping it, devil.")
	Stop
  }
}

actor DeadKinugawa
{
   //mass 999999999
   states
{
    Spawn:
	KSAW B 6
	loop
}
}

ACTOR MariaImpostorPlasmaBall : MariaRedPlasmaBall //Special for Faker
{
  Speed 30
  Damage (random(10, 20))
  States
  {
  Death:
    TNT1 A 0 A_SetScale (1.0)
    TNT1 A 0 A_Explode(6,16)
	REBE ABCDE 2 Bright
	Stop
  XDeath:
    TNT1 A 0 A_SetScale (1.0)
    TNT1 A 0 A_Explode(6,16)
	REBE ABCDE 2 Bright
	Stop
  }
} 
