Actor MariaArmourPlate : CustomInventory 
{
  Inventory.Amount 1
  Inventory.PickupSound "Maria/Plate/Pickup"
  Inventory.UseSound "Maria/Plate/Insert"
  Inventory.DefMaxAmount
  Inventory.PickupMessage "$GOTARMPLT"
  Tag "Armour Plate"
  Inventory.Icon "ARPPB0"
  +Inventory.InvBar
  +FloorClip
  States
  {
  Spawn:
    ARPP A -1
    Loop
  Use:
    TNT1 A 0 A_GiveInventory("ArmourPlateProtection")
    Stop

 /*Use:
    TNT1 A 0 A_JumpIfInventory("useitem",1,"Waite")
    TNT1 A 0 A_GiveInventory("useitem",1)
    TNT1 A 6
    TNT1 A 0 A_GiveInventory("doarmplt",1)
    Stop
  Waite:
	TNT1 A 0 A_Print("Wait")
	FAIL*/
  }
}

Actor ArmourPlateProtection : ArmorBonus
{
    //Inventory.PickupSound ""
	//Inventory.Pickupmessage ""
	Inventory.Icon "TNT1A0"
	Armor.SavePercent 25
	Armor.SaveAmount 25
	Armor.Maxsaveamount 50
	States
	{
	Spawn:
		TNT1 A -1
		loop
	}
}
