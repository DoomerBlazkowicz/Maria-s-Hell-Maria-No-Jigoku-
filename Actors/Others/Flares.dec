//Flare effects for guns, explosions and some items.
//Imported from Brutal Doom by SGTMarkIV

//Base
Actor MariaFlareBase
{
+NOINTERACTION
+BLOODSPLATTER
+CLIENTSIDEONLY
+NOTELEPORT
renderstyle Add
radius 1
height 1
alpha 0.4
scale 0.8
states
    {
    Spawn:
        TNT1 A 0
        stop		
      }
}

Actor MariaFlareOrange : MariaFlareBase
{
states
    {
    Spawn:
        TNT1 A 0
        TNT1 A 2 bright
        stop		
      }
}

Actor MariaFlarePurple : MariaFlareBase
{
states
    {
    Spawn:
        TNT1 A 0
        TNT1 A 2 bright
        stop		
      }
}
 
Actor MariaFlareBlue : MariaFlareBase
{
states
    {
    Spawn:
        TNT1 A 0
        TNT1 A 2 bright
        stop		
      }
} 

Actor MariaExplosionFlareEffect : MariaFlareBase
{
	XScale 2.0
	YScale 1.5
	Alpha 0.4
	states
	{
	Spawn:
		FLAR B 0
		FLAR B 2 bright
		FLAR BBBBBBBBBBBBBB 1 BRIGHT A_FadeOut(0.11)
		stop
	}
}

Actor MariaExplosionGreenFlareEffect : MariaFlareBase
{
	states
	{
	Spawn:
		FLAG C 0
		FLAG C 2 bright
		FLAG CCCCCCCCCCCCCC 1 BRIGHT A_FadeOut(0.11)
		stop
	}
}

Actor MariaRocketFlare : MariaFlareBase
{
alpha 1.0
yscale 1.2
xscale 1.2
states
	{
	Spawn:
	    LEYS O 2 BRIGHT
		Stop
	}
}

