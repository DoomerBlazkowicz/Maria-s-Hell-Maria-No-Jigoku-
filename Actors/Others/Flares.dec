Actor MariaExplosionFlareSpawner : MariaFlareBase
{
states
	{
	Spawn:
	    TNT1 A 0
		TNT1 A 0 A_SpawnItemEx("MariaExplosionFlareEffect") 
	    TNT1 A 0 A_SpawnItemEx("MariaExplosionFlareEffect", 36, 36) 
		TNT1 A 0 A_SpawnItemEx("MariaExplosionFlareEffect", 36, -36) 
		TNT1 A 0 A_SpawnItemEx("MariaExplosionFlareEffect", -36, 36) 
		TNT1 A 0 A_SpawnItemEx("MariaExplosionFlareEffect", -36, -36)
		stop
	}
}

Actor MariaExplosionGreenFlareSpawner : MariaExplosionFlareSpawner
{
states
	{
	Spawn:
	    TNT1 A 0
		TNT1 A 0 A_SpawnItemEx("MariaExplosionGreenFlareEffect") 
	    TNT1 A 0 A_SpawnItemEx("MariaExplosionGreenFlareEffect", 36, 36) 
		TNT1 A 0 A_SpawnItemEx("MariaExplosionGreenFlareEffect", 36, -36) 
		TNT1 A 0 A_SpawnItemEx("MariaExplosionGreenFlareEffect", -36, 36) 
		TNT1 A 0 A_SpawnItemEx("MariaExplosionGreenFlareEffect", -36, -36)
		stop
	}
}

