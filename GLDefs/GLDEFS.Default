    frame BFGBD { light BFGBALL }
    frame BFGBE { light BFGBALL }

    frame BFBEA { light BFGBALL_X1 }
    frame BFBEB { light BFGBALL_X2 }
    frame BFBEC { light BFGBALL_X5 }
    frame BFBED { light BFGBALL_X1 }
    frame BFBEE { light BFGBALL_X3 }
    frame BFBEF { light BFGBALL_X5 }
	frame BFBEG { light BFGBALL_X1 }
	frame BFBEH { light BFGBALL_X4 }
	frame BFBEI { light BFGBALL_X4 }
	frame BFBEJ { light BFGBALL_X5 }
	frame BFBEK { light BFGBALL_X5 }
}

